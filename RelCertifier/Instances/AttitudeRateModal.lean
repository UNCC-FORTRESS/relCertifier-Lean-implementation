def vsW : List String := ["phi", "p", "theta", "q", "psi", "r"]
def dummyW : Parse.PMode := ⟨"", [], .tt, .tt, []⟩
def mLW (l : ℕ) : Parse.PMode := attitude_rate_IR.L.modes.getD l dummyW
def mRW (q : ℕ) : Parse.PMode := attitude_rate_IR.R.modes.getD q dummyW

abbrev mvW : Var 6 := (Side.Aux, 0)
abbrev aW : Fin 6 := (1 : Fin 6)
abbrev tgW : Var 6 := (Side.Aux, aW)

noncomputable def fLW (l : ℕ) : Fin 6 → Term (Var 6) := hostDyn vsW 6 Side.L (mLW l)
noncomputable def fRW (q : ℕ) : Fin 6 → Term (Var 6) := hostDyn vsW 6 Side.R (mRW q)
noncomputable def domLW : Formula (Var 6) := hostEvolve vsW 6 Side.L (mLW 0)
noncomputable def domRW : Formula (Var 6) := hostEvolve vsW 6 Side.R (mRW 0)
noncomputable def envW : Formula (Var 6) := Formula.and domLW domRW

def atomsOf : Parse.PForm → List Parse.PForm
  | .and x y => atomsOf x ++ atomsOf y
  | f => [f]

def invWPF : Parse.PForm :=
  (attitude_rate_IR.invariants.getD 0 ("", Parse.PForm.tt)).2

noncomputable def gAt (i : ℕ) : Term (Var 6) :=
  ((Run.invToG vsW 6 ((atomsOf invWPF).getD i .tt)).map ITerm.toHost).getD (Term.const 0)

noncomputable def gW : Term (Var 6) := gAt 0
noncomputable def gsW : List (Term (Var 6)) := []

/-! ## Side-splits -/

theorem fLW_pipe (l : ℕ) (i : Fin 6) : fLW l i =
    (((some (mLW l)).bind (Run.dynOf vsW 6 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRW_pipe (q : ℕ) (i : Fin 6) : fRW q i =
    (((some (mRW q)).bind (Run.dynOf vsW 6 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLW_pipe : domLW =
    (((some (mLW 0)).bind (fun m => Run.lowerF vsW 6 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRW_pipe : domRW =
    (((some (mRW 0)).bind (fun m => Run.lowerF vsW 6 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLW (l : ℕ) (hl : l < 1) : ∀ i, (fLW l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsW) (some (mLW l))
    (by interval_cases l <;>
      simp [mLW, attitude_rate_IR, Parse.PExpr.namesFree]) i x
    (fLW_pipe l i ▸ hx))

theorem hfRW (q : ℕ) (hq : q < 2) : ∀ i, (fRW q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsW) (some (mRW q))
    (by interval_cases q <;>
      simp [mRW, attitude_rate_IR, Parse.PExpr.namesFree]) i x
    (fRW_pipe q i ▸ hx))

theorem hdomLW : domLW.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsW) (some (mLW 0))
    (by simp [mLW, attitude_rate_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLW_pipe ▸ hx))

theorem hdomRW : domRW.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsW) (some (mRW 0))
    (by simp [mRW, attitude_rate_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRW_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gW :: gsW, mvW ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gW, gsW, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gW :: gsW, tgW ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gW, gsW, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFW : mvW ∉ (FM gW gsW).fv := notMem_FM_fv hmvg
theorem htgFW : tgW ∉ (FM gW gsW).fv := notMem_FM_fv htgg

theorem hmvenvW : mvW ∉ envW.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLW h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRW h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))
theorem htgenvW : tgW ∉ envW.fv := fun h => by
