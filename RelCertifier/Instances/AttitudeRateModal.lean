/-! ## Non-strict faces -/

theorem hbndN_W (q : ℕ) (hq : q < 2) : ∀ i (hi : i < gsNW.length),
    ∀ x : State (Var 6),
    (∀ gT' ∈ gsSW ++ ([] : List (Term (Var 6))), Term.eval gT' x ≤ 0) →
    Lie (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2)))
      (fun ω => Term.eval gsNW[i] ω) x ≤ 0 := by
  have hne : ∀ (a b : Fin 6), a ≠ b → (Rv a : Var 6) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro i hi x hx
  have hib : i < 0 := by simpa [gsNW] using hi
  interval_cases i


/-! ## Lipschitz and field bound -/

theorem hLip_W (q : ℕ) (hq : q < 2) (ν : State (Var 6)) :
    LipschitzOnWith 8 (odeField (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 6), a ≠ b → (Rv a : Var 6) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RW q hq, odeField_RW q hq]
  have hdc : ∀ j : Fin 6, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((8 : NNReal) : ℝ) = 8 := rfl
  rw [hcoe]
  have htwo : ∀ j : Fin 6, |2 * x (Rv j) - 2 * y (Rv j)| ≤ 8 * dist x y := by
    intro j
    have hdiff : 2 * x (Rv j) - 2 * y (Rv j) = 2 * (x (Rv j) - y (Rv j)) := by ring
    rw [hdiff, abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [hdc j]
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    exact htwo 1
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : 2 * (1 - 1 * x (Rv 1) + 1/20 * x (Rv 3))
        - 2 * (1 - 1 * y (Rv 1) + 1/20 * y (Rv 3))
        = -2 * (x (Rv 1) - y (Rv 1)) + (1/10) * (x (Rv 3) - y (Rv 3)) := by ring
    rw [hdiff]
    have h1 := hdc 1
    have h3 := hdc 3
    have e1 : |(-2:ℝ) * (x (Rv 1) - y (Rv 1))| ≤ 2 * dist x y := by
      rw [abs_mul]
      have : |(-2:ℝ)| = 2 := by norm_num
      rw [this]
      nlinarith
    have e2 : |((1:ℝ)/10) * (x (Rv 3) - y (Rv 3))| ≤ (1/10) * dist x y := by
      rw [abs_mul]
      have : |((1:ℝ)/10)| = 1/10 := by norm_num
      rw [this]
      nlinarith
    calc |(-2:ℝ) * (x (Rv 1) - y (Rv 1)) + (1/10) * (x (Rv 3) - y (Rv 3))|
        ≤ |(-2:ℝ) * (x (Rv 1) - y (Rv 1))| + |((1:ℝ)/10) * (x (Rv 3) - y (Rv 3))| :=
          abs_add_le _ _
      _ ≤ 8 * dist x y := by linarith
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    exact htwo 3
  by_cases hc3 : c = Rv 3
  · subst hc3
    simp only [if_neg (hne 3 0 (by decide)), if_neg (hne 3 1 (by decide)),
      if_neg (hne 3 2 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : 2 * (1 - 1 * x (Rv 3) + 1/20 * x (Rv 1))
        - 2 * (1 - 1 * y (Rv 3) + 1/20 * y (Rv 1))
        = -2 * (x (Rv 3) - y (Rv 3)) + (1/10) * (x (Rv 1) - y (Rv 1)) := by ring
    rw [hdiff]
    have h1 := hdc 1
    have h3 := hdc 3
    have e1 : |(-2:ℝ) * (x (Rv 3) - y (Rv 3))| ≤ 2 * dist x y := by
      rw [abs_mul]
      have : |(-2:ℝ)| = 2 := by norm_num
      rw [this]
      nlinarith
    have e2 : |((1:ℝ)/10) * (x (Rv 1) - y (Rv 1))| ≤ (1/10) * dist x y := by
      rw [abs_mul]
      have : |((1:ℝ)/10)| = 1/10 := by norm_num
      rw [this]
      nlinarith
    calc |(-2:ℝ) * (x (Rv 3) - y (Rv 3)) + (1/10) * (x (Rv 1) - y (Rv 1))|
        ≤ |(-2:ℝ) * (x (Rv 3) - y (Rv 3))| + |((1:ℝ)/10) * (x (Rv 1) - y (Rv 1))| :=
          abs_add_le _ _
      _ ≤ 8 * dist x y := by linarith
  by_cases hc4 : c = Rv 4
  · subst hc4
    simp only [if_neg (hne 4 0 (by decide)), if_neg (hne 4 1 (by decide)),
      if_neg (hne 4 2 (by decide)), if_neg (hne 4 3 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    exact htwo 5
  by_cases hc5 : c = Rv 5
  · subst hc5
    simp only [if_neg (hne 5 0 (by decide)), if_neg (hne 5 1 (by decide)),
      if_neg (hne 5 2 (by decide)), if_neg (hne 5 3 (by decide)),
      if_neg (hne 5 4 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : 2 * (1/2 - 4/5 * x (Rv 5)) - 2 * (1/2 - 4/5 * y (Rv 5))
        = -(8/5) * (x (Rv 5) - y (Rv 5)) := by ring
    rw [hdiff, abs_mul]
    have : |(-(8/5):ℝ)| = 8/5 := by norm_num
    rw [this]
    nlinarith [hdc 5]
  · simp only [if_neg hc0, if_neg hc1, if_neg hc2, if_neg hc3, if_neg hc4, if_neg hc5]
    simp [dist_nonneg]

theorem hfbnd_W (q : ℕ) (hq : q < 2) (ν : State (Var 6))
    (hν : ∀ gT' ∈ gsSW, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
      ‖odeField (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))) x‖
        ≤ ((10:NNReal) : ℝ) := by
  have hne : ∀ (a b : Fin 6), a ≠ b → (Rv a : Var 6) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro x hx
  rw [Metric.mem_closedBall] at hx
  have hband : ∀ (j : Fin 6) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -2 ≤ lo → hi ≤ 2 → |x (Rv j)| ≤ 3 := by
    intro j lo hi hl hh hlo hhi
    have h := dist_le_pi_dist x ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (x (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hx]
  have hxp : |x (Rv 1)| ≤ 3 := by
    refine hband 1 (-(1:ℝ)/20) ((6:ℝ)/5) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν facePLo (by simp [gsSW])
      simp only [facePLo, Term.eval, AOp.interp] at this; linarith
    · have := hν facePHi (by simp [gsSW])
      simp only [facePHi, Term.eval, AOp.interp] at this; linarith
  have hxq : |x (Rv 3)| ≤ 3 := by
    refine hband 3 0 ((6:ℝ)/5) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceQLo (by simp [gsSW])
      simp only [faceQLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceQHi (by simp [gsSW])
      simp only [faceQHi, Term.eval, AOp.interp] at this; linarith
  have hxr : |x (Rv 5)| ≤ 3 := by
    refine hband 5 0 1 ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceRLo (by simp [gsSW])
      simp only [faceRLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceRHi (by simp [gsSW])
      simp only [faceRHi, Term.eval, AOp.interp] at this; linarith
  rw [odeField_RW q hq]
  refine pi_norm_le_iff_of_nonneg (by norm_num) |>.mpr ?_
  intro c
  have hLcoe : ((10:NNReal) : ℝ) = 10 := rfl
  rw [hLcoe]
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs, abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_le.mp hxp, abs_nonneg (x (Rv 1))]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl,
      Real.norm_eq_abs]
    have hb : |1 - 1 * x (Rv 1) + 1/20 * x (Rv 3)| ≤ 5 := by
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxp, abs_le.mp hxq]
    rw [abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_nonneg (1 - 1 * x (Rv 1) + 1/20 * x (Rv 3))]
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs, abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_le.mp hxq, abs_nonneg (x (Rv 3))]
  by_cases hc3 : c = Rv 3
  · subst hc3
    simp only [if_neg (hne 3 0 (by decide)), if_neg (hne 3 1 (by decide)),
      if_neg (hne 3 2 (by decide)), eq_self_iff_true, if_true, if_pos rfl,
      Real.norm_eq_abs]
    have hb : |1 - 1 * x (Rv 3) + 1/20 * x (Rv 1)| ≤ 5 := by
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxp, abs_le.mp hxq]
    rw [abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_nonneg (1 - 1 * x (Rv 3) + 1/20 * x (Rv 1))]
  by_cases hc4 : c = Rv 4
  · subst hc4
    simp only [if_neg (hne 4 0 (by decide)), if_neg (hne 4 1 (by decide)),
      if_neg (hne 4 2 (by decide)), if_neg (hne 4 3 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs, abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_le.mp hxr, abs_nonneg (x (Rv 5))]
  by_cases hc5 : c = Rv 5
  · subst hc5
    simp only [if_neg (hne 5 0 (by decide)), if_neg (hne 5 1 (by decide)),
      if_neg (hne 5 2 (by decide)), if_neg (hne 5 3 (by decide)),
      if_neg (hne 5 4 (by decide)), eq_self_iff_true, if_true, if_pos rfl,
      Real.norm_eq_abs]
    have hb : |1/2 - 4/5 * x (Rv 5)| ≤ 4 := by
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxr]
    rw [abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    nlinarith [abs_nonneg (1/2 - 4/5 * x (Rv 5))]
  · simp only [if_neg hc0, if_neg hc1, if_neg hc2, if_neg hc3, if_neg hc4, if_neg hc5]
    norm_num

/-! ## Existence -/

theorem esW (l m : ℕ) (hl : l < 1) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gW gsW) envW) σ →
      HExistSegB (fLW l) (fRW m) (Term.const (2)) domLW domRW dt
        (Function.update σ tgW 0) := by
  intro σ hσ
  have hR : Formula.sat domRW σ := hσ.2.2
  rw [sat_domRW] at hR
  obtain ⟨hd1l, hd1h, hd3l, hd3h, hd5l, hd5h⟩ := hR
  have hupd : ∀ j : Fin 6, σ (Side.R, j) = Function.update σ tgW 0 (Side.R, j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgW, Prod.ext_iff])]
  have hfS : ∀ gT' ∈ gsSW, Term.eval gT' (Function.update σ tgW 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsSW, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl | rfl | rfl | rfl | rfl | rfl <;>
      · first
          | (simp only [facePLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [facePHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceQLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceQHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceRLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceRHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  have hfN : ∀ gT' ∈ gsNW, Term.eval gT' (Function.update σ tgW 0) ≤ 0 := by
    intro gT' hgT
    exact absurd hgT (by simp [gsNW])
  refine HExistSegB_of_viability_stratified (fLW l) (fRW m) (Term.const (2))
    domLW domRW gsSW [] gsNW 0 le_rfl
    (jointSys_wellFormed _ _ _)
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLW l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RW gT' (by
        rcases List.mem_append.mp hgT with h | h
        · exact List.mem_append_left _ h
        · exact absurd h (List.not_mem_nil)) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLW l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RW gT' (List.mem_append_right _ hgT) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x hsub hface
      exact hbndS_W m hm gT' hgT x hsub hface)
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))
    (by
      intro i hi x hxs _
      exact hbndN_W m hm i hi x hxs)
    (by
      intro x hS hN
      have hS' : ∀ gT' ∈ gsSW, Term.eval gT' x ≤ 0 :=
        fun gT' hgT => hS gT' (List.mem_append_left _ hgT)
      have hb1l : -(1:ℝ)/20 ≤ x (Rv 1) := by
        have := hS' facePLo (by simp [gsSW])
        simp only [facePLo, Term.eval, AOp.interp] at this; linarith
      have hb1h : x (Rv 1) ≤ (6:ℝ)/5 := by
        have := hS' facePHi (by simp [gsSW])
        simp only [facePHi, Term.eval, AOp.interp] at this; linarith
      have hb3l : 0 ≤ x (Rv 3) := by
        have := hS' faceQLo (by simp [gsSW])
        simp only [faceQLo, Term.eval, AOp.interp] at this; linarith
      have hb3h : x (Rv 3) ≤ (6:ℝ)/5 := by
        have := hS' faceQHi (by simp [gsSW])
        simp only [faceQHi, Term.eval, AOp.interp] at this; linarith
      have hb5l : 0 ≤ x (Rv 5) := by
        have := hS' faceRLo (by simp [gsSW])
        simp only [faceRLo, Term.eval, AOp.interp] at this; linarith
      have hb5h : x (Rv 5) ≤ 1 := by
        have := hS' faceRHi (by simp [gsSW])
        simp only [faceRHi, Term.eval, AOp.interp] at this; linarith
      exact (sat_domRW x).mpr ⟨hb1l, hb1h, hb3l, hb3h, hb5l, hb5h⟩)
    8 10 1 one_pos
    (fun ν0 _ => hLip_W m hm ν0)
    (fun ν0 h0 => hfbnd_W m hm ν0 (fun gT hgT => h0 gT (List.mem_append_left _ hgT)))
    dt hdt
    (Function.update σ tgW 0)
    hfS
    hfN
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))

/-! ## The route verdicts (single component, λ = 2, per right mode) -/

def VerdW (m : ℕ) : Prop :=
  ∀ i (hi : i < (gW :: gsW).length),
    z3solve (flowQuery ⟨(gW :: gsW)[i], fLW 0, fRW m, Term.const (2),
      strataDomHost (Formula.and domLW domRW) ((gW :: gsW).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gW :: gsW)[i], fLW 0, fRW m, Term.const (2),
      strataDomHost (Formula.and domLW domRW) ((gW :: gsW).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gW :: gsW)[i], fLW 0, fRW m, Term.const (2),
      strataDomHost (Formula.and domLW domRW) ((gW :: gsW).take i)⟩) = Verdict.unsat

/-! ## Coupling at λ = 2, transported to the λ = 1 automaton -/

theorem coupleW (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdW m) :
    ∀ σ', Formula.sat (Formula.and (FM gW gsW) envW) σ' → σ' tgW = 0 →
      faModalB (Equiv.refl (Var 6))
        (Program.ode (DLCalTiming.clk tgW (leftBlock (fLW 0))) domLW)
        (Program.ode (rightBlock (fRW m) (Term.const (2))) domRW)
        (Formula.and (FM gW gsW) envW) tgW dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgW (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgW
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLW 0) (fRW m) (Term.const (2))
    (Formula.and domLW domRW) (gW :: gsW) hv
  have hboxes : ∀ g' ∈ gW :: gsW, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLW 0) ++ rightBlock (fRW m) (Term.const (2)))
      (Formula.and domLW domRW)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gW gsW σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gW gsW (fLW 0) (fRW m)
    (Term.const (2)) domLW domRW tgW dt
    (LR_blocks_disjoint _ _ _ (hfLW 0 (by norm_num)) (hfRW m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLW hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRW hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLW 0) _ h
      exact aux_ne_Lv aW i hi)
    (fun h => aux_notin_range_Lv aW (leftBlock_readVars_sub (fLW 0) (hfLW 0 (by norm_num)) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRW m) (Term.const (2)) _ h
      exact aux_ne_Rv aW i hi)
    (fun h => aux_notin_range_Rv aW (rightBlock_readVars_sub (fRW m)
      (Term.const (2)) (hfRW m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aW (rightBlock_boundSet_sub (fRW m) (Term.const (2)) h))
    (fun h => aux_notin_range_Lv aW (hdomLW h))
    (fun h => aux_notin_range_Rv aW (hdomRW h))
    htgg hboxes
    (esW 0 m (by norm_num) hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLW ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRW μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLW μ := by
    rwa [(Formula.coincidence domLW (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLW hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRW m) (Term.const (2)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLW μ ↔ Formula.sat domLW ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1W (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdW m) :
    ∀ σ, Formula.sat (Formula.and (FM gW gsW) envW) σ →
      faModalB (Equiv.refl (Var 6))
        (Program.ode (DLCalTiming.clk tgW (leftBlock (fLW 0))) domLW)
        (Program.ode (rightBlock (fRW m) (Term.const 1)) domRW)
        (Formula.and (FM gW gsW) envW) tgW dt
        (Function.update σ tgW 0) := by
  intro σ hσ
  have htgφ : tgW ∉ (Formula.and (FM gW gsW) envW).fv := by
    intro h
    rcases h with h | h
    · exact htgFW h
    · exact htgenvW h
  have hupdφ : Formula.sat (Formula.and (FM gW gsW) envW)
      (Function.update σ tgW 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gW gsW) envW) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gW gsW) envW) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleW m hm dt hdt hv
    (Function.update σ tgW 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam 2 1 (by norm_num) one_pos hsem

/-! ## The window response (two pieces, in place) -/

theorem respondW (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdW m) {σ : State (Var 6)}
    (hσ : Formula.sat (Formula.and (FM gW gsW) envW) σ) :
    Formula.sat (faModal (Equiv.refl (Var 6))
      (windowSeg (leftBlock (fLW 0)) domLW tgW dt 2)
      (bigSeq (List.replicate 2 (Program.ode (rightBlock (fRW m) (Term.const 1)) domRW)))
      (Formula.and (FM gW gsW) envW)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLW 0) domLW (FM gW gsW) envW
    aW dt 2 htgFW htgenvW [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLW 0 (by norm_num)) hdomLW
    (List.replicate 2 (Program.ode (rightBlock (fRW m) (Term.const 1)) domRW))
    (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRW m, Term.const 1, domRW⟩ : RepoHop 6)
        (hfRW m hm) (by simp [Term.fv]) hdomRW (hfLW 0 (by norm_num)) hdomLW)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1W m hm dt hdt hv σ' hσ')
    hσ
  simpa using hfa

/-! ## The step provider — in place from both starts -/

theorem HmultiW (dt : ℝ) (hdt : 0 ≤ dt) (hv0 : VerdW 0) (hv1 : VerdW 1) :
    ∀ P ∈ leftProgsW dt, ∀ (q : ℕ), q < GrW.modes.length → ∀ σ, σ mvW = (q : ℝ) →
      Formula.sat (Formula.and (FM gW gsW) envW) σ →
      ∃ segs : List (ℕ × RMode (Var 6) × REdge (Var 6)),
        (∀ s ∈ segs, GrW.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrW.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 6)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gW gsW) envW)) σ := by
  intro P hP q hq σ hmv hσ
  have hq2 : q < 2 := by simpa [GrW] using hq
  have hstep : ∀ (a b : ℕ × RMode (Var 6) × REdge (Var 6)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 6) × REdge (Var 6)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsW, leftDataW, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  subst hP
  interval_cases q
  · refine ⟨[(0, modeW 0, edgeW 0 0), (0, modeW 0, edgeW 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl <;>
        exact ⟨GrW_modeAt 0 (by norm_num), edgeW_mem 0 0 (by simp [GrW])⟩
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondW 0 (by norm_num) dt hdt hv0 hσ
      simpa [modeW, List.replicate] using this
  · refine ⟨[(1, modeW 1, edgeW 1 1), (1, modeW 1, edgeW 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl <;>
        exact ⟨GrW_modeAt 1 (by norm_num), edgeW_mem 1 1 (by simp [GrW])⟩
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondW 1 (by norm_num) dt hdt hv1 hσ
      simpa [modeW, List.replicate] using this

/-- **`attitude_rate`, modal Theorem 3** — the six-dimensional coupled attitude
system with the single roll-rate invariant `p_L ≤ p_R + 1/2`, one left cruise
window against the two-mode right automaton, coupled at λ = 2 with two pieces.
The three attitude integrators (φ, θ, ψ) ride unbounded; the certified channel's
faces are mutually conditioned (p's inflow cites q's band and vice versa).
Residuals: two 3-query packs. -/
theorem attitude_rate_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv0 : VerdW 0) (hv1 : VerdW 1) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsW dt))
      (rightAutomatonBody GrW mvW)
      (RFormula.and (RFormula.and (canonInvM gW gsW) (envLR domLW domRW))
        (mvValidR mvW GrW.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrW mvW (FM gW gsW) domLW domRW
    (leftProgsW dt) (canonInvM gW gsW) (encode_canonInvM gW gsW) ?_ ?_ ?_
  · exact hdis_multi GrW 0 1 dt leftDataW (by decide) httW hRvW hLW
  · exact hstep_assembled_multiF GrW mvW (FM gW gsW) envW (leftProgsW dt)
      hmvFW hmvenvW hfreshW httW hltW (hframesW dt)
      (HmultiW dt hdt hv0 hv1)
  · exact hddF_multiE GrW 0 1 dt leftDataW (canonInvM gW gsW) domLW domRW
      (by decide) httW hRvW hLW
      (canonInvM_varsL gW gsW (by
        intro g' hg'
        simp only [gW, gsW, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl <;> exact hgAt _))
      (canonInvM_varsR gW gsW) hdomLW hdomRW

end AttitudeRateModal
