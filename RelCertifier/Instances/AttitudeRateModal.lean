/-! ## The frozen-left joint field -/

theorem odeField_RW (q : ℕ) (hq : q < 2) (x : State (Var 6)) :
    odeField (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))) x
      = fun c =>
        if c = Rv 0 then 2 * (x (Rv 1))
        else if c = Rv 1 then 2 * (1 - 1 * x (Rv 1) + 1/20 * x (Rv 3))
        else if c = Rv 2 then 2 * (x (Rv 3))
        else if c = Rv 3 then 2 * (1 - 1 * x (Rv 3) + 1/20 * x (Rv 1))
        else if c = Rv 4 then 2 * (x (Rv 5))
        else if c = Rv 5 then 2 * (1/2 - 4/5 * x (Rv 5))
        else 0 := by
  funext c
  by_cases hc : c ∈ (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))).bound
  · rw [show odeField (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))) x c
        = ((jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2))).rhs c).eval x from by
      simp only [odeField, if_pos hc]]
    obtain ⟨p, hp, hfst⟩ : ∃ p ∈ jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2)),
        p.1 = c := by simpa [ODESystem.bound, List.mem_map] using hc
    rw [← hfst, ODESystem.rhs_eq_of_mem (jointSys_wellFormed _ _ _) hp]
    rw [jointSys_split] at hp
    have hne : ∀ (a b : Fin 6), a ≠ b → (Rv a : Var 6) ≠ Rv b := by
      intro a b hab
      simp [Rv, Prod.ext_iff]
      exact fun h => hab (by exact_mod_cast h)
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      have hLR : ∀ k : Fin 6, (Lv j : Var 6) ≠ Rv k := by
        intro k
        simp [Lv, Rv, Prod.ext_iff]
      simp [Term.eval, hLR 0, hLR 1, hLR 2, hLR 3, hLR 4, hLR 5]
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      fin_cases j
      · simp [Term.eval, AOp.interp, fRW0_eval q hq]
        try ring
      · simp [Term.eval, AOp.interp, fRW1_eval q hq,
          hne 1 0 (by decide)]
        try ring
      · simp [Term.eval, AOp.interp, fRW2_eval q hq,
          hne 2 0 (by decide),
          hne 2 1 (by decide)]
        try ring
      · simp [Term.eval, AOp.interp, fRW3_eval q hq,
          hne 3 0 (by decide),
          hne 3 1 (by decide),
          hne 3 2 (by decide)]
        try ring
      · simp [Term.eval, AOp.interp, fRW4_eval q hq,
          hne 4 0 (by decide),
          hne 4 1 (by decide),
          hne 4 2 (by decide),
          hne 4 3 (by decide)]
        try ring
      · simp [Term.eval, AOp.interp, fRW5_eval q hq,
          hne 5 0 (by decide),
          hne 5 1 (by decide),
          hne 5 2 (by decide),
          hne 5 3 (by decide),
          hne 5 4 (by decide)]
        try ring
  · have hnotR : ∀ j : Fin 6, c ≠ Rv j := by
      intro j hceq
      refine hc ?_
      rw [hceq, jointSys_split]
      simp only [ODESystem.bound, List.map_append, List.mem_append]
      exact Or.inr (by
        simp only [rightBlock, List.map_map, List.mem_map]
        exact ⟨j, List.mem_finRange j, rfl⟩)
    simp only [odeField, if_neg hc, if_neg (hnotR 0), if_neg (hnotR 1), if_neg (hnotR 2),
      if_neg (hnotR 3), if_neg (hnotR 4), if_neg (hnotR 5)]

/-! ## Strict inflow -/

theorem hbndS_W (q : ℕ) (hq : q < 2) : ∀ gT' ∈ gsSW, ∀ x : State (Var 6),
    (∀ gT'' ∈ gsSW, Term.eval gT'' x ≤ 0) →
    Term.eval gT' x = 0 →
    Lie (jointSys (fun _ => Term.const 0) (fRW q) (Term.const (2)))
      (fun ω => Term.eval gT' ω) x < 0 := by
  have hne : ∀ (a b : Fin 6), a ≠ b → (Rv a : Var 6) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro gT' hgT x hsub hface
  have hpl : -(1:ℝ)/20 ≤ x (Rv 1) := by
    have := hsub facePLo (by simp [gsSW])
    simp only [facePLo, Term.eval, AOp.interp] at this; linarith
  have hph : x (Rv 1) ≤ (6:ℝ)/5 := by
    have := hsub facePHi (by simp [gsSW])
    simp only [facePHi, Term.eval, AOp.interp] at this; linarith
  have hql : 0 ≤ x (Rv 3) := by
    have := hsub faceQLo (by simp [gsSW])
    simp only [faceQLo, Term.eval, AOp.interp] at this; linarith
  have hqh : x (Rv 3) ≤ (6:ℝ)/5 := by
    have := hsub faceQHi (by simp [gsSW])
    simp only [faceQHi, Term.eval, AOp.interp] at this; linarith
  simp only [gsSW, List.mem_cons, List.not_mem_nil, or_false] at hgT
  rcases hgT with rfl | rfl | rfl | rfl | rfl | rfl
  · have hx : x (Rv 1) = -(1:ℝ)/20 := by
