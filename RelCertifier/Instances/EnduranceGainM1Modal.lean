  rw [show (path.map (fun p => (⟨fRG p, Term.const 1, domRG⟩ : RepoHop 2))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRG p) (Term.const 1)) domRG)
    from by rw [List.map_map]; rfl] at hfa
  simpa [List.replicate] using hfa


/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiG (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdG 0 0) (hv01 : VerdG 0 1) (hv02 : VerdG 0 2) (hv11 : VerdG 1 1) (hv12 : VerdG 1 2) (hv22 : VerdG 2 2) :
    ∀ P ∈ leftProgsG dt, ∀ (q : ℕ), q < GrG.modes.length → ∀ σ, σ mvG = (q : ℝ) →
      Formula.sat (Formula.and (FM gG gsG) envG) σ →
      ∃ segs : List (ℕ × RMode (Var 2) × REdge (Var 2)),
        (∀ s ∈ segs, GrG.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrG.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 2)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gG gsG) envG)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrG] using hq
  have hself : GrG.modeAt q = some (modeG q) ∧ edgeG q q ∈ GrG.edgesFrom q := by
    refine ⟨GrG_modeAt q hq3, edgeG_mem q q ?_⟩
    interval_cases q <;> simp [GrG]
  have hstep : ∀ (a b : ℕ × RMode (Var 2) × REdge (Var 2)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 2) × REdge (Var 2)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsG, leftDataG, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeG st tgt ∈ GrG.edges →
      GrG.modeAt st = some (modeG st) ∧ edgeG st tgt ∈ GrG.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrG_modeAt st hs, edgeG_mem st tgt he⟩
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeG 0, edgeG 0 0), (0, modeG 0, edgeG 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrG])
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrG])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondG 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) hσ
      simpa [modeG, List.replicate] using this
  · refine ⟨[(1, modeG 1, edgeG 1 1), (1, modeG 1, edgeG 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrG])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrG])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
