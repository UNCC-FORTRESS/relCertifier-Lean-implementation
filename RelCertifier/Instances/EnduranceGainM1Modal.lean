/-! ## The frozen-left joint field -/

theorem odeField_RG (q : ℕ) (hq : q < 3) (x : State (Var 2)) :
    odeField (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))) x
      = fun c =>
        if c = Rv 0 then 2 * (cstG q - x (Rv 0))
        else if c = Rv 1 then x (Rv 0)
        else 0 := by
  funext c
  by_cases hc : c ∈ (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))).bound
  · rw [show odeField (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))) x c
        = ((jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))).rhs c).eval x from by
      simp only [odeField, if_pos hc]]
    obtain ⟨p, hp, hfst⟩ : ∃ p ∈ jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1)),
        p.1 = c := by simpa [ODESystem.bound, List.mem_map] using hc
    rw [← hfst, ODESystem.rhs_eq_of_mem (jointSys_wellFormed _ _ _) hp]
    rw [jointSys_split] at hp
    have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
      intro a b hab
      simp [Rv, Prod.ext_iff]
      exact fun h => hab (by exact_mod_cast h)
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      have hLR : ∀ k : Fin 2, (Lv j : Var 2) ≠ Rv k := by
        intro k
        simp [Lv, Rv, Prod.ext_iff]
      simp [Term.eval, hLR 0, hLR 1]
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      fin_cases j
      · simp [Term.eval, AOp.interp, fRG0_eval q hq]
      · simp [Term.eval, AOp.interp, fRG1_eval q hq,
          hne 1 0 (by decide)]
  · have hnotR : ∀ j : Fin 2, c ≠ Rv j := by
      intro j hceq
      refine hc ?_
      rw [hceq, jointSys_split]
      simp only [ODESystem.bound, List.map_append, List.mem_append]
      exact Or.inr (by
        simp only [rightBlock, List.map_map, List.mem_map]
        exact ⟨j, List.mem_finRange j, rfl⟩)
    simp only [odeField, if_neg hc, if_neg (hnotR 0), if_neg (hnotR 1)]

/-! ## Strict inflow -/

theorem hbndS_G (q : ℕ) (hq : q < 3) : ∀ gT' ∈ gsSG, ∀ x : State (Var 2),
    Term.eval gT' x = 0 →
    Lie (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1)))
      (fun ω => Term.eval gT' ω) x < 0 := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro gT' hgT x hface
  simp only [gsSG, List.mem_cons, List.not_mem_nil, or_false] at hgT
  rcases hgT with rfl | rfl
  · have hx : x (Rv 0) = 0 := by
      simp only [faceVLo, Term.eval, AOp.interp] at hface; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceVLo ω)
        = fun y => (-1 : ℝ) * y (Rv 0) + (0) := by
      funext y; simp [faceVLo, Term.eval, AOp.interp]
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 0) (-1) (0) x,
      odeField_RG q hq]
    simp only [eq_self_iff_true, if_true, if_pos rfl, hx]
    interval_cases q <;> norm_num [cstG]
  · have hx : x (Rv 0) = (4:ℝ)/5 := by
      simp only [faceVHi, Term.eval, AOp.interp] at hface; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceVHi ω)
        = fun y => (1 : ℝ) * y (Rv 0) + (-((4:ℝ)/5)) := by
      funext y; simp [faceVHi, Term.eval, AOp.interp]; ring
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 0) 1 (-((4:ℝ)/5)) x,
      odeField_RG q hq]
    simp only [eq_self_iff_true, if_true, if_pos rfl, hx]
    interval_cases q <;> norm_num [cstG]

/-! ## Non-strict faces -/

theorem hbndN_G (q : ℕ) (hq : q < 3) : ∀ i (hi : i < gsNG.length),
    ∀ x : State (Var 2),
    (∀ gT' ∈ gsSG ++ ([] : List (Term (Var 2))), Term.eval gT' x ≤ 0) →
    Lie (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1)))
      (fun ω => Term.eval gsNG[i] ω) x ≤ 0 := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro i hi x hx
  have hib : i < 1 := by simpa [gsNG] using hi
  interval_cases i
  · show Lie _ (fun ω => Term.eval faceSLo ω) x ≤ 0
    have hv0 : 0 ≤ x (Rv 0) := by
      have := hx faceVLo (List.mem_append_left _ (by simp [gsSG]))
      simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceSLo ω)
        = fun y => (-1 : ℝ) * y (Rv 1) + 0 := by
      funext y; simp [faceSLo, Term.eval, AOp.interp]
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 1) (-1) 0 x,
      odeField_RG q hq]
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    linarith

/-! ## Lipschitz and field bound -/

theorem hLip_G (q : ℕ) (hq : q < 3) (ν : State (Var 2)) :
    LipschitzOnWith 8 (odeField (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RG q hq, odeField_RG q hq]
  have hdc : ∀ j : Fin 2, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((8 : NNReal) : ℝ) = 8 := rfl
  rw [hcoe]
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |2 * (cstG q - x (Rv 0)) - 2 * (cstG q - y (Rv 0))| ≤ 2 * dist x y := by
      have hdiff : 2 * (cstG q - x (Rv 0)) - 2 * (cstG q - y (Rv 0)) = -(2 : ℝ) * (x (Rv 0) - y (Rv 0)) := by ring
      rw [hdiff, abs_mul]
      have habs : |-(2 : ℝ)| = 2 := by norm_num
      rw [habs]
      nlinarith [hdc 0]
    skip
    nlinarith [hcore, hd]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |x (Rv 0) - y (Rv 0)| ≤ 1 * dist x y := by
      have hdiff : x (Rv 0) - y (Rv 0) = (1 : ℝ) * (x (Rv 0) - y (Rv 0)) := by ring
      rw [hdiff, abs_mul]
      have habs : |(1 : ℝ)| = 1 := by norm_num
      rw [habs]
      nlinarith [hdc 0]
    skip
    nlinarith [hcore, hd]
  · simp only [if_neg hc0, if_neg hc1]
    simp [dist_nonneg]

theorem hfbnd_G (q : ℕ) (hq : q < 3) (ν : State (Var 2))
    (hν : ∀ gT' ∈ gsSG, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
      ‖odeField (jointSys (fun _ => Term.const 0) (fRG q) (Term.const (1))) x‖
        ≤ ((10:NNReal) : ℝ) := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro x hx
  rw [Metric.mem_closedBall] at hx
  have hbandf : ∀ (j : Fin 2) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -2 ≤ lo → hi ≤ 2 → |x (Rv j)| ≤ 3 := by
    intro j lo hi hl hh hlo1 hhi1
    have h := dist_le_pi_dist x ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (x (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hx]
  have hxb0 : |x (Rv 0)| ≤ 3 := by
    refine hbandf 0 (0) ((4:ℝ)/5) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceVLo (by simp [gsSG])
      simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceVHi (by simp [gsSG])
      simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
  rw [odeField_RG q hq]
  refine pi_norm_le_iff_of_nonneg (by norm_num) |>.mpr ?_
  intro c
  have hLcoe : ((10:NNReal) : ℝ) = 10 := rfl
  rw [hLcoe]
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcst : 0 ≤ cstG q ∧ cstG q ≤ 1 := by
      interval_cases q <;> norm_num [cstG]
    have hcore : |2 * (cstG q - x (Rv 0))| ≤ 8 := by
      obtain ⟨hcl, hch⟩ := hcst
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxb0]

    nlinarith [hcore, abs_nonneg (2 * (cstG q - x (Rv 0)))]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |x (Rv 0)| ≤ 3 := hxb0

    nlinarith [hcore, abs_nonneg (x (Rv 0))]
  · simp only [if_neg hc0, if_neg hc1]
    norm_num

/-! ## Existence -/

theorem esG (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gG gsG) envG) σ →
      HExistSegB (fLG l) (fRG m) (Term.const (1)) domLG domRG dt
        (Function.update σ tgG 0) := by
  intro σ hσ
  have hR : Formula.sat domRG σ := hσ.2.2
  rw [sat_domRG] at hR
  obtain ⟨hd1l, hd0l, hd0h⟩ := hR
  have hupd : ∀ j : Fin 2, σ (Side.R, j) = Function.update σ tgG 0 (Side.R, j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgG, Prod.ext_iff])]
  have hfS : ∀ gT' ∈ gsSG, Term.eval gT' (Function.update σ tgG 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsSG, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl | rfl <;>
      · first
          | (simp only [faceVLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceVHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  have hfN : ∀ gT' ∈ gsNG, Term.eval gT' (Function.update σ tgG 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsNG, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl <;>
      · first
          | (simp only [faceSLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  refine HExistSegB_of_viability_stratified (fLG l) (fRG m) (Term.const (1))
    domLG domRG gsSG [] gsNG 0 le_rfl
    (jointSys_wellFormed _ _ _)
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLG l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RG gT' (by
        rcases List.mem_append.mp hgT with h | h
        · exact List.mem_append_left _ h
        · exact absurd h (List.not_mem_nil)) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLG l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RG gT' (List.mem_append_right _ hgT) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x _ hface
      exact hbndS_G m hm gT' hgT x hface)
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))
    (by
      intro i hi x hxs _
      exact hbndN_G m hm i hi x hxs)
    (by
      intro x hS hN
      have hS' : ∀ gT' ∈ gsSG, Term.eval gT' x ≤ 0 :=
        fun gT' hgT => hS gT' (List.mem_append_left _ hgT)
      have hb0l : 0 ≤ x (Rv 0) := by
        have := hS' faceVLo (by simp [gsSG])
        simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
      have hb0h : x (Rv 0) ≤ (4:ℝ)/5 := by
        have := hS' faceVHi (by simp [gsSG])
        simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
      have hb1l : 0 ≤ x (Rv 1) := by
        have := hN faceSLo (by simp [gsNG])
        simp only [faceSLo, Term.eval, AOp.interp] at this; linarith
      exact (sat_domRG x).mpr ⟨hb1l, hb0l, hb0h⟩)
    8 10 1 one_pos
    (fun ν0 _ => hLip_G m hm ν0)
    (fun ν0 h0 => hfbnd_G m hm ν0 (fun gT hgT => h0 gT (List.mem_append_left _ hgT)))
    dt hdt
    (Function.update σ tgG 0)
    hfS
    hfN
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))

/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdG (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gG :: gsG).length),
    z3solve (flowQuery ⟨(gG :: gsG)[i], fLG l, fRG m, Term.const (1),
      strataDomHost (Formula.and domLG domRG) ((gG :: gsG).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gG :: gsG)[i], fLG l, fRG m, Term.const (1),
      strataDomHost (Formula.and domLG domRG) ((gG :: gsG).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gG :: gsG)[i], fLG l, fRG m, Term.const (1),
      strataDomHost (Formula.and domLG domRG) ((gG :: gsG).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleG (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdG l m) :
    ∀ σ', Formula.sat (Formula.and (FM gG gsG) envG) σ' → σ' tgG = 0 →
      faModalB (Equiv.refl (Var 2))
        (Program.ode (DLCalTiming.clk tgG (leftBlock (fLG l))) domLG)
        (Program.ode (rightBlock (fRG m) (Term.const (1))) domRG)
        (Formula.and (FM gG gsG) envG) tgG dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgG (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgG
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLG l) (fRG m) (Term.const (1))
    (Formula.and domLG domRG) (gG :: gsG) hv
  have hboxes : ∀ g' ∈ gG :: gsG, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLG l) ++ rightBlock (fRG m) (Term.const (1)))
      (Formula.and domLG domRG)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gG gsG σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gG gsG (fLG l) (fRG m)
    (Term.const (1)) domLG domRG tgG dt
    (LR_blocks_disjoint _ _ _ (hfLG l hl) (hfRG m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLG hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRG hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLG l) _ h
      exact aux_ne_Lv aG i hi)
    (fun h => aux_notin_range_Lv aG (leftBlock_readVars_sub (fLG l) (hfLG l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRG m) (Term.const (1)) _ h
      exact aux_ne_Rv aG i hi)
    (fun h => aux_notin_range_Rv aG (rightBlock_readVars_sub (fRG m)
      (Term.const (1)) (hfRG m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aG (rightBlock_boundSet_sub (fRG m)
      (Term.const (1)) h))
    (fun h => aux_notin_range_Lv aG (hdomLG h))
    (fun h => aux_notin_range_Rv aG (hdomRG h))
    htgg hboxes
    (esG l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLG ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRG μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLG μ := by
    rwa [(Formula.coincidence domLG (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLG hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRG m) (Term.const (1)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLG μ ↔ Formula.sat domLG ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1G (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdG l m) :
    ∀ σ, Formula.sat (Formula.and (FM gG gsG) envG) σ →
      faModalB (Equiv.refl (Var 2))
        (Program.ode (DLCalTiming.clk tgG (leftBlock (fLG l))) domLG)
        (Program.ode (rightBlock (fRG m) (Term.const 1)) domRG) (Formula.and (FM gG gsG) envG) tgG dt
        (Function.update σ tgG 0) := by
  intro σ hσ
  have htgφ : tgG ∉ (Formula.and (FM gG gsG) envG).fv := by
    intro h
    rcases h with h | h
    · exact htgFG h
    · exact htgenvG h
  have hupdφ : Formula.sat (Formula.and (FM gG gsG) envG)
      (Function.update σ tgG 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gG gsG) envG) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gG gsG) envG) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleG l m hl hm dt hdt hv
    (Function.update σ tgG 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (1) 1 (by norm_num) one_pos hsem

/-! ## The window response (2 pieces at the in-place mode) -/

theorem respondG (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdG l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 2)}
    (hσ : Formula.sat (Formula.and (FM gG gsG) envG) σ) :
    Formula.sat (faModal (Equiv.refl (Var 2))
      (windowSeg (leftBlock (fLG l)) domLG tgG dt 2)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRG p) (Term.const 1)) domRG))
        ++ [Program.ode (rightBlock (fRG m) (Term.const 1)) domRG,
        Program.ode (rightBlock (fRG m) (Term.const 1)) domRG]))
      (Formula.and (FM gG gsG) envG)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLG l) domLG (FM gG gsG) envG
    aG dt 2 htgFG htgenvG
    (path.map (fun p => (⟨fRG p, Term.const 1, domRG⟩ : RepoHop 2)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRG p (hpath p hp), by simp [Term.fv], hdomRG⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRG p)
        (lam := Term.const 1) (domR := domRG) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLG l hl) hdomLG
    (List.replicate 2 (Program.ode (rightBlock (fRG m) (Term.const 1)) domRG)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRG m, Term.const 1, domRG⟩ : RepoHop 2)
        (hfRG m hm) (by simp [Term.fv]) hdomRG (hfLG l hl) hdomLG)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1G l m hl hm dt hdt hv σ' hσ')
    hσ
  rw [show (path.map (fun p => (⟨fRG p, Term.const 1, domRG⟩ : RepoHop 2))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRG p) (Term.const 1)) domRG)
    from by rw [List.map_map]; rfl] at hfa
  simpa [List.replicate] using hfa

theorem respond3G (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdG l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
