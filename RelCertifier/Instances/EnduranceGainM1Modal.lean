/-! ## The right graph (one-way chain) -/

noncomputable def modeG (q : ℕ) : RMode (Var 2) :=
  { sys := rightBlock (fRG q) (Term.const 1), dom := domRG, weight := 1 }

def edgeG (st tgt : ℕ) : REdge (Var 2) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrG : SearchGraph (Var 2) :=
  { modes := [modeG 0, modeG 1, modeG 2],
    edges := [edgeG 0 1, edgeG 0 0, edgeG 1 2, edgeG 1 1, edgeG 2 2] }

theorem GrG_modeAt (q : ℕ) (hq : q < 3) : GrG.modeAt q = some (modeG q) := by
  interval_cases q <;> rfl

theorem httG : ∀ q, ∀ e ∈ GrG.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrG.edges := List.mem_of_mem_filter he
  simp only [GrG, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltG : ∀ q, ∀ e ∈ GrG.edgesFrom q, e.tgt < GrG.modes.length := by
  intro q e he
  have hmem : e ∈ GrG.edges := List.mem_of_mem_filter he
  simp only [GrG, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrG, edgeG]

theorem hRvG : ∀ q m, GrG.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeG q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrG] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrG] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrG] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrG])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRG q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRG q) (Term.const 1) (hfRG q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRG hy

theorem edgeG_mem : ∀ st tgt, edgeG st tgt ∈ GrG.edges →
    edgeG st tgt ∈ GrG.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeG]⟩

theorem hfreshG : ∀ q m, GrG.modeAt q = some m →
    mvG ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvG q m hm (vars_ode_sub _ _ (Or.inl hmv)))

