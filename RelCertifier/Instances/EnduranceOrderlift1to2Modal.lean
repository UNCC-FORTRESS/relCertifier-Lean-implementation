/-! ## The right graph (one-way chain) -/

noncomputable def modeO (q : ℕ) : RMode (Var 3) :=
  { sys := rightBlock (fRO q) (Term.const 1), dom := domRO, weight := 1 }

def edgeO (st tgt : ℕ) : REdge (Var 3) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrO : SearchGraph (Var 3) :=
  { modes := [modeO 0, modeO 1, modeO 2],
    edges := [edgeO 0 1, edgeO 0 0, edgeO 1 2, edgeO 1 1, edgeO 2 2] }

theorem GrO_modeAt (q : ℕ) (hq : q < 3) : GrO.modeAt q = some (modeO q) := by
  interval_cases q <;> rfl

theorem httO : ∀ q, ∀ e ∈ GrO.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrO.edges := List.mem_of_mem_filter he
  simp only [GrO, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltO : ∀ q, ∀ e ∈ GrO.edgesFrom q, e.tgt < GrO.modes.length := by
  intro q e he
  have hmem : e ∈ GrO.edges := List.mem_of_mem_filter he
  simp only [GrO, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrO, edgeO]

theorem hRvO : ∀ q m, GrO.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeO q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrO] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrO] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrO] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrO])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRO q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRO q) (Term.const 1) (hfRO q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRO hy

theorem edgeO_mem : ∀ st tgt, edgeO st tgt ∈ GrO.edges →
    edgeO st tgt ∈ GrO.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeO]⟩

theorem hfreshO : ∀ q m, GrO.modeAt q = some m →
    mvO ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvO q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataO : List ((Fin 3 → Term (Var 3)) × Formula (Var 3) × ℕ) :=
  [(fLO 0, domLO, 4), (fLO 1, domLO, 4), (fLO 2, domLO, 4)]

noncomputable def leftProgsO (dt : ℝ) : List (Program (Var 3)) :=
  leftDataO.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgO dt d.2.2)

theorem hLO : ∀ d ∈ leftDataO, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataO, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLO 0 (by norm_num), hdomLO⟩
  · exact ⟨hfLO 1 (by norm_num), hdomLO⟩
  · exact ⟨hfLO 2 (by norm_num), hdomLO⟩

theorem hframesO (dt : ℝ) : ∀ P ∈ leftProgsO dt, FramesMv P mvO := by
  intro P hP
  simp only [leftProgsO, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgO dt d.2.2 mvO (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

