  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFO : mvO ∉ (FM gO gsO).fv := notMem_FM_fv hmvg
theorem htgFO : tgO ∉ (FM gO gsO).fv := notMem_FM_fv htgg

theorem hmvenvO : mvO ∉ envO.fv := fun h => by
