/-! ## Side-splits -/

theorem fLO_pipe (l : ℕ) (i : Fin 3) : fLO l i =
    (((some (mLO l)).bind (Run.dynOf vsO 3 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRO_pipe (q : ℕ) (i : Fin 3) : fRO q i =
    (((some (mRO q)).bind (Run.dynOf vsO 3 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLO_pipe : domLO =
    (((some (mLO 0)).bind (fun m => Run.lowerF vsO 3 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRO_pipe : domRO =
    (((some (mRO 0)).bind (fun m => Run.lowerF vsO 3 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLO (l : ℕ) (hl : l < 3) : ∀ i, (fLO l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsO) (some (mLO l))
    (by interval_cases l <;>
      simp [mLO, endurance_orderlift_1to2_IR, Parse.PExpr.namesFree]) i x
    (fLO_pipe l i ▸ hx))

theorem hfRO (q : ℕ) (hq : q < 3) : ∀ i, (fRO q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsO) (some (mRO q))
    (by interval_cases q <;>
      simp [mRO, endurance_orderlift_1to2_IR, Parse.PExpr.namesFree]) i x
    (fRO_pipe q i ▸ hx))

theorem hdomLO : domLO.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsO) (some (mLO 0))
    (by simp [mLO, endurance_orderlift_1to2_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLO_pipe ▸ hx))

theorem hdomRO : domRO.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsO) (some (mRO 0))
    (by simp [mRO, endurance_orderlift_1to2_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRO_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gO :: gsO, mvO ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gO, gsO, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gO :: gsO, tgO ∉ g'.fv := by
