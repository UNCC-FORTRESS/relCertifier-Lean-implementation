def vsJ : List String := ["v", "s", "a", "j"]
def dummyJ : Parse.PMode := ⟨"", [], .tt, .tt, []⟩
def mLJ (l : ℕ) : Parse.PMode := endurance_orderlift_2to3_IR.L.modes.getD l dummyJ
def mRJ (q : ℕ) : Parse.PMode := endurance_orderlift_2to3_IR.R.modes.getD q dummyJ

abbrev mvJ : Var 4 := (Side.Aux, 0)
abbrev aJ : Fin 4 := (1 : Fin 4)
abbrev tgJ : Var 4 := (Side.Aux, aJ)

noncomputable def fLJ (l : ℕ) : Fin 4 → Term (Var 4) := hostDyn vsJ 4 Side.L (mLJ l)
noncomputable def fRJ (q : ℕ) : Fin 4 → Term (Var 4) := hostDyn vsJ 4 Side.R (mRJ q)
noncomputable def domLJ : Formula (Var 4) := hostEvolve vsJ 4 Side.L (mLJ 0)
noncomputable def domRJ : Formula (Var 4) := hostEvolve vsJ 4 Side.R (mRJ 0)
noncomputable def envJ : Formula (Var 4) := Formula.and domLJ domRJ

def atomsOf : Parse.PForm → List Parse.PForm
  | .and x y => atomsOf x ++ atomsOf y
  | f => [f]

def invJPF : Parse.PForm :=
  (endurance_orderlift_2to3_IR.invariants.getD 0 ("", Parse.PForm.tt)).2

noncomputable def gAt (i : ℕ) : Term (Var 4) :=
