      Real.norm_eq_abs]
    linarith [abs_le.mp hxv]
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcst : 0 ≤ cstJ q ∧ cstJ q ≤ 52/5 := by
      interval_cases q <;> norm_num [cstJ]
    obtain ⟨hcl, hch⟩ := hcst
    rw [abs_le]
    constructor <;> nlinarith [abs_le.mp hxa]
