/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdJ (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gJ :: gsJ).length),
    z3solve (flowQuery ⟨(gJ :: gsJ)[i], fLJ l, fRJ m, Term.const (1),
      strataDomHost (Formula.and domLJ domRJ) ((gJ :: gsJ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gJ :: gsJ)[i], fLJ l, fRJ m, Term.const (1),
      strataDomHost (Formula.and domLJ domRJ) ((gJ :: gsJ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gJ :: gsJ)[i], fLJ l, fRJ m, Term.const (1),
      strataDomHost (Formula.and domLJ domRJ) ((gJ :: gsJ).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleJ (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdJ l m) :
    ∀ σ', Formula.sat (Formula.and (FM gJ gsJ) envJ) σ' → σ' tgJ = 0 →
      faModalB (Equiv.refl (Var 4))
        (Program.ode (DLCalTiming.clk tgJ (leftBlock (fLJ l))) domLJ)
        (Program.ode (rightBlock (fRJ m) (Term.const (1))) domRJ)
        (Formula.and (FM gJ gsJ) envJ) tgJ dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgJ (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgJ
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLJ l) (fRJ m) (Term.const (1))
    (Formula.and domLJ domRJ) (gJ :: gsJ) hv
  have hboxes : ∀ g' ∈ gJ :: gsJ, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLJ l) ++ rightBlock (fRJ m) (Term.const (1)))
      (Formula.and domLJ domRJ)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gJ gsJ σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gJ gsJ (fLJ l) (fRJ m)
    (Term.const (1)) domLJ domRJ tgJ dt
    (LR_blocks_disjoint _ _ _ (hfLJ l hl) (hfRJ m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLJ hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRJ hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLJ l) _ h
      exact aux_ne_Lv aJ i hi)
    (fun h => aux_notin_range_Lv aJ (leftBlock_readVars_sub (fLJ l) (hfLJ l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRJ m) (Term.const (1)) _ h
      exact aux_ne_Rv aJ i hi)
    (fun h => aux_notin_range_Rv aJ (rightBlock_readVars_sub (fRJ m)
      (Term.const (1)) (hfRJ m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aJ (rightBlock_boundSet_sub (fRJ m)
      (Term.const (1)) h))
    (fun h => aux_notin_range_Lv aJ (hdomLJ h))
    (fun h => aux_notin_range_Rv aJ (hdomRJ h))
    htgg hboxes
    (esJ l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLJ ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRJ μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLJ μ := by
    rwa [(Formula.coincidence domLJ (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLJ hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRJ m) (Term.const (1)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLJ μ ↔ Formula.sat domLJ ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1J (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdJ l m) :
    ∀ σ, Formula.sat (Formula.and (FM gJ gsJ) envJ) σ →
      faModalB (Equiv.refl (Var 4))
        (Program.ode (DLCalTiming.clk tgJ (leftBlock (fLJ l))) domLJ)
        (Program.ode (rightBlock (fRJ m) (Term.const 1)) domRJ) (Formula.and (FM gJ gsJ) envJ) tgJ dt
        (Function.update σ tgJ 0) := by
  intro σ hσ
  have htgφ : tgJ ∉ (Formula.and (FM gJ gsJ) envJ).fv := by
    intro h
    rcases h with h | h
    · exact htgFJ h
    · exact htgenvJ h
  have hupdφ : Formula.sat (Formula.and (FM gJ gsJ) envJ)
      (Function.update σ tgJ 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gJ gsJ) envJ) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gJ gsJ) envJ) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleJ l m hl hm dt hdt hv
    (Function.update σ tgJ 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (1) 1 (by norm_num) one_pos hsem

/-! ## The window response (2 pieces at the in-place mode) -/

theorem respondJ (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdJ l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 4)}
    (hσ : Formula.sat (Formula.and (FM gJ gsJ) envJ) σ) :
    Formula.sat (faModal (Equiv.refl (Var 4))
      (windowSeg (leftBlock (fLJ l)) domLJ tgJ dt 2)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRJ p) (Term.const 1)) domRJ))
        ++ [Program.ode (rightBlock (fRJ m) (Term.const 1)) domRJ,
        Program.ode (rightBlock (fRJ m) (Term.const 1)) domRJ]))
      (Formula.and (FM gJ gsJ) envJ)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLJ l) domLJ (FM gJ gsJ) envJ
    aJ dt 2 htgFJ htgenvJ
    (path.map (fun p => (⟨fRJ p, Term.const 1, domRJ⟩ : RepoHop 4)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRJ p (hpath p hp), by simp [Term.fv], hdomRJ⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRJ p)
        (lam := Term.const 1) (domR := domRJ) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLJ l hl) hdomLJ
    (List.replicate 2 (Program.ode (rightBlock (fRJ m) (Term.const 1)) domRJ)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRJ m, Term.const 1, domRJ⟩ : RepoHop 4)
        (hfRJ m hm) (by simp [Term.fv]) hdomRJ (hfLJ l hl) hdomLJ)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1J l m hl hm dt hdt hv σ' hσ')
    hσ
  rw [show (path.map (fun p => (⟨fRJ p, Term.const 1, domRJ⟩ : RepoHop 4))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRJ p) (Term.const 1)) domRJ)
    from by rw [List.map_map]; rfl] at hfa
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiJ (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdJ 0 0) (hv01 : VerdJ 0 1) (hv02 : VerdJ 0 2) (hv11 : VerdJ 1 1) (hv12 : VerdJ 1 2) (hv22 : VerdJ 2 2) :
    ∀ P ∈ leftProgsJ dt, ∀ (q : ℕ), q < GrJ.modes.length → ∀ σ, σ mvJ = (q : ℝ) →
      Formula.sat (Formula.and (FM gJ gsJ) envJ) σ →
      ∃ segs : List (ℕ × RMode (Var 4) × REdge (Var 4)),
        (∀ s ∈ segs, GrJ.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrJ.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 4)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gJ gsJ) envJ)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrJ] using hq
  have hself : GrJ.modeAt q = some (modeJ q) ∧ edgeJ q q ∈ GrJ.edgesFrom q := by
    refine ⟨GrJ_modeAt q hq3, edgeJ_mem q q ?_⟩
    interval_cases q <;> simp [GrJ]
  have hstep : ∀ (a b : ℕ × RMode (Var 4) × REdge (Var 4)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 4) × REdge (Var 4)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsJ, leftDataJ, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeJ st tgt ∈ GrJ.edges →
      GrJ.modeAt st = some (modeJ st) ∧ edgeJ st tgt ∈ GrJ.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrJ_modeAt st hs, edgeJ_mem st tgt he⟩
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeJ 0, edgeJ 0 0), (0, modeJ 0, edgeJ 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(1, modeJ 1, edgeJ 1 1), (1, modeJ 1, edgeJ 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(2, modeJ 2, edgeJ 2 2), (2, modeJ 2, edgeJ 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(0, modeJ 0, edgeJ 0 1), (1, modeJ 1, edgeJ 1 1), (1, modeJ 1, edgeJ 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 1 1 (by norm_num) (by norm_num) dt hdt hv11 [0] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl <;> norm_num) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(1, modeJ 1, edgeJ 1 1), (1, modeJ 1, edgeJ 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(2, modeJ 2, edgeJ 2 2), (2, modeJ 2, edgeJ 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(0, modeJ 0, edgeJ 0 1), (1, modeJ 1, edgeJ 1 2), (2, modeJ 2, edgeJ 2 2), (2, modeJ 2, edgeJ 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 1 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp))))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [0, 1] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl | rfl <;> norm_num) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(1, modeJ 1, edgeJ 1 2), (2, modeJ 2, edgeJ 2 2), (2, modeJ 2, edgeJ 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 1 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [1] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl <;> norm_num) hσ
      simpa [modeJ, List.replicate] using this
  · refine ⟨[(2, modeJ 2, edgeJ 2 2), (2, modeJ 2, edgeJ 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrJ])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondJ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [] (by simp) hσ
      simpa [modeJ, List.replicate] using this

/-- **`endurance_orderlift_2to3`, modal Theorem 3** (λ = 1, k = 2). -/
theorem endurance_orderlift_2to3_modal (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdJ 0 0) (hv01 : VerdJ 0 1) (hv02 : VerdJ 0 2) (hv11 : VerdJ 1 1) (hv12 : VerdJ 1 2) (hv22 : VerdJ 2 2) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsJ dt))
      (rightAutomatonBody GrJ mvJ)
      (RFormula.and (RFormula.and (canonInvM gJ gsJ) (envLR domLJ domRJ))
        (mvValidR mvJ GrJ.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrJ mvJ (FM gJ gsJ) domLJ domRJ
    (leftProgsJ dt) (canonInvM gJ gsJ) (encode_canonInvM gJ gsJ) ?_ ?_ ?_
  · exact hdis_multi GrJ 0 1 dt leftDataJ (by decide) httJ hRvJ hLJ
  · exact hstep_assembled_multiF GrJ mvJ (FM gJ gsJ) envJ (leftProgsJ dt)
      hmvFJ hmvenvJ hfreshJ httJ hltJ (hframesJ dt)
      (HmultiJ dt hdt hv00 hv01 hv02 hv11 hv12 hv22)
  · exact hddF_multiE GrJ 0 1 dt leftDataJ (canonInvM gJ gsJ) domLJ domRJ
      (by decide) httJ hRvJ hLJ
      (canonInvM_varsL gJ gsJ (by
        intro g' hg'
        simp only [gJ, gsJ, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gJ gsJ) hdomLJ hdomRJ

