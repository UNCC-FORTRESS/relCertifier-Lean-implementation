/-! ## The frozen-left joint field -/

theorem odeField_RJ (q : ℕ) (hq : q < 3) (x : State (Var 4)) :
    odeField (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))) x
      = fun c =>
        if c = Rv 0 then x (Rv 2) - 4 * x (Rv 0)
        else if c = Rv 1 then x (Rv 0)
        else if c = Rv 2 then cstJ q - 4 * x (Rv 2)
        else 0 := by
  funext c
  by_cases hc : c ∈ (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))).bound
  · rw [show odeField (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))) x c
        = ((jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))).rhs c).eval x from by
      simp only [odeField, if_pos hc]]
    obtain ⟨p, hp, hfst⟩ : ∃ p ∈ jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1)),
        p.1 = c := by simpa [ODESystem.bound, List.mem_map] using hc
    rw [← hfst, ODESystem.rhs_eq_of_mem (jointSys_wellFormed _ _ _) hp]
    rw [jointSys_split] at hp
    have hne : ∀ (a b : Fin 4), a ≠ b → (Rv a : Var 4) ≠ Rv b := by
      intro a b hab
      simp [Rv, Prod.ext_iff]
      exact fun h => hab (by exact_mod_cast h)
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      have hLR : ∀ k : Fin 4, (Lv j : Var 4) ≠ Rv k := by
        intro k
        simp [Lv, Rv, Prod.ext_iff]
      simp [Term.eval, hLR 0, hLR 1, hLR 2]
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      fin_cases j
      · simp [Term.eval, AOp.interp, fRJ0_eval q hq]
      · simp [Term.eval, AOp.interp, fRJ1_eval q hq,
          hne 1 0 (by decide)]
      · simp [Term.eval, AOp.interp, fRJ2_eval q hq,
          hne 2 0 (by decide),
          hne 2 1 (by decide)]
      · simp [Term.eval, AOp.interp, fRJ3_eval q hq,
          hne 3 0 (by decide),
          hne 3 1 (by decide),
          hne 3 2 (by decide)]
  · have hnotR : ∀ j : Fin 4, c ≠ Rv j := by
      intro j hceq
      refine hc ?_
      rw [hceq, jointSys_split]
      simp only [ODESystem.bound, List.map_append, List.mem_append]
      exact Or.inr (by
        simp only [rightBlock, List.map_map, List.mem_map]
        exact ⟨j, List.mem_finRange j, rfl⟩)
    simp only [odeField, if_neg hc, if_neg (hnotR 0), if_neg (hnotR 1), if_neg (hnotR 2)]

/-! ## Strict inflow -/

theorem hbndS_J (q : ℕ) (hq : q < 3) : ∀ gT' ∈ gsSJ, ∀ x : State (Var 4),
    (∀ gT'' ∈ gsSJ, Term.eval gT'' x ≤ 0) →
    Term.eval gT' x = 0 →
    Lie (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1)))
      (fun ω => Term.eval gT' ω) x < 0 := by
  have hne : ∀ (a b : Fin 4), a ≠ b → (Rv a : Var 4) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
