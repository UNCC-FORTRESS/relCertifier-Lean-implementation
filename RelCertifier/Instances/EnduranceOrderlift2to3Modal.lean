  · exact absurd (hdomRJ h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

/-! ## The right graph (one-way chain) -/

noncomputable def modeJ (q : ℕ) : RMode (Var 4) :=
  { sys := rightBlock (fRJ q) (Term.const 1), dom := domRJ, weight := 1 }

def edgeJ (st tgt : ℕ) : REdge (Var 4) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrJ : SearchGraph (Var 4) :=
  { modes := [modeJ 0, modeJ 1, modeJ 2],
    edges := [edgeJ 0 1, edgeJ 0 0, edgeJ 1 2, edgeJ 1 1, edgeJ 2 2] }

theorem GrJ_modeAt (q : ℕ) (hq : q < 3) : GrJ.modeAt q = some (modeJ q) := by
  interval_cases q <;> rfl

theorem httJ : ∀ q, ∀ e ∈ GrJ.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrJ.edges := List.mem_of_mem_filter he
  simp only [GrJ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltJ : ∀ q, ∀ e ∈ GrJ.edgesFrom q, e.tgt < GrJ.modes.length := by
  intro q e he
  have hmem : e ∈ GrJ.edges := List.mem_of_mem_filter he
  simp only [GrJ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrJ, edgeJ]

theorem hRvJ : ∀ q m, GrJ.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeJ q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrJ] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrJ] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrJ] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrJ])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRJ q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRJ q) (Term.const 1) (hfRJ q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRJ hy

theorem edgeJ_mem : ∀ st tgt, edgeJ st tgt ∈ GrJ.edges →
    edgeJ st tgt ∈ GrJ.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeJ]⟩

theorem hfreshJ : ∀ q m, GrJ.modeAt q = some m →
    mvJ ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvJ q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataJ : List ((Fin 4 → Term (Var 4)) × Formula (Var 4) × ℕ) :=
  [(fLJ 0, domLJ, 2), (fLJ 1, domLJ, 2), (fLJ 2, domLJ, 2)]

noncomputable def leftProgsJ (dt : ℝ) : List (Program (Var 4)) :=
  leftDataJ.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgJ dt d.2.2)

theorem hLJ : ∀ d ∈ leftDataJ, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataJ, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLJ 0 (by norm_num), hdomLJ⟩
  · exact ⟨hfLJ 1 (by norm_num), hdomLJ⟩
  · exact ⟨hfLJ 2 (by norm_num), hdomLJ⟩

theorem hframesJ (dt : ℝ) : ∀ P ∈ leftProgsJ dt, FramesMv P mvJ := by
  intro P hP
  simp only [leftProgsJ, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgJ dt d.2.2 mvJ (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

