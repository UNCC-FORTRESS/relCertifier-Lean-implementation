noncomputable def gJ : Term (Var 4) := gAt 0
noncomputable def gsJ : List (Term (Var 4)) := [gAt 1]

/-! ## Side-splits -/

theorem fLJ_pipe (l : ℕ) (i : Fin 4) : fLJ l i =
    (((some (mLJ l)).bind (Run.dynOf vsJ 4 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRJ_pipe (q : ℕ) (i : Fin 4) : fRJ q i =
    (((some (mRJ q)).bind (Run.dynOf vsJ 4 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLJ_pipe : domLJ =
    (((some (mLJ 0)).bind (fun m => Run.lowerF vsJ 4 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRJ_pipe : domRJ =
    (((some (mRJ 0)).bind (fun m => Run.lowerF vsJ 4 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLJ (l : ℕ) (hl : l < 3) : ∀ i, (fLJ l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsJ) (some (mLJ l))
    (by interval_cases l <;>
      simp [mLJ, endurance_orderlift_2to3_IR, Parse.PExpr.namesFree]) i x
    (fLJ_pipe l i ▸ hx))

theorem hfRJ (q : ℕ) (hq : q < 3) : ∀ i, (fRJ q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsJ) (some (mRJ q))
    (by interval_cases q <;>
      simp [mRJ, endurance_orderlift_2to3_IR, Parse.PExpr.namesFree]) i x
    (fRJ_pipe q i ▸ hx))

theorem hdomLJ : domLJ.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsJ) (some (mLJ 0))
    (by simp [mLJ, endurance_orderlift_2to3_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLJ_pipe ▸ hx))

theorem hdomRJ : domRJ.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsJ) (some (mRJ 0))
    (by simp [mRJ, endurance_orderlift_2to3_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRJ_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gJ :: gsJ, mvJ ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gJ, gsJ, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gJ :: gsJ, tgJ ∉ g'.fv := by
