  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gJ, gsJ, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFJ : mvJ ∉ (FM gJ gsJ).fv := notMem_FM_fv hmvg
theorem htgFJ : tgJ ∉ (FM gJ gsJ).fv := notMem_FM_fv htgg

theorem hmvenvJ : mvJ ∉ envJ.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLJ h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRJ h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))
