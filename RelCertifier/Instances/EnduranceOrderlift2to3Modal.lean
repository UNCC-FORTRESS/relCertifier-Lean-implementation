/-! ## Lipschitz and field bound -/

theorem hLip_J (q : ℕ) (hq : q < 3) (ν : State (Var 4)) :
    LipschitzOnWith 20 (odeField (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 4), a ≠ b → (Rv a : Var 4) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RJ q hq, odeField_RJ q hq]
  have hdc : ∀ j : Fin 4, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((20 : NNReal) : ℝ) = 20 := rfl
  rw [hcoe]
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : x (Rv 2) - 4 * x (Rv 0) - (y (Rv 2) - 4 * y (Rv 0))
        = (x (Rv 2) - y (Rv 2)) - 4 * (x (Rv 0) - y (Rv 0)) := by ring
    rw [hdiff]
    have h1 := hdc 2
    have h2 := hdc 0
    have := abs_sub (x (Rv 2) - y (Rv 2)) (4 * (x (Rv 0) - y (Rv 0)))
    have h4 : |4 * (x (Rv 0) - y (Rv 0))| ≤ 4 * dist x y := by
      rw [abs_mul]
      have : |(4:ℝ)| = 4 := by norm_num
      rw [this]
      nlinarith
    calc |(x (Rv 2) - y (Rv 2)) - 4 * (x (Rv 0) - y (Rv 0))|
        ≤ |x (Rv 2) - y (Rv 2)| + |4 * (x (Rv 0) - y (Rv 0))| := by
          rw [sub_eq_add_neg]
          refine (abs_add_le _ _).trans ?_
          rw [abs_neg]
      _ ≤ 20 * dist x y := by nlinarith
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    nlinarith [hdc 0]
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)),
      eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : cstJ q - 4 * x (Rv 2) - (cstJ q - 4 * y (Rv 2))
        = -4 * (x (Rv 2) - y (Rv 2)) := by ring
    rw [hdiff, abs_mul]
    have habs : |(-4 : ℝ)| = 4 := by norm_num
    rw [habs]
    nlinarith [hdc 2]
  · simp only [if_neg hc0, if_neg hc1, if_neg hc2]
    simp [dist_nonneg]

theorem hfbnd_J (q : ℕ) (hq : q < 3) (ν : State (Var 4))
    (hν : ∀ gT' ∈ gsSJ, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
      ‖odeField (jointSys (fun _ => Term.const 0) (fRJ q) (Term.const (1))) x‖
