  rw [odeField_RJ q hq]
  refine pi_norm_le_iff_of_nonneg (by norm_num) |>.mpr ?_
  intro c
  have hLcoe : ((32:NNReal) : ℝ) = 32 := rfl
  rw [hLcoe]
  by_cases hc0 : c = Rv 0
  · subst hc0
