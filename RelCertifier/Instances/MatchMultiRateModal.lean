/-! ## The frozen-left joint field -/

theorem odeField_RM (lam : ℝ) (q : ℕ) (hq : q < 1) (x : State (Var 2)) :
    odeField (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)) x
      = fun c =>
        if c = Rv 0 then lam * (1 * (cstM q - x (Rv 0)))
        else if c = Rv 1 then lam * x (Rv 0)
        else 0 := by
  funext c
  by_cases hc : c ∈ (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)).bound
  · rw [show odeField (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)) x c
        = ((jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)).rhs c).eval x from by
      simp only [odeField, if_pos hc]]
    obtain ⟨p, hp, hfst⟩ : ∃ p ∈ jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam),
        p.1 = c := by simpa [ODESystem.bound, List.mem_map] using hc
    rw [← hfst, ODESystem.rhs_eq_of_mem (jointSys_wellFormed _ _ _) hp]
    rw [jointSys_split] at hp
    have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
      intro a b hab
      simp [Rv, Prod.ext_iff]
      exact fun h => hab (by exact_mod_cast h)
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      have hLR : ∀ k : Fin 2, (Lv j : Var 2) ≠ Rv k := by
        intro k
        simp [Lv, Rv, Prod.ext_iff]
      simp [Term.eval, hLR 0, hLR 1]
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      fin_cases j
      · simp [Term.eval, AOp.interp, fRM0_eval q hq]
      · simp [Term.eval, AOp.interp, fRM1_eval q hq,
          hne 1 0 (by decide)]
  · have hnotR : ∀ j : Fin 2, c ≠ Rv j := by
      intro j hceq
      refine hc ?_
      rw [hceq, jointSys_split]
      simp only [ODESystem.bound, List.map_append, List.mem_append]
      exact Or.inr (by
        simp only [rightBlock, List.map_map, List.mem_map]
        exact ⟨j, List.mem_finRange j, rfl⟩)
    simp only [odeField, if_neg hc, if_neg (hnotR 0), if_neg (hnotR 1)]

/-! ## Strict inflow -/

theorem hbndS_M (lam : ℝ) (hlam : 0 < lam ∧ lam ≤ 3) (q : ℕ) (hq : q < 1) : ∀ gT' ∈ gsSM, ∀ x : State (Var 2),
    Term.eval gT' x = 0 →
    Lie (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam))
      (fun ω => Term.eval gT' ω) x < 0 := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro gT' hgT x hface
  simp only [gsSM, List.mem_cons, List.not_mem_nil, or_false] at hgT
  rcases hgT with rfl | rfl
  · have hx : x (Rv 0) = 0 := by
      simp only [faceVLo, Term.eval, AOp.interp] at hface; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceVLo ω)
        = fun y => (-1 : ℝ) * y (Rv 0) + (0) := by
      funext y; simp [faceVLo, Term.eval, AOp.interp]
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 0) (-1) (0) x,
      odeField_RM lam q hq]
    simp only [eq_self_iff_true, if_true, if_pos rfl, hx]
    interval_cases q <;> simp [cstM] <;> nlinarith [hlam.1, hlam.2]
  · have hx : x (Rv 0) = (23:ℝ)/20 := by
      simp only [faceVHi, Term.eval, AOp.interp] at hface; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceVHi ω)
        = fun y => (1 : ℝ) * y (Rv 0) + (-((23:ℝ)/20)) := by
      funext y; simp [faceVHi, Term.eval, AOp.interp]; ring
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 0) 1 (-((23:ℝ)/20)) x,
      odeField_RM lam q hq]
    simp only [eq_self_iff_true, if_true, if_pos rfl, hx]
    interval_cases q <;> simp [cstM] <;> nlinarith [hlam.1, hlam.2]

/-! ## Non-strict faces -/

theorem hbndN_M (lam : ℝ) (hlam : 0 < lam ∧ lam ≤ 3) (q : ℕ) (hq : q < 1) : ∀ i (hi : i < gsNM.length),
    ∀ x : State (Var 2),
    (∀ gT' ∈ gsSM ++ ([] : List (Term (Var 2))), Term.eval gT' x ≤ 0) →
    Lie (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam))
      (fun ω => Term.eval gsNM[i] ω) x ≤ 0 := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro i hi x hx
  have hib : i < 1 := by simpa [gsNM] using hi
  interval_cases i
  · show Lie _ (fun ω => Term.eval faceSLo ω) x ≤ 0
    have hv0 : 0 ≤ x (Rv 0) := by
      have := hx faceVLo (List.mem_append_left _ (by simp [gsSM]))
      simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
    have hfun : (fun ω : State (Var 2) => Term.eval faceSLo ω)
        = fun y => (-1 : ℝ) * y (Rv 1) + 0 := by
      funext y; simp [faceSLo, Term.eval, AOp.interp]
    rw [hfun, lie_affine_coord _ (jointSys_wellFormed _ _ _) (Rv 1) (-1) 0 x,
      odeField_RM lam q hq]
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    nlinarith [hlam.1, hlam.2, hv0]

/-! ## Lipschitz and field bound -/

theorem hLip_M (lam : ℝ) (hlam : 0 < lam ∧ lam ≤ 3) (q : ℕ) (hq : q < 1) (ν : State (Var 2)) :
    LipschitzOnWith 12 (odeField (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RM lam q hq, odeField_RM lam q hq]
  have hdc : ∀ j : Fin 2, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((12 : NNReal) : ℝ) = 12 := rfl
  rw [hcoe]
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |1 * (cstM q - x (Rv 0)) - 1 * (cstM q - y (Rv 0))| ≤ 1 * dist x y := by
      have hdiff : 1 * (cstM q - x (Rv 0)) - 1 * (cstM q - y (Rv 0)) = -(1 : ℝ) * (x (Rv 0) - y (Rv 0)) := by ring
      rw [hdiff, abs_mul]
      have habs : |-(1 : ℝ)| = 1 := by norm_num
      rw [habs]
      nlinarith [hdc 0]
    have hfac : ∀ A B : ℝ, lam * A - lam * B = lam * (A - B) := by
      intro A B; ring
    rw [hfac, abs_mul, abs_of_pos hlam.1]
    nlinarith [hcore, hd]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |x (Rv 0) - y (Rv 0)| ≤ 1 * dist x y := by
      have hdiff : x (Rv 0) - y (Rv 0) = (1 : ℝ) * (x (Rv 0) - y (Rv 0)) := by ring
      rw [hdiff, abs_mul]
      have habs : |(1 : ℝ)| = 1 := by norm_num
      rw [habs]
      nlinarith [hdc 0]
    have hfac : ∀ A B : ℝ, lam * A - lam * B = lam * (A - B) := by
      intro A B; ring
    rw [hfac, abs_mul, abs_of_pos hlam.1]
    nlinarith [hcore, hd]
  · simp only [if_neg hc0, if_neg hc1]
    simp [dist_nonneg]

theorem hfbnd_M (lam : ℝ) (hlam : 0 < lam ∧ lam ≤ 3) (q : ℕ) (hq : q < 1) (ν : State (Var 2))
    (hν : ∀ gT' ∈ gsSM, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
      ‖odeField (jointSys (fun _ => Term.const 0) (fRM q) (Term.const lam)) x‖
        ≤ ((16:NNReal) : ℝ) := by
  have hne : ∀ (a b : Fin 2), a ≠ b → (Rv a : Var 2) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro x hx
  rw [Metric.mem_closedBall] at hx
  have hbandf : ∀ (j : Fin 2) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -2 ≤ lo → hi ≤ 2 → |x (Rv j)| ≤ 3 := by
    intro j lo hi hl hh hlo1 hhi1
    have h := dist_le_pi_dist x ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (x (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hx]
  have hxb0 : |x (Rv 0)| ≤ 3 := by
    refine hbandf 0 (0) ((23:ℝ)/20) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceVLo (by simp [gsSM])
      simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceVHi (by simp [gsSM])
      simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
  rw [odeField_RM lam q hq]
  refine pi_norm_le_iff_of_nonneg (by norm_num) |>.mpr ?_
  intro c
  have hLcoe : ((16:NNReal) : ℝ) = 16 := rfl
  rw [hLcoe]
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcst : 0 ≤ cstM q ∧ cstM q ≤ 1 := by
      interval_cases q <;> norm_num [cstM]
    have hcore : |1 * (cstM q - x (Rv 0))| ≤ 4 := by
      obtain ⟨hcl, hch⟩ := hcst
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxb0]
    rw [show lam * (1 * (cstM q - x (Rv 0))) = lam * (1 * (cstM q - x (Rv 0))) from by ring, abs_mul,
      abs_of_pos hlam.1]
    nlinarith [hcore, abs_nonneg (1 * (cstM q - x (Rv 0)))]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |x (Rv 0)| ≤ 3 := hxb0
    rw [show lam * (x (Rv 0)) = lam * (x (Rv 0)) from by ring, abs_mul,
      abs_of_pos hlam.1]
    nlinarith [hcore, abs_nonneg (x (Rv 0))]
  · simp only [if_neg hc0, if_neg hc1]
    norm_num

/-! ## Existence -/

theorem esM (lam : ℝ) (hlam : 0 < lam ∧ lam ≤ 3) (l m : ℕ) (hl : l < 4) (hm : m < 1) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gM gsM) envM) σ →
      HExistSegB (fLM l) (fRM m) (Term.const lam) domLM domRM dt
        (Function.update σ tgM 0) := by
  intro σ hσ
  have hR : Formula.sat domRM σ := hσ.2.2
  rw [sat_domRM] at hR
  obtain ⟨hd1l, hd0l, hd0h⟩ := hR
  have hupd : ∀ j : Fin 2, σ (Side.R, j) = Function.update σ tgM 0 (Side.R, j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgM, Prod.ext_iff])]
  have hfS : ∀ gT' ∈ gsSM, Term.eval gT' (Function.update σ tgM 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsSM, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl | rfl <;>
      · first
          | (simp only [faceVLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceVHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  have hfN : ∀ gT' ∈ gsNM, Term.eval gT' (Function.update σ tgM 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsNM, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl <;>
      · first
          | (simp only [faceSLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  refine HExistSegB_of_viability_stratified (fLM l) (fRM m) (Term.const lam)
    domLM domRM gsSM [] gsNM 0 le_rfl
    (jointSys_wellFormed _ _ _)
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLM l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RM gT' (by
        rcases List.mem_append.mp hgT with h | h
        · exact List.mem_append_left _ h
        · exact absurd h (List.not_mem_nil)) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLM l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RM gT' (List.mem_append_right _ hgT) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x _ hface
      exact hbndS_M lam hlam m hm gT' hgT x hface)
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))
    (by
      intro i hi x hxs _
      exact hbndN_M lam hlam m hm i hi x hxs)
    (by
      intro x hS hN
      have hS' : ∀ gT' ∈ gsSM, Term.eval gT' x ≤ 0 :=
        fun gT' hgT => hS gT' (List.mem_append_left _ hgT)
      have hb0l : 0 ≤ x (Rv 0) := by
        have := hS' faceVLo (by simp [gsSM])
        simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
      have hb0h : x (Rv 0) ≤ (23:ℝ)/20 := by
        have := hS' faceVHi (by simp [gsSM])
        simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
      have hb1l : 0 ≤ x (Rv 1) := by
        have := hN faceSLo (by simp [gsNM])
        simp only [faceSLo, Term.eval, AOp.interp] at this; linarith
      exact (sat_domRM x).mpr ⟨hb1l, hb0l, hb0h⟩)
    12 16 1 one_pos
    (fun ν0 _ => hLip_M lam hlam m hm ν0)
    (fun ν0 h0 => hfbnd_M lam hlam m hm ν0 (fun gT hgT => h0 gT (List.mem_append_left _ hgT)))
    dt hdt
    (Function.update σ tgM 0)
    hfS
    hfN
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))

/-! ## Per-window stretch -/

noncomputable def lamM (l : ℕ) : ℝ := if l = 0 then 3 else if l = 1 then 2 else 1

theorem lamM_pos (l : ℕ) : 0 < lamM l ∧ lamM l ≤ 3 := by
  simp only [lamM]; split_ifs <;> norm_num

/-! ## The route verdicts (one component, per-window λ) -/

def VerdM (l : ℕ) : Prop :=
  ∀ i (hi : i < (gM :: gsM).length),
    z3solve (flowQuery ⟨(gM :: gsM)[i], fLM l, fRM 0, Term.const (lamM l),
      strataDomHost (Formula.and domLM domRM) ((gM :: gsM).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gM :: gsM)[i], fLM l, fRM 0, Term.const (lamM l),
      strataDomHost (Formula.and domLM domRM) ((gM :: gsM).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gM :: gsM)[i], fLM l, fRM 0, Term.const (lamM l),
      strataDomHost (Formula.and domLM domRM) ((gM :: gsM).take i)⟩) = Verdict.unsat

/-! ## Coupling at λ_l, transported to the λ = 1 automaton -/

theorem coupleM (l : ℕ) (hl : l < 4) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdM l) :
    ∀ σ', Formula.sat (Formula.and (FM gM gsM) envM) σ' → σ' tgM = 0 →
      faModalB (Equiv.refl (Var 2))
        (Program.ode (DLCalTiming.clk tgM (leftBlock (fLM l))) domLM)
        (Program.ode (rightBlock (fRM 0) (Term.const (lamM l))) domRM)
        (Formula.and (FM gM gsM) envM) tgM dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgM (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgM
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLM l) (fRM 0) (Term.const (lamM l))
    (Formula.and domLM domRM) (gM :: gsM) hv
  have hboxes : ∀ g' ∈ gM :: gsM, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLM l) ++ rightBlock (fRM 0) (Term.const (lamM l)))
      (Formula.and domLM domRM)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gM gsM σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gM gsM (fLM l) (fRM 0)
    (Term.const (lamM l)) domLM domRM tgM dt
    (LR_blocks_disjoint _ _ _ (hfLM l hl) (hfRM 0 (by norm_num)) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLM hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRM hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLM l) _ h
      exact aux_ne_Lv aM i hi)
    (fun h => aux_notin_range_Lv aM (leftBlock_readVars_sub (fLM l) (hfLM l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRM 0) (Term.const (lamM l)) _ h
      exact aux_ne_Rv aM i hi)
    (fun h => aux_notin_range_Rv aM (rightBlock_readVars_sub (fRM 0)
      (Term.const (lamM l)) (hfRM 0 (by norm_num)) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aM (rightBlock_boundSet_sub (fRM 0)
      (Term.const (lamM l)) h))
    (fun h => aux_notin_range_Lv aM (hdomLM h))
    (fun h => aux_notin_range_Rv aM (hdomRM h))
    htgg hboxes
    (esM (lamM l) (lamM_pos l) l 0 hl (by norm_num) dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLM ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRM μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLM μ := by
    rwa [(Formula.coincidence domLM (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLM hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRM 0) (Term.const (lamM l)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLM μ ↔ Formula.sat domLM ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1M (l : ℕ) (hl : l < 4) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdM l) :
    ∀ σ, Formula.sat (Formula.and (FM gM gsM) envM) σ →
      faModalB (Equiv.refl (Var 2))
        (Program.ode (DLCalTiming.clk tgM (leftBlock (fLM l))) domLM)
        (Program.ode (rightBlock (fRM 0) (Term.const 1)) domRM)
        (Formula.and (FM gM gsM) envM) tgM dt
        (Function.update σ tgM 0) := by
  intro σ hσ
  have htgφ : tgM ∉ (Formula.and (FM gM gsM) envM).fv := by
    intro h
    rcases h with h | h
    · exact htgFM h
    · exact htgenvM h
  have hupdφ : Formula.sat (Formula.and (FM gM gsM) envM)
      (Function.update σ tgM 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gM gsM) envM) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gM gsM) envM) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleM l hl dt hdt hv
    (Function.update σ tgM 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (lamM l) 1 (lamM_pos l).1 one_pos hsem

/-! ## The window response — k pieces at the single drive mode -/

theorem respondM (l : ℕ) (hl : l < 4) (k : ℕ) (hk : 0 < k) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdM l) {σ : State (Var 2)}
    (hσ : Formula.sat (Formula.and (FM gM gsM) envM) σ) :
    Formula.sat (faModal (Equiv.refl (Var 2))
      (windowSeg (leftBlock (fLM l)) domLM tgM dt k)
      (bigSeq (List.replicate k (Program.ode (rightBlock (fRM 0) (Term.const 1)) domRM)))
      (Formula.and (FM gM gsM) envM)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLM l) domLM (FM gM gsM) envM
    aM dt k htgFM htgenvM [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLM l hl) hdomLM
    (List.replicate k (Program.ode (rightBlock (fRM 0) (Term.const 1)) domRM))
    (by simp) hk
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRM 0, Term.const 1, domRM⟩ : RepoHop 2)
        (hfRM 0 (by norm_num)) (by simp [Term.fv]) hdomRM (hfLM l hl) hdomLM)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1M l hl dt hdt hv σ' hσ')
    hσ
  simpa using hfa

/-! ## The step provider — single right mode, in-place -/

theorem HmultiM (dt : ℝ) (hdt : 0 ≤ dt)
    (hv0 : VerdM 0) (hv1 : VerdM 1) (hv2 : VerdM 2) (hv3 : VerdM 3) :
    ∀ P ∈ leftProgsM dt, ∀ (q : ℕ), q < GrM.modes.length → ∀ σ, σ mvM = (q : ℝ) →
      Formula.sat (Formula.and (FM gM gsM) envM) σ →
      ∃ segs : List (ℕ × RMode (Var 2) × REdge (Var 2)),
        (∀ s ∈ segs, GrM.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrM.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 2)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gM gsM) envM)) σ := by
  intro P hP q hq σ hmv hσ
  have hq1 : q < 1 := by simpa [GrM] using hq
  interval_cases q
  have hself : GrM.modeAt 0 = some (modeM 0) ∧ edgeM 0 0 ∈ GrM.edgesFrom 0 :=
    ⟨GrM_modeAt 0 (by norm_num), edgeM_mem 0 0 (by simp [GrM])⟩
  have hstep : ∀ (a b : ℕ × RMode (Var 2) × REdge (Var 2)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 2) × REdge (Var 2)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsM, leftDataM, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  rcases hP with rfl | rfl | rfl | rfl
  · refine ⟨[(0, modeM 0, edgeM 0 0), (0, modeM 0, edgeM 0 0), (0, modeM 0, edgeM 0 0)],
      ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl <;> exact hself
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondM 0 (by norm_num) 3 (by norm_num) dt hdt hv0 hσ
      simpa [modeM, List.replicate] using this
  · refine ⟨[(0, modeM 0, edgeM 0 0), (0, modeM 0, edgeM 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl <;> exact hself
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondM 1 (by norm_num) 2 (by norm_num) dt hdt hv1 hσ
      simpa [modeM, List.replicate] using this
  · refine ⟨[(0, modeM 0, edgeM 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      exact hself
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondM 2 (by norm_num) 1 (by norm_num) dt hdt hv2 hσ
      simpa [modeM, List.replicate] using this
  · refine ⟨[(0, modeM 0, edgeM 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      exact hself
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondM 3 (by norm_num) 1 (by norm_num) dt hdt hv3 hσ
      simpa [modeM, List.replicate] using this

/-- **`match_multi_rate`, modal Theorem 3** — four left rate windows against the
single right drive mode, each coupled at its own stretch λ ∈ {3, 2, 1, 1} and
transported to the λ = 1 automaton. Residuals: four 3-query packs. -/
theorem match_multi_rate_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv0 : VerdM 0) (hv1 : VerdM 1) (hv2 : VerdM 2) (hv3 : VerdM 3) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsM dt))
      (rightAutomatonBody GrM mvM)
      (RFormula.and (RFormula.and (canonInvM gM gsM) (envLR domLM domRM))
        (mvValidR mvM GrM.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrM mvM (FM gM gsM) domLM domRM
    (leftProgsM dt) (canonInvM gM gsM) (encode_canonInvM gM gsM) ?_ ?_ ?_
  · exact hdis_multi GrM 0 1 dt leftDataM (by decide) httM hRvM hLM
  · exact hstep_assembled_multiF GrM mvM (FM gM gsM) envM (leftProgsM dt)
      hmvFM hmvenvM hfreshM httM hltM (hframesM dt)
      (HmultiM dt hdt hv0 hv1 hv2 hv3)
  · exact hddF_multiE GrM 0 1 dt leftDataM (canonInvM gM gsM) domLM domRM
      (by decide) httM hRvM hLM
      (canonInvM_varsL gM gsM (by
        intro g' hg'
        simp only [gM, gsM, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl <;> exact hgAt _))
      (canonInvM_varsR gM gsM) hdomLM hdomRM

end MatchMultiRateModal
