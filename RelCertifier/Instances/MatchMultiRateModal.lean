  · exact absurd (hdomLM h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRM h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

/-! ## The right graph (one-way chain) -/

noncomputable def modeM (q : ℕ) : RMode (Var 2) :=
  { sys := rightBlock (fRM q) (Term.const 1), dom := domRM, weight := 1 }

def edgeM (st tgt : ℕ) : REdge (Var 2) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrM : SearchGraph (Var 2) :=
  { modes := [modeM 0],
    edges := [edgeM 0 0] }

theorem GrM_modeAt (q : ℕ) (hq : q < 1) : GrM.modeAt q = some (modeM q) := by
  interval_cases q <;> rfl

theorem httM : ∀ q, ∀ e ∈ GrM.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrM.edges := List.mem_of_mem_filter he
  simp only [GrM, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl <;> rfl

theorem hltM : ∀ q, ∀ e ∈ GrM.edgesFrom q, e.tgt < GrM.modes.length := by
  intro q e he
  have hmem : e ∈ GrM.edges := List.mem_of_mem_filter he
  simp only [GrM, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl <;> norm_num [GrM, edgeM]

theorem hRvM : ∀ q m, GrM.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 1 ∧ m = modeM q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrM] using hm.symm⟩
    | q + 1 => exact absurd hm (by simp [SearchGraph.modeAt, GrM])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRM q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRM q) (Term.const 1) (hfRM q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRM hy

theorem edgeM_mem : ∀ st tgt, edgeM st tgt ∈ GrM.edges →
    edgeM st tgt ∈ GrM.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeM]⟩

theorem hfreshM : ∀ q m, GrM.modeAt q = some m →
    mvM ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvM q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataM : List ((Fin 2 → Term (Var 2)) × Formula (Var 2) × ℕ) :=
  [(fLM 0, domLM, 3), (fLM 1, domLM, 2), (fLM 2, domLM, 1), (fLM 3, domLM, 1)]

noncomputable def leftProgsM (dt : ℝ) : List (Program (Var 2)) :=
  leftDataM.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgM dt d.2.2)

theorem hLM : ∀ d ∈ leftDataM, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataM, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl | rfl
  · exact ⟨hfLM 0 (by norm_num), hdomLM⟩
  · exact ⟨hfLM 1 (by norm_num), hdomLM⟩
  · exact ⟨hfLM 2 (by norm_num), hdomLM⟩
  · exact ⟨hfLM 3 (by norm_num), hdomLM⟩

theorem hframesM (dt : ℝ) : ∀ P ∈ leftProgsM dt, FramesMv P mvM := by
  intro P hP
  simp only [leftProgsM, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgM dt d.2.2 mvM (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

