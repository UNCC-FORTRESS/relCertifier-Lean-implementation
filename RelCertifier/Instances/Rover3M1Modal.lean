theorem fRP0_eval (q : ℕ) (hq : q < 3) (x : State (Var 2)) :
    Term.eval (fRP q 0) x = x (Rv 1) := by
  interval_cases q <;>
    · simp [fRP, hostDyn, mRP, rover3_M1_IR, vsP, Run.dynOf,
      Run.lowerE, hp04, hp02, hp0, hp1, Run.resolveVar,
      List.findIdx?_cons, List.finRange, ITerm.toHost, Term.eval, AOp.interp, Rv]
      try ring

theorem fRP1_eval (q : ℕ) (hq : q < 3) (x : State (Var 2)) :
    Term.eval (fRP q 1) x = cstP q := by
  interval_cases q <;>
