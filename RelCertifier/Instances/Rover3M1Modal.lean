open DL DLCalTiming DLRel Parse Set

set_option maxHeartbeats 12800000

def vsP : List String := ["px", "vx"]
def dummyP : Parse.PMode := ⟨"", [], .tt, .tt, []⟩
def mLP (l : ℕ) : Parse.PMode := rover3_M1_IR.L.modes.getD l dummyP
def mRP (q : ℕ) : Parse.PMode := rover3_M1_IR.R.modes.getD q dummyP

abbrev mvP : Var 2 := (Side.Aux, 0)
abbrev aP : Fin 2 := (1 : Fin 2)
abbrev tgP : Var 2 := (Side.Aux, aP)

noncomputable def fLP (l : ℕ) : Fin 2 → Term (Var 2) := hostDyn vsP 2 Side.L (mLP l)
noncomputable def fRP (q : ℕ) : Fin 2 → Term (Var 2) := hostDyn vsP 2 Side.R (mRP q)
noncomputable def domLP : Formula (Var 2) := hostEvolve vsP 2 Side.L (mLP 0)
noncomputable def domRP : Formula (Var 2) := hostEvolve vsP 2 Side.R (mRP 0)
noncomputable def envP : Formula (Var 2) := Formula.and domLP domRP

def atomsOf : Parse.PForm → List Parse.PForm
  | .and x y => atomsOf x ++ atomsOf y
  | f => [f]

def invPPF : Parse.PForm :=
  (rover3_M1_IR.invariants.getD 2 ("", Parse.PForm.tt)).2

noncomputable def gAt (i : ℕ) : Term (Var 2) :=
  ((Run.invToG vsP 2 ((atomsOf invPPF).getD i .tt)).map ITerm.toHost).getD (Term.const 0)

noncomputable def gP : Term (Var 2) := gAt 0
noncomputable def gsP : List (Term (Var 2)) := []

/-! ## Side-splits -/

theorem fLP_pipe (l : ℕ) (i : Fin 2) : fLP l i =
    (((some (mLP l)).bind (Run.dynOf vsP 2 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRP_pipe (q : ℕ) (i : Fin 2) : fRP q i =
    (((some (mRP q)).bind (Run.dynOf vsP 2 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLP_pipe : domLP =
    (((some (mLP 0)).bind (fun m => Run.lowerF vsP 2 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRP_pipe : domRP =
    (((some (mRP 0)).bind (fun m => Run.lowerF vsP 2 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLP (l : ℕ) (hl : l < 3) : ∀ i, (fLP l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsP) (some (mLP l))
    (by interval_cases l <;>
      simp [mLP, rover3_M1_IR, Parse.PExpr.namesFree]) i x
    (fLP_pipe l i ▸ hx))

theorem hfRP (q : ℕ) (hq : q < 3) : ∀ i, (fRP q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsP) (some (mRP q))
    (by interval_cases q <;>
      simp [mRP, rover3_M1_IR, Parse.PExpr.namesFree]) i x
    (fRP_pipe q i ▸ hx))

theorem hdomLP : domLP.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsP) (some (mLP 0))
    (by simp [mLP, rover3_M1_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLP_pipe ▸ hx))

theorem hdomRP : domRP.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsP) (some (mRP 0))
    (by simp [mRP, rover3_M1_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRP_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gP :: gsP, mvP ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gP, gsP, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gP :: gsP, tgP ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gP, gsP, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFP : mvP ∉ (FM gP gsP).fv := notMem_FM_fv hmvg
theorem htgFP : tgP ∉ (FM gP gsP).fv := notMem_FM_fv htgg

theorem hmvenvP : mvP ∉ envP.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLP h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRP h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))
theorem htgenvP : tgP ∉ envP.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLP h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRP h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

/-! ## The right graph (one-way chain) -/

noncomputable def modeP (q : ℕ) : RMode (Var 2) :=
  { sys := rightBlock (fRP q) (Term.const 1), dom := domRP, weight := 1 }

def edgeP (st tgt : ℕ) : REdge (Var 2) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrP : SearchGraph (Var 2) :=
  { modes := [modeP 0, modeP 1, modeP 2],
    edges := [edgeP 0 1, edgeP 0 0, edgeP 1 2, edgeP 1 1, edgeP 2 2] }

theorem GrP_modeAt (q : ℕ) (hq : q < 3) : GrP.modeAt q = some (modeP q) := by
  interval_cases q <;> rfl

theorem httP : ∀ q, ∀ e ∈ GrP.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrP.edges := List.mem_of_mem_filter he
  simp only [GrP, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltP : ∀ q, ∀ e ∈ GrP.edgesFrom q, e.tgt < GrP.modes.length := by
  intro q e he
  have hmem : e ∈ GrP.edges := List.mem_of_mem_filter he
  simp only [GrP, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrP, edgeP]

theorem hRvP : ∀ q m, GrP.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeP q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrP] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrP] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrP] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrP])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRP q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRP q) (Term.const 1) (hfRP q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRP hy

theorem edgeP_mem : ∀ st tgt, edgeP st tgt ∈ GrP.edges →
    edgeP st tgt ∈ GrP.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeP]⟩

theorem hfreshP : ∀ q m, GrP.modeAt q = some m →
    mvP ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvP q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataP : List ((Fin 2 → Term (Var 2)) × Formula (Var 2) × ℕ) :=
  [(fLP 0, domLP, 2), (fLP 1, domLP, 2), (fLP 2, domLP, 2)]

noncomputable def leftProgsP (dt : ℝ) : List (Program (Var 2)) :=
  leftDataP.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgP dt d.2.2)

theorem hLP : ∀ d ∈ leftDataP, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataP, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLP 0 (by norm_num), hdomLP⟩
  · exact ⟨hfLP 1 (by norm_num), hdomLP⟩
  · exact ⟨hfLP 2 (by norm_num), hdomLP⟩

theorem hframesP (dt : ℝ) : ∀ P ∈ leftProgsP dt, FramesMv P mvP := by
  intro P hP
  simp only [leftProgsP, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgP dt d.2.2 mvP (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

