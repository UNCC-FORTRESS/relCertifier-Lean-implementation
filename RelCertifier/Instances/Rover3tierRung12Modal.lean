      (Formula.and (FM gQC gsQC) envQ)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLQ 1) domLQ (FM gQC gsQC) envQ
    aQ dt 4 htgFQC htgenvQ [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLQ 1 (by norm_num)) hdomLQ
    (List.replicate 4 (Program.ode (rightBlock (fRQ m) (Term.const 1)) domRQ))
    (by simp) (by norm_num)
    (by
      intro Qp hQp
      rw [List.eq_of_mem_replicate hQp, Program.rename_refl]
      exact hdisH_progR (⟨fRQ m, Term.const 1, domRQ⟩ : RepoHop 3)
        (hfRQ m hm) (by simp [Term.fv]) hdomRQ (hfLQ 1 (by norm_num)) hdomLQ)
    (by
      intro Qp hQp σ' hσ'
      rw [List.eq_of_mem_replicate hQp]
      exact couple1QC m hm dt hdt hv σ' hσ')
    hσ
  simpa using hfa

theorem HmultiQC (dt : ℝ) (hdt : 0 ≤ dt) (hv0 : VerdQC 0) (hv1 : VerdQC 1) :
    ∀ P ∈ leftProgsQC dt, ∀ (q : ℕ), q < GrQ.modes.length → ∀ σ, σ mvQ = (q : ℝ) →
      Formula.sat (Formula.and (FM gQC gsQC) envQ) σ →
      ∃ segs : List (ℕ × RMode (Var 3) × REdge (Var 3)),
        (∀ s ∈ segs, GrQ.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrQ.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 3)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gQC gsQC) envQ)) σ := by
  intro P hP q hq σ hmv hσ
  have hq2 : q < 2 := by simpa [GrQ] using hq
  have hhead1 : ∀ (a : ℕ × RMode (Var 3) × REdge (Var 3)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  have hchainrep : ∀ (a : ℕ × RMode (Var 3) × REdge (Var 3)) (k : ℕ), a.2.2.tgt = a.1 →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (List.replicate k a) := by
    intro a k ha
    induction k with
    | zero => simp
    | succ n ih =>
        cases n with
        | zero => simp
        | succ n2 =>
            rw [List.replicate_succ]
            refine ih.cons ?_
            intro y hy
            rw [List.replicate_succ, List.head?_cons, Option.mem_some_iff] at hy
            subst hy
            exact ha
  simp only [leftProgsQC, leftDataQC, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  subst hP
  interval_cases q
  · refine ⟨List.replicate 4 (0, modeQ 0, edgeQ 0 0), ?_, ?_, ?_, ?_⟩
    · intro s hs
      rw [List.eq_of_mem_replicate hs]
      exact ⟨GrQ_modeAt 0 (by norm_num), edgeQ_mem 0 0 (by simp [GrQ])⟩
    · exact hchainrep _ _ rfl
    · intro s hs
      simp only [List.replicate, List.head?_cons, Option.some_inj] at hs
      rw [← hs]
    · have := respondQC 0 (by norm_num) dt hdt hv0 hσ
      simpa [modeQ, List.replicate] using this
  · refine ⟨List.replicate 4 (1, modeQ 1, edgeQ 1 1), ?_, ?_, ?_, ?_⟩
    · intro s hs
      rw [List.eq_of_mem_replicate hs]
      exact ⟨GrQ_modeAt 1 (by norm_num), edgeQ_mem 1 1 (by simp [GrQ])⟩
    · exact hchainrep _ _ rfl
    · intro s hs
      simp only [List.replicate, List.head?_cons, Option.some_inj] at hs
      rw [← hs]
    · have := respondQC 1 (by norm_num) dt hdt hv1 hσ
      simpa [modeQ, List.replicate] using this

/-- **`rover3tier_rung12`, modal Theorem 3 for the COAST window family** —
per-left-mode form: the left is restricted to COAST windows and the loop
invariant is COAST's own declared row. The cross-mode invariant handoff at
left switches is NOT claimed (that needs a left-mode-indexed invariant
device); each mode's within-residence claim is fully certified. -/
theorem rover3tier_rung12_modal_COAST (dt : ℝ) (hdt : 0 ≤ dt)
    (hv0 : VerdQC 0) (hv1 : VerdQC 1) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsQC dt))
      (rightAutomatonBody GrQ mvQ)
      (RFormula.and (RFormula.and (canonInvM gQC gsQC) (envLR domLQ domRQ))
        (mvValidR mvQ GrQ.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrQ mvQ (FM gQC gsQC) domLQ domRQ
    (leftProgsQC dt) (canonInvM gQC gsQC) (encode_canonInvM gQC gsQC) ?_ ?_ ?_
  · exact hdis_multi GrQ 0 1 dt leftDataQC (by decide) httQ hRvQ hLQC
  · exact hstep_assembled_multiF GrQ mvQ (FM gQC gsQC) envQ (leftProgsQC dt)
      hmvFQC hmvenvQ hfreshQ httQ hltQ (hframesQC dt)
      (HmultiQC dt hdt hv0 hv1)
  · exact hddF_multiE GrQ 0 1 dt leftDataQC (canonInvM gQC gsQC) domLQ domRQ
      (by decide) httQ hRvQ hLQC
      (canonInvM_varsL gQC gsQC (by
        intro g' hg'
        simp only [gQC, gsQC, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl <;> exact hgAtC _))
      (canonInvM_varsR gQC gsQC) hdomLQ hdomRQ

end Rover3tierRung12Modal
