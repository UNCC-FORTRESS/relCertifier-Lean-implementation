/-! ## The right graph (one-way chain) -/

noncomputable def modeQ (q : ℕ) : RMode (Var 3) :=
  { sys := rightBlock (fRQ q) (Term.const 1), dom := domRQ, weight := 1 }

def edgeQ (st tgt : ℕ) : REdge (Var 3) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrQ : SearchGraph (Var 3) :=
  { modes := [modeQ 0, modeQ 1],
    edges := [edgeQ 0 1, edgeQ 0 0, edgeQ 1 0, edgeQ 1 1] }

theorem GrQ_modeAt (q : ℕ) (hq : q < 2) : GrQ.modeAt q = some (modeQ q) := by
  interval_cases q <;> rfl

theorem httQ : ∀ q, ∀ e ∈ GrQ.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrQ.edges := List.mem_of_mem_filter he
  simp only [GrQ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl <;> rfl

theorem hltQ : ∀ q, ∀ e ∈ GrQ.edgesFrom q, e.tgt < GrQ.modes.length := by
  intro q e he
  have hmem : e ∈ GrQ.edges := List.mem_of_mem_filter he
  simp only [GrQ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl <;> norm_num [GrQ, edgeQ]

theorem hRvQ : ∀ q m, GrQ.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 2 ∧ m = modeQ q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrQ] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrQ] using hm.symm⟩
    | q + 2 => exact absurd hm (by simp [SearchGraph.modeAt, GrQ])
  obtain ⟨hq2, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRQ q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRQ q) (Term.const 1) (hfRQ q hq2)
      (by simp [Term.fv]) hy
  · exact hdomRQ hy

theorem edgeQ_mem : ∀ st tgt, edgeQ st tgt ∈ GrQ.edges →
    edgeQ st tgt ∈ GrQ.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeQ]⟩

theorem hfreshQ : ∀ q m, GrQ.modeAt q = some m →
    mvQ ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvQ q m hm (vars_ode_sub _ _ (Or.inl hmv)))

