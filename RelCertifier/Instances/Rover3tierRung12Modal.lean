theorem esQ (lam : ℝ) (hlam : 0 < lam) (l m : ℕ) (hl : l < 2) (hm : m < 2)
    (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat domRQ σ →
      HExistSegB (fLQ l) (fRQ m) (Term.const lam) domLQ domRQ dt
        (Function.update σ tgQ 0) := by
  intro σ hR
  rw [sat_domRQ] at hR
  obtain ⟨hd2l, hd2h, hd1l, hd0l⟩ := hR
  intro s ΦL hs0 hsdt hΦL0 hderL hmaskL hdomL
  set μ : State (Var 3) := ΦL s with hμ
  have hμcoin : ∀ j : Fin 3, μ (Rv j) = Function.update σ tgQ 0 (Rv j) := by
    intro j
    refine hmaskL s (right_mem_Icc.mpr hs0) (Rv j) ?_
    intro hb
    obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLQ l) _ hb
    exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])
  have hupd : ∀ j : Fin 3, Function.update σ tgQ 0 (Rv j) = σ (Rv j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgQ, Prod.ext_iff])]
  have ha0 : (1:ℝ)/2 ≤ μ (Rv 2) := by rw [hμcoin 2, hupd 2]; exact hd2l
  have ha0h : μ (Rv 2) ≤ 1 := by rw [hμcoin 2, hupd 2]; exact hd2h
  have hv0 : (0:ℝ) ≤ μ (Rv 0) := by rw [hμcoin 0, hupd 0]; exact hd0l
  have hs0' : (0:ℝ) ≤ μ (Rv 1) := by rw [hμcoin 1, hupd 1]; exact hd1l
  classical
  refine ⟨fun t x => if x = Rv 1 then
      μ (Rv 1) + lam * μ (Rv 0) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
    else if x = Rv 0 then μ (Rv 0) + lam * μ (Rv 2) * t
    else μ x, ?_, ?_, ?_, ?_⟩
  · funext x
    by_cases h0 : x = Rv 1
    · subst h0; simp
    · by_cases h1 : x = Rv 0
      · subst h1
        simp [if_neg (show (Rv 0 : Var 3) ≠ Rv 1 by simp [Rv, Prod.ext_iff])]
      · simp [if_neg h0, if_neg h1]
  · intro t ht p hp
    simp only [rightBlock, List.mem_map, List.mem_finRange] at hp
    obtain ⟨i, -, rfl⟩ := hp
    have hne10 : (Rv 0 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    have hne20 : (Rv 2 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    have hne21 : (Rv 2 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    fin_cases i
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRQ m ⟨0, by norm_num⟩))
          (fun x => if x = Rv 1 then
              μ (Rv 1) + lam * μ (Rv 0) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 0 then μ (Rv 0) + lam * μ (Rv 2) * t
            else μ x)
          = lam * μ (Rv 2) := by
        simp [Term.eval, AOp.interp, show fRQ m ⟨0, by norm_num⟩ = fRQ m 0 from rfl,
          fRQ0_eval m hm, if_neg hne20, if_neg hne21, hlam]
      simp only [heval]
      have h2 : HasDerivWithinAt (fun u : ℝ => μ (Rv 0) + lam * μ (Rv 2) * u)
          (lam * μ (Rv 2) * 1) (Set.Icc 0 s) t :=
        ((hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).const_mul
          (lam * μ (Rv 2))).const_add (μ (Rv 0))
      have heqd : lam * μ (Rv 2) * 1 = lam * μ (Rv 2) := by ring
      rw [heqd] at h2
      refine HasDerivWithinAt.congr h2 ?_ ?_
      · intro y _
        simp [if_neg hne10]
      · simp [if_neg hne10]
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRQ m ⟨1, by norm_num⟩))
          (fun x => if x = Rv 1 then
              μ (Rv 1) + lam * μ (Rv 0) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 0 then μ (Rv 0) + lam * μ (Rv 2) * t
            else μ x)
          = lam * (μ (Rv 0) + lam * μ (Rv 2) * t) := by
        simp [Term.eval, AOp.interp, show fRQ m ⟨1, by norm_num⟩ = fRQ m 1 from rfl,
          fRQ1_eval m hm, if_neg hne10, hlam]
      simp only [heval]
      have h2 : HasDerivWithinAt (fun u : ℝ => μ (Rv 1) + lam * μ (Rv 0) * u)
          (lam * μ (Rv 0) * 1) (Set.Icc 0 s) t :=
        ((hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).const_mul
          (lam * μ (Rv 0))).const_add (μ (Rv 1))
      have hp2 : HasDerivWithinAt (fun u : ℝ => u * u) (1 * t + t * 1)
          (Set.Icc 0 s) t :=
        (hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).mul
          (hasDerivWithinAt_id t (Set.Icc (0:ℝ) s))
      have h3 := hp2.const_mul (lam ^ 2 * μ (Rv 2) / 2)
      have hsum := h2.add h3
      have heqd : lam * μ (Rv 0) * 1 + lam ^ 2 * μ (Rv 2) / 2 * (1 * t + t * 1)
          = lam * (μ (Rv 0) + lam * μ (Rv 2) * t) := by ring
      rw [heqd] at hsum
      refine HasDerivWithinAt.congr hsum ?_ ?_
      · intro y _
        simp [Pi.add_apply]
      · simp [Pi.add_apply]
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRQ m ⟨2, by norm_num⟩))
          (fun x => if x = Rv 1 then
              μ (Rv 1) + lam * μ (Rv 0) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 0 then μ (Rv 0) + lam * μ (Rv 2) * t
            else μ x)
          = 0 := by
        simp [Term.eval, AOp.interp, show fRQ m ⟨2, by norm_num⟩ = fRQ m 2 from rfl,
          fRQ2_eval m hm]
      simp only [heval]
      refine HasDerivWithinAt.congr
        (hasDerivWithinAt_const t (Set.Icc (0:ℝ) s) (μ (Rv 2))) ?_ ?_
      · intro y _
        simp [if_neg hne20, if_neg hne21]
      · simp [if_neg hne20, if_neg hne21]
  · intro t ht x hx
    have hx0 : x ≠ Rv 1 := by
      intro h; subst h
      exact hx (by
        simp only [rightBlock, ODESystem.bound, List.map_map, List.mem_map]
        exact ⟨1, List.mem_finRange 1, rfl⟩)
    have hx1 : x ≠ Rv 0 := by
      intro h; subst h
      exact hx (by
        simp only [rightBlock, ODESystem.bound, List.map_map, List.mem_map]
        exact ⟨0, List.mem_finRange 0, rfl⟩)
    simp [if_neg hx0, if_neg hx1]
  · intro t ht
    rw [sat_domRQ]
    have ht0 : (0:ℝ) ≤ t := ht.1
    have hne10 : (Rv 0 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    have hne20 : (Rv 2 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    have hne21 : (Rv 2 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [if_neg hne20, if_neg hne21]
      exact ha0
    · simp only [if_neg hne20, if_neg hne21]
      exact ha0h
    · simp only [eq_self_iff_true, if_true, if_pos rfl]
      have hlpos : (0:ℝ) < lam := hlam
      have hq1 : 0 ≤ lam * μ (Rv 0) * t :=
        mul_nonneg (mul_nonneg hlpos.le (by linarith)) ht0
      have hq2 : 0 ≤ lam ^ 2 * μ (Rv 2) / 2 * (t * t) :=
        mul_nonneg (div_nonneg (mul_nonneg (sq_nonneg _) (by linarith)) (by norm_num)) (mul_self_nonneg t)
      exact add_nonneg (add_nonneg hs0' hq1) hq2
    · simp only [if_neg hne10, eq_self_iff_true, if_true, if_pos rfl]
      have hlpos : (0:ℝ) < lam := hlam
      have h4 : 0 ≤ lam * μ (Rv 2) * t :=
        mul_nonneg (mul_nonneg hlpos.le (by linarith)) ht0
      have h4 : 0 ≤ lam * μ (Rv 2) * t :=
        mul_nonneg (mul_nonneg hlam.le (by linarith)) ht0
      linarith [hv0, h4]



/-! ## The ACCEL invariant: verdicts, coupling, response -/

def VerdQA (m : ℕ) : Prop :=
  ∀ i (hi : i < (gQ :: gsQ).length),
    z3solve (flowQuery ⟨(gQ :: gsQ)[i], fLQ 0, fRQ m, Term.const (2),
      strataDomHost (Formula.and domLQ domRQ) ((gQ :: gsQ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gQ :: gsQ)[i], fLQ 0, fRQ m, Term.const (2),
      strataDomHost (Formula.and domLQ domRQ) ((gQ :: gsQ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gQ :: gsQ)[i], fLQ 0, fRQ m, Term.const (2),
      strataDomHost (Formula.and domLQ domRQ) ((gQ :: gsQ).take i)⟩) = Verdict.unsat

theorem coupleQA (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdQA m) :
    ∀ σ', Formula.sat (Formula.and (FM gQ gsQ) envQ) σ' → σ' tgQ = 0 →
      faModalB (Equiv.refl (Var 3))
        (Program.ode (DLCalTiming.clk tgQ (leftBlock (fLQ 0))) domLQ)
        (Program.ode (rightBlock (fRQ m) (Term.const (2))) domRQ)
        (Formula.and (FM gQ gsQ) envQ) tgQ dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgQ (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgQ
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLQ 0) (fRQ m) (Term.const (2))
    (Formula.and domLQ domRQ) (gQ :: gsQ) hv
  have hboxes : ∀ g' ∈ gQ :: gsQ, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLQ 0) ++ rightBlock (fRQ m) (Term.const (2)))
      (Formula.and domLQ domRQ)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gQ gsQ σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gQ gsQ (fLQ 0) (fRQ m)
    (Term.const (2)) domLQ domRQ tgQ dt
    (LR_blocks_disjoint _ _ _ (hfLQ 0 (by norm_num)) (hfRQ m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLQ hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRQ hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLQ 0) _ h
      exact aux_ne_Lv aQ i hi)
    (fun h => aux_notin_range_Lv aQ (leftBlock_readVars_sub (fLQ 0)
      (hfLQ 0 (by norm_num)) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRQ m) (Term.const (2)) _ h
      exact aux_ne_Rv aQ i hi)
    (fun h => aux_notin_range_Rv aQ (rightBlock_readVars_sub (fRQ m)
      (Term.const (2)) (hfRQ m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aQ (rightBlock_boundSet_sub (fRQ m) (Term.const (2)) h))
    (fun h => aux_notin_range_Lv aQ (hdomLQ h))
    (fun h => aux_notin_range_Rv aQ (hdomRQ h))
    htgg hboxes
    (esQ (2) (by norm_num) 0 m (by norm_num) hm dt hdt σ' hσ'.2.2)
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLQ ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRQ μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLQ μ := by
    rwa [(Formula.coincidence domLQ (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLQ hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRQ m) (Term.const (2)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLQ μ ↔ Formula.sat domLQ ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1QA (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt) (hv : VerdQA m) :
    ∀ σ, Formula.sat (Formula.and (FM gQ gsQ) envQ) σ →
      faModalB (Equiv.refl (Var 3))
        (Program.ode (DLCalTiming.clk tgQ (leftBlock (fLQ 0))) domLQ)
        (Program.ode (rightBlock (fRQ m) (Term.const 1)) domRQ)
        (Formula.and (FM gQ gsQ) envQ) tgQ dt
        (Function.update σ tgQ 0) := by
  intro σ hσ
  have htgφ : tgQ ∉ (Formula.and (FM gQ gsQ) envQ).fv := by
    intro h
    rcases h with h | h
    · exact htgFQ h
    · exact htgenvQ h
  have hupdφ : Formula.sat (Formula.and (FM gQ gsQ) envQ)
      (Function.update σ tgQ 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gQ gsQ) envQ) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gQ gsQ) envQ) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleQA m hm dt hdt hv
    (Function.update σ tgQ 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (2) 1 (by norm_num) one_pos hsem

theorem respondQA (m : ℕ) (hm : m < 2) (dt : ℝ) (hdt : 0 ≤ dt)
