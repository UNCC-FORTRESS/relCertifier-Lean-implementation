def vsC : List String := ["v", "s", "psi", "omega_psi", "theta_p", "omega_theta", "phi_r", "omega_phi", "z", "y", "e_lat", "omega_y"]
def dummyC : Parse.PMode := ⟨"", [], .tt, .tt, []⟩
def mLC (l : ℕ) : Parse.PMode := rover_attitude_cone_12dof_IR.L.modes.getD l dummyC
def mRC (q : ℕ) : Parse.PMode := rover_attitude_cone_12dof_IR.R.modes.getD q dummyC

abbrev mvC : Var 12 := (Side.Aux, 0)
abbrev aC : Fin 12 := (1 : Fin 12)
abbrev tgC : Var 12 := (Side.Aux, aC)

noncomputable def fLC (l : ℕ) : Fin 12 → Term (Var 12) := hostDyn vsC 12 Side.L (mLC l)
noncomputable def fRC (q : ℕ) : Fin 12 → Term (Var 12) := hostDyn vsC 12 Side.R (mRC q)
noncomputable def domLC : Formula (Var 12) := hostEvolve vsC 12 Side.L (mLC 0)
noncomputable def domRC : Formula (Var 12) := hostEvolve vsC 12 Side.R (mRC 0)
noncomputable def envC : Formula (Var 12) := Formula.and domLC domRC

def atomsOf : Parse.PForm → List Parse.PForm
  | .and x y => atomsOf x ++ atomsOf y
  | f => [f]

def invCPF : Parse.PForm :=
  (rover_attitude_cone_12dof_IR.invariants.getD 0 ("", Parse.PForm.tt)).2

noncomputable def gAt (i : ℕ) : Term (Var 12) :=
  ((Run.invToG vsC 12 ((atomsOf invCPF).getD i .tt)).map ITerm.toHost).getD (Term.const 0)

noncomputable def gC : Term (Var 12) := gAt 0
noncomputable def gsC : List (Term (Var 12)) := [gAt 1, gAt 2, gAt 3]

/-! ## Side-splits -/

theorem fLC_pipe (l : ℕ) (i : Fin 12) : fLC l i =
    (((some (mLC l)).bind (Run.dynOf vsC 12 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRC_pipe (q : ℕ) (i : Fin 12) : fRC q i =
    (((some (mRC q)).bind (Run.dynOf vsC 12 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLC_pipe : domLC =
    (((some (mLC 0)).bind (fun m => Run.lowerF vsC 12 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRC_pipe : domRC =
    (((some (mRC 0)).bind (fun m => Run.lowerF vsC 12 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLC (l : ℕ) (hl : l < 3) : ∀ i, (fLC l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsC) (some (mLC l))
    (by interval_cases l <;>
      simp [mLC, rover_attitude_cone_12dof_IR, Parse.PExpr.namesFree]) i x
    (fLC_pipe l i ▸ hx))

theorem hfRC (q : ℕ) (hq : q < 3) : ∀ i, (fRC q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsC) (some (mRC q))
    (by interval_cases q <;>
      simp [mRC, rover_attitude_cone_12dof_IR, Parse.PExpr.namesFree]) i x
    (fRC_pipe q i ▸ hx))

theorem hdomLC : domLC.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsC) (some (mLC 0))
    (by simp [mLC, rover_attitude_cone_12dof_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLC_pipe ▸ hx))

theorem hdomRC : domRC.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsC) (some (mRC 0))
    (by simp [mRC, rover_attitude_cone_12dof_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRC_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gC :: gsC, mvC ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gC, gsC, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl | rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gC :: gsC, tgC ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gC, gsC, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl | rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFC : mvC ∉ (FM gC gsC).fv := notMem_FM_fv hmvg
theorem htgFC : tgC ∉ (FM gC gsC).fv := notMem_FM_fv htgg

theorem hmvenvC : mvC ∉ envC.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLC h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRC h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))
theorem htgenvC : tgC ∉ envC.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLC h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRC h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

/-! ## The right graph (one-way chain) -/

noncomputable def modeC (q : ℕ) : RMode (Var 12) :=
  { sys := rightBlock (fRC q) (Term.const 1), dom := domRC, weight := 1 }

def edgeC (st tgt : ℕ) : REdge (Var 12) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrC : SearchGraph (Var 12) :=
  { modes := [modeC 0, modeC 1, modeC 2],
    edges := [edgeC 0 1, edgeC 0 0, edgeC 1 2, edgeC 1 1, edgeC 2 2] }

theorem GrC_modeAt (q : ℕ) (hq : q < 3) : GrC.modeAt q = some (modeC q) := by
  interval_cases q <;> rfl

theorem httC : ∀ q, ∀ e ∈ GrC.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrC.edges := List.mem_of_mem_filter he
  simp only [GrC, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltC : ∀ q, ∀ e ∈ GrC.edgesFrom q, e.tgt < GrC.modes.length := by
  intro q e he
  have hmem : e ∈ GrC.edges := List.mem_of_mem_filter he
  simp only [GrC, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrC, edgeC]

theorem hRvC : ∀ q m, GrC.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeC q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrC] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrC] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrC] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrC])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRC q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRC q) (Term.const 1) (hfRC q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRC hy

theorem edgeC_mem : ∀ st tgt, edgeC st tgt ∈ GrC.edges →
    edgeC st tgt ∈ GrC.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeC]⟩

theorem hfreshC : ∀ q m, GrC.modeAt q = some m →
    mvC ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvC q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataC : List ((Fin 12 → Term (Var 12)) × Formula (Var 12) × ℕ) :=
  [(fLC 0, domLC, 2), (fLC 1, domLC, 2), (fLC 2, domLC, 2)]

noncomputable def leftProgsC (dt : ℝ) : List (Program (Var 12)) :=
  leftDataC.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgC dt d.2.2)

theorem hLC : ∀ d ∈ leftDataC, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataC, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLC 0 (by norm_num), hdomLC⟩
  · exact ⟨hfLC 1 (by norm_num), hdomLC⟩
  · exact ⟨hfLC 2 (by norm_num), hdomLC⟩

theorem hframesC (dt : ℝ) : ∀ P ∈ leftProgsC dt, FramesMv P mvC := by
  intro P hP
  simp only [leftProgsC, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgC dt d.2.2 mvC (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

