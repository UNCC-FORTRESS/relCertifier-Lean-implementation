/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdC (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gC :: gsC).length),
    z3solve (flowQuery ⟨(gC :: gsC)[i], fLC l, fRC m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLC domRC) ((gC :: gsC).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gC :: gsC)[i], fLC l, fRC m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLC domRC) ((gC :: gsC).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gC :: gsC)[i], fLC l, fRC m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLC domRC) ((gC :: gsC).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleC (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdC l m) :
    ∀ σ', Formula.sat (Formula.and (FM gC gsC) envC) σ' → σ' tgC = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgC (leftBlock (fLC l))) domLC)
        (Program.ode (rightBlock (fRC m) (Term.const ((17:ℝ)/10))) domRC)
        (Formula.and (FM gC gsC) envC) tgC dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgC (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgC
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLC l) (fRC m) (Term.const ((17:ℝ)/10))
    (Formula.and domLC domRC) (gC :: gsC) hv
  have hboxes : ∀ g' ∈ gC :: gsC, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLC l) ++ rightBlock (fRC m) (Term.const ((17:ℝ)/10)))
      (Formula.and domLC domRC)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gC gsC σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gC gsC (fLC l) (fRC m)
    (Term.const ((17:ℝ)/10)) domLC domRC tgC dt
    (LR_blocks_disjoint _ _ _ (hfLC l hl) (hfRC m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLC hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRC hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLC l) _ h
      exact aux_ne_Lv aC i hi)
    (fun h => aux_notin_range_Lv aC (leftBlock_readVars_sub (fLC l) (hfLC l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRC m) (Term.const ((17:ℝ)/10)) _ h
      exact aux_ne_Rv aC i hi)
    (fun h => aux_notin_range_Rv aC (rightBlock_readVars_sub (fRC m)
      (Term.const ((17:ℝ)/10)) (hfRC m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aC (rightBlock_boundSet_sub (fRC m)
      (Term.const ((17:ℝ)/10)) h))
    (fun h => aux_notin_range_Lv aC (hdomLC h))
    (fun h => aux_notin_range_Rv aC (hdomRC h))
    htgg hboxes
    (esC l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLC ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRC μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLC μ := by
    rwa [(Formula.coincidence domLC (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLC hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRC m) (Term.const ((17:ℝ)/10)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLC μ ↔ Formula.sat domLC ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1C (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdC l m) :
    ∀ σ, Formula.sat (Formula.and (FM gC gsC) envC) σ →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgC (leftBlock (fLC l))) domLC)
        (Program.ode (rightBlock (fRC m) (Term.const 1)) domRC) (Formula.and (FM gC gsC) envC) tgC dt
        (Function.update σ tgC 0) := by
  intro σ hσ
  have htgφ : tgC ∉ (Formula.and (FM gC gsC) envC).fv := by
    intro h
    rcases h with h | h
    · exact htgFC h
    · exact htgenvC h
  have hupdφ : Formula.sat (Formula.and (FM gC gsC) envC)
      (Function.update σ tgC 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gC gsC) envC) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gC gsC) envC) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleC l m hl hm dt hdt hv
    (Function.update σ tgC 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam ((17:ℝ)/10) 1 (by norm_num) one_pos hsem

/-! ## The window response (2 pieces at the in-place mode) -/

theorem respondC (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdC l m) {σ : State (Var 12)}
    (hσ : Formula.sat (Formula.and (FM gC gsC) envC) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLC l)) domLC tgC dt 2)
      (bigSeq [Program.ode (rightBlock (fRC m) (Term.const 1)) domRC,
        Program.ode (rightBlock (fRC m) (Term.const 1)) domRC])
      (Formula.and (FM gC gsC) envC)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLC l) domLC (FM gC gsC) envC
    aC dt 2 htgFC htgenvC [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLC l hl) hdomLC
    (List.replicate 2 (Program.ode (rightBlock (fRC m) (Term.const 1)) domRC)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRC m, Term.const 1, domRC⟩ : RepoHop 12)
        (hfRC m hm) (by simp [Term.fv]) hdomRC (hfLC l hl) hdomLC)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1C l m hl hm dt hdt hv σ' hσ')
    hσ
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiC (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : ∀ l m : ℕ, l < 3 → m < 3 → VerdC l m) :
    ∀ P ∈ leftProgsC dt, ∀ (q : ℕ), q < GrC.modes.length → ∀ σ, σ mvC = (q : ℝ) →
      Formula.sat (Formula.and (FM gC gsC) envC) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrC.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrC.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gC gsC) envC)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrC] using hq
  have hself : GrC.modeAt q = some (modeC q) ∧ edgeC q q ∈ GrC.edgesFrom q := by
    refine ⟨GrC_modeAt q hq3, edgeC_mem q q ?_⟩
    interval_cases q <;> simp [GrC]
  have hstep : ∀ (a b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsC, leftDataC, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  refine ⟨[(q, modeC q, edgeC q q), (q, modeC q, edgeC q q)], ?_, ?_, ?_, ?_⟩
  · intro s hs
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl <;> exact hself
  · exact (hstep _ _ _ rfl (by simp))
  · exact fun s hs => by rw [hhead1 _ _ _ hs]
  · rcases hP with rfl | rfl | rfl
    · have := respondC 0 q (by norm_num) hq3 dt hdt (hv 0 q (by norm_num) hq3) hσ
      simpa [modeC] using this
    · have := respondC 1 q (by norm_num) hq3 dt hdt (hv 1 q (by norm_num) hq3) hσ
      simpa [modeC] using this
    · have := respondC 2 q (by norm_num) hq3 dt hdt (hv 2 q (by norm_num) hq3) hσ
      simpa [modeC] using this

/-- **`rover_attitude_cone_12dof`, modal Theorem 3** (λ = (17:ℝ)/10, k = 2). -/
theorem rover_attitude_cone_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : ∀ l m : ℕ, l < 3 → m < 3 → VerdC l m) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsC dt))
      (rightAutomatonBody GrC mvC)
      (RFormula.and (RFormula.and (canonInvM gC gsC) (envLR domLC domRC))
        (mvValidR mvC GrC.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrC mvC (FM gC gsC) domLC domRC
    (leftProgsC dt) (canonInvM gC gsC) (encode_canonInvM gC gsC) ?_ ?_ ?_
  · exact hdis_multi GrC 0 1 dt leftDataC (by decide) httC hRvC hLC
  · exact hstep_assembled_multiF GrC mvC (FM gC gsC) envC (leftProgsC dt)
      hmvFC hmvenvC hfreshC httC hltC (hframesC dt)
      (HmultiC dt hdt hv)
  · exact hddF_multiE GrC 0 1 dt leftDataC (canonInvM gC gsC) domLC domRC
      (by decide) httC hRvC hLC
      (canonInvM_varsL gC gsC (by
        intro g' hg'
        simp only [gC, gsC, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl | rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gC gsC) hdomLC hdomRC

