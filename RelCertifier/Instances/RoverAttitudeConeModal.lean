/-! ## The frozen-left joint field -/

theorem odeField_RC (q : ℕ) (hq : q < 3) (x : State (Var 12)) :
    odeField (jointSys (fun _ => Term.const 0) (fRC q) (Term.const ((17:ℝ)/10))) x
      = fun c =>
        if c = Rv 0 then ((17:ℝ)/10) * (3 * (cstC q - x (Rv 0)))
        else if c = Rv 1 then ((17:ℝ)/10) * (x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))))
        else if c = Rv 2 then ((17:ℝ)/10) * (-1 * x (Rv 2))
        else if c = Rv 4 then ((17:ℝ)/10) * (-1 * x (Rv 4))
        else if c = Rv 6 then ((17:ℝ)/10) * (-1 * x (Rv 6))
        else if c = Rv 8 then ((17:ℝ)/10) * (-1 * x (Rv 8))
        else if c = Rv 9 then ((17:ℝ)/10) * (-1 * x (Rv 9))
        else if c = Rv 10 then ((17:ℝ)/10) * (-1 * x (Rv 10))
        else 0 := by
  funext c
  by_cases hc : c ∈ (jointSys (fun _ => Term.const 0) (fRC q) (Term.const ((17:ℝ)/10))).bound
  · rw [show odeField (jointSys (fun _ => Term.const 0) (fRC q) (Term.const ((17:ℝ)/10))) x c
        = ((jointSys (fun _ => Term.const 0) (fRC q) (Term.const ((17:ℝ)/10))).rhs c).eval x from by
      simp only [odeField, if_pos hc]]
    obtain ⟨p, hp, hfst⟩ : ∃ p ∈ jointSys (fun _ => Term.const 0) (fRC q) (Term.const ((17:ℝ)/10)),
        p.1 = c := by simpa [ODESystem.bound, List.mem_map] using hc
    rw [← hfst, ODESystem.rhs_eq_of_mem (jointSys_wellFormed _ _ _) hp]
    rw [jointSys_split] at hp
    have hne : ∀ (a b : Fin 12), a ≠ b → (Rv a : Var 12) ≠ Rv b := by
      intro a b hab
      simp [Rv, Prod.ext_iff]
      exact fun h => hab (by exact_mod_cast h)
    rcases List.mem_append.mp hp with hp | hp
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      have hLR : ∀ k : Fin 12, (Lv j : Var 12) ≠ Rv k := by
        intro k
        simp [Lv, Rv, Prod.ext_iff]
      simp [Term.eval, hLR 0, hLR 1, hLR 2, hLR 4, hLR 6, hLR 8, hLR 9, hLR 10]
    · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hp
      fin_cases j
      · simp [Term.eval, AOp.interp, fRC0_eval q hq]
      · simp [Term.eval, AOp.interp, fRC1_eval q hq,
          hne 1 0 (by decide)]
      · simp [Term.eval, AOp.interp, fRC2_eval q hq,
          hne 2 0 (by decide),
          hne 2 1 (by decide)]
      · simp [Term.eval, AOp.interp, fRC3_eval q hq,
          hne 3 0 (by decide),
          hne 3 1 (by decide),
          hne 3 2 (by decide),
          hne 3 4 (by decide),
          hne 3 6 (by decide),
          hne 3 8 (by decide),
          hne 3 9 (by decide),
          hne 3 10 (by decide)]
      · simp [Term.eval, AOp.interp, fRC4_eval q hq,
          hne 4 0 (by decide),
          hne 4 1 (by decide),
          hne 4 2 (by decide)]
      · simp [Term.eval, AOp.interp, fRC5_eval q hq,
          hne 5 0 (by decide),
          hne 5 1 (by decide),
          hne 5 2 (by decide),
          hne 5 4 (by decide),
          hne 5 6 (by decide),
          hne 5 8 (by decide),
          hne 5 9 (by decide),
          hne 5 10 (by decide)]
      · simp [Term.eval, AOp.interp, fRC6_eval q hq,
          hne 6 0 (by decide),
          hne 6 1 (by decide),
          hne 6 2 (by decide),
          hne 6 4 (by decide)]
      · simp [Term.eval, AOp.interp, fRC7_eval q hq,
          hne 7 0 (by decide),
          hne 7 1 (by decide),
          hne 7 2 (by decide),
          hne 7 4 (by decide),
          hne 7 6 (by decide),
          hne 7 8 (by decide),
          hne 7 9 (by decide),
          hne 7 10 (by decide)]
      · simp [Term.eval, AOp.interp, fRC8_eval q hq,
          hne 8 0 (by decide),
          hne 8 1 (by decide),
          hne 8 2 (by decide),
          hne 8 4 (by decide),
          hne 8 6 (by decide)]
      · simp [Term.eval, AOp.interp, fRC9_eval q hq,
          hne 9 0 (by decide),
          hne 9 1 (by decide),
          hne 9 2 (by decide),
          hne 9 4 (by decide),
          hne 9 6 (by decide),
          hne 9 8 (by decide)]
      · simp [Term.eval, AOp.interp, fRC10_eval q hq,
          hne 10 0 (by decide),
          hne 10 1 (by decide),
          hne 10 2 (by decide),
          hne 10 4 (by decide),
          hne 10 6 (by decide),
          hne 10 8 (by decide),
          hne 10 9 (by decide)]
      · simp [Term.eval, AOp.interp, fRC11_eval q hq,
          hne 11 0 (by decide),
          hne 11 1 (by decide),
          hne 11 2 (by decide),
          hne 11 4 (by decide),
          hne 11 6 (by decide),
          hne 11 8 (by decide),
          hne 11 9 (by decide),
          hne 11 10 (by decide)]
  · have hnotR : ∀ j : Fin 12, c ≠ Rv j := by
      intro j hceq
      refine hc ?_
      rw [hceq, jointSys_split]
      simp only [ODESystem.bound, List.map_append, List.mem_append]
      exact Or.inr (by
        simp only [rightBlock, List.map_map, List.mem_map]
        exact ⟨j, List.mem_finRange j, rfl⟩)
    simp only [odeField, if_neg hc, if_neg (hnotR 0), if_neg (hnotR 1), if_neg (hnotR 2), if_neg (hnotR 4), if_neg (hnotR 6), if_neg (hnotR 8), if_neg (hnotR 9), if_neg (hnotR 10)]

