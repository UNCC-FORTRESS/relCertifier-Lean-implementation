noncomputable def gsVR (m : ℕ) : List (Term (Var 8)) := gR :: gsR

def VerdR (l m : ℕ) : Prop :=
  ∀ i (hi : i < (ceilR m :: gsVR m).length),
    z3solve (flowQuery ⟨(ceilR m :: gsVR m)[i], fLR l, fRR m, Term.const ((9:ℝ)/4),
      strataDomHost (Formula.and domLR domRR) ((ceilR m :: gsVR m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(ceilR m :: gsVR m)[i], fLR l, fRR m, Term.const ((9:ℝ)/4),
      strataDomHost (Formula.and domLR domRR) ((ceilR m :: gsVR m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(ceilR m :: gsVR m)[i], fLR l, fRR m, Term.const ((9:ℝ)/4),
      strataDomHost (Formula.and domLR domRR) ((ceilR m :: gsVR m).take i)⟩) = Verdict.unsat

