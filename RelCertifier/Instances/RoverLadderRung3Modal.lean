theorem hLR : ∀ d ∈ leftDataR, d.1.fv ⊆ range Lv ∧
    (∀ i, (d.2.1 i).fv ⊆ range Lv) ∧ d.2.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataR, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨by simp [Formula.fv], hfLR 0 (by norm_num), hdomLR⟩
  · exact ⟨by simp [Formula.fv], hfLR 1 (by norm_num), hdomLR⟩
  · exact ⟨by simp [Formula.fv], hfLR 2 (by norm_num), hdomLR⟩

theorem hframesR (dt : ℝ) : ∀ P ∈ leftProgsR dt, FramesMv P mvR := by
  intro P hP
  simp only [leftProgsR, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_gwindow d.1 d.2.1 d.2.2.1 tgR dt d.2.2.2 mvR (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.2.1 _ h
  exact aux_ne_Lv 0 i hi

