theorem coupleR (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdR l m) :
    ∀ σ', Formula.sat (Formula.and (FM gR (gs9R m)) envR) σ' → σ' tgR = 0 →
      faModalB (Equiv.refl (Var 8))
        (Program.ode (DLCalTiming.clk tgR (leftBlock (fLR l))) domLR)
        (Program.ode (rightBlock (fRR m) (Term.const ((9:ℝ)/4))) domRR)
        (Formula.and (FM gR (gs9R m)) envR) tgR dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgR (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgR
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLR l) (fRR m) (Term.const ((9:ℝ)/4))
    (Formula.and domLR domRR) (ceilR m :: gsVR m) hv
  have hmemV : ∀ g' ∈ gR :: gs9R m, g' ∈ ceilR m :: gsVR m := by
    intro g' hg'
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact List.mem_cons_of_mem _ List.mem_cons_self
    · rcases List.mem_append.mp hg' with hg' | hg'
      · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hg')
      · rw [List.mem_singleton] at hg'
        subst hg'
        exact List.mem_cons_self
  have hboxes : ∀ g' ∈ gR :: gs9R m, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLR l) ++ rightBlock (fRR m) (Term.const ((9:ℝ)/4)))
      (Formula.and domLR domRR)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' (hmemV g' hg')
    intro g hg
    have hgmem : g ∈ gR :: gs9R m := by
      rcases List.mem_cons.mp hg with rfl | hg
      · exact List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl))
      · rcases List.mem_cons.mp hg with rfl | hg
        · exact List.mem_cons_self
        · exact List.mem_cons_of_mem _ (List.mem_append_left _ hg)
    exact (sat_FM_iff gR (gs9R m) σ').mp hσ'.1 g hgmem
  have hbase := segment_faModalB_from_certB_list gR (gs9R m) (fLR l) (fRR m)
    (Term.const ((9:ℝ)/4)) domLR domRR tgR dt
    (LR_blocks_disjoint _ _ _ (hfLR l hl) (hfRR m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLR hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRR hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLR l) _ h
      exact aux_ne_Lv aR i hi)
    (fun h => aux_notin_range_Lv aR (leftBlock_readVars_sub (fLR l) (hfLR l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRR m) (Term.const ((9:ℝ)/4)) _ h
      exact aux_ne_Rv aR i hi)
    (fun h => aux_notin_range_Rv aR (rightBlock_readVars_sub (fRR m)
      (Term.const ((9:ℝ)/4)) (hfRR m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aR (rightBlock_boundSet_sub (fRR m)
      (Term.const ((9:ℝ)/4)) h))
    (fun h => aux_notin_range_Lv aR (hdomLR h))
    (fun h => aux_notin_range_Rv aR (hdomRR h))
    (htggs9R m) hboxes
    (esR l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLR ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRR μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLR μ := by
    rwa [(Formula.coincidence domLR (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLR hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRR m) (Term.const ((9:ℝ)/4)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLR μ ↔ Formula.sat domLR ν)]
  exact ⟨hdomLμ, hdomRμ⟩

