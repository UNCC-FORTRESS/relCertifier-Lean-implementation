    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRR p)
        (lam := Term.const 1) (domR := domRR) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLR l hl) hdomLR
    (List.replicate 3 (Program.ode (rightBlock (fRR m) (Term.const 1)) domRR))
    (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRR m, Term.const 1, domRR⟩ : RepoHop 8)
        (hfRR m hm) (by simp [Term.fv]) hdomRR (hfLR l hl) hdomLR)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1R l m hl hm dt hdt hv σ' hσ')
    hσE
  rw [show (path.map (fun p => (⟨fRR p, Term.const 1, domRR⟩ : RepoHop 8))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRR p) (Term.const 1)) domRR)
    from by rw [List.map_map]; rfl] at hfa
  have hfa2 : Formula.sat (faModal (Equiv.refl (Var 8))
      (windowSeg (leftBlock (fLR l)) domLR tgR dt 3)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRR p) (Term.const 1)) domRR))
        ++ [Program.ode (rightBlock (fRR m) (Term.const 1)) domRR,
            Program.ode (rightBlock (fRR m) (Term.const 1)) domRR,
            Program.ode (rightBlock (fRR m) (Term.const 1)) domRR]))
      (Formula.and (FM gR (gs9R m)) envR)) σ := by
    simpa [List.replicate] using hfa
  refine sat_faModal_monoPost ?_ hfa2
  intro ν hν
  refine ⟨⟨FM_drop9R m hν.1, hν.2⟩, ?_⟩
  rw [sat_regionR_iff]
  have hface := (sat_FM_iff gR (gs9R m) ν).mp hν.1 (ceilR m)
    (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl)))
  simp only [ceilR, Term.eval, AOp.interp] at hface
  linarith

/-! ## The step provider — climb to `max(l, q)`, region received and owed -/

theorem HmultiR (dt : ℝ) (hdt : 0 ≤ dt)
    (hv00 : VerdR 0 0) (hv01 : VerdR 0 1) (hv02 : VerdR 0 2)
    (hv11 : VerdR 1 1) (hv12 : VerdR 1 2) (hv22 : VerdR 2 2) :
    ∀ P ∈ leftProgsR dt, ∀ (q : ℕ), q < GrR.modes.length → ∀ σ, σ mvR = (q : ℝ) →
      Formula.sat (Formula.and (FM gR gsR) envR) σ → Formula.sat (regionR q) σ →
      ∃ segs : List (ℕ × RMode (Var 8) × REdge (Var 8)),
        (∀ s ∈ segs, GrR.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrR.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 8)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (Formula.and (FM gR gsR) envR)
            (regionR (qfOf segs q)))) σ := by
  intro P hP q hq σ hmv hσ hreg
  have hq3 : q < 3 := by simpa [GrR] using hq
  have hstep : ∀ (a b : ℕ × RMode (Var 8) × REdge (Var 8)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 8) × REdge (Var 8)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeR st tgt ∈ GrR.edges →
      GrR.modeAt st = some (modeR st) ∧ edgeR st tgt ∈ GrR.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrR_modeAt st hs, edgeR_mem st tgt he⟩
  have hregv : σ (Rv 0) ≤ (if q = 0 then 3/10 else if q = 1 then 1/2 else 13/20) :=
    (sat_regionR_iff q σ).mp hreg
  have henr : ∀ m : ℕ, m < 3 → q ≤ m →
      Formula.sat (Formula.and (FM gR (gs9R m)) envR) σ :=
    fun m hm3 hqm => ⟨FM_add9R m hσ.1 (le_trans hregv (cstR_mono hq3 hm3 hqm)), hσ.2⟩
  simp only [leftProgsR, leftDataR, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have hgate : ∀ (l : ℕ) (R : Program (Var 8)) (ψ : Formula (Var 8)),
      Formula.sat (faModal (Equiv.refl (Var 8))
        (windowSeg (leftBlock (fLR l)) domLR tgR dt 3) R ψ) σ →
      Formula.sat (faModal (Equiv.refl (Var 8))
        (gwindowSeg Formula.tt (leftBlock (fLR l)) domLR tgR dt 3) R ψ) σ := by
    intro l R ψ hbody
    refine faModal_seqL _ _ _ _ _ _ ?_
    rw [sat_box]
    intro ν hν
    rw [sem_test] at hν
    obtain ⟨rfl, -⟩ := hν
    exact hbody
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeR 0, edgeR 0 0), (0, modeR 0, edgeR 0 0), (0, modeR 0, edgeR 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp)
        (henr 0 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeR 0, edgeR 0 0), (0, modeR 0, edgeR 0 0), (0, modeR 0, edgeR 0 0)] 0 = 0 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)] 1 = 1 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)] 2 = 2 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(0, modeR 0, edgeR 0 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp))))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 1 1 (by norm_num) (by norm_num) dt hdt hv11 [0] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl <;> norm_num)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeR 0, edgeR 0 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)] 0 = 1 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1), (1, modeR 1, edgeR 1 1)] 1 = 1 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)] 2 = 2 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeR, List.replicate] using this)
  · refine ⟨[(0, modeR 0, edgeR 0 1), (1, modeR 1, edgeR 1 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 1 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrR])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondR 2 2 (by norm_num) (by norm_num) dt hdt hv22 [0, 1] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl | rfl <;> norm_num)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeR 0, edgeR 0 1), (1, modeR 1, edgeR 1 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2), (2, modeR 2, edgeR 2 2)] 0 = 2 := rfl
