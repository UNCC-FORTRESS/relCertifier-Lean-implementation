noncomputable def modeR (q : ℕ) : RMode (Var 8) :=
  { sys := rightBlock (fRR q) (Term.const 1), dom := domRR, weight := 1 }

def edgeR (st tgt : ℕ) : REdge (Var 8) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrR : SearchGraph (Var 8) :=
  { modes := [modeR 0, modeR 1, modeR 2],
    edges := [edgeR 0 1, edgeR 0 0, edgeR 1 2, edgeR 1 1, edgeR 2 2] }

theorem GrR_modeAt (q : ℕ) (hq : q < 3) : GrR.modeAt q = some (modeR q) := by
  interval_cases q <;> rfl

theorem httR : ∀ q, ∀ e ∈ GrR.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrR.edges := List.mem_of_mem_filter he
  simp only [GrR, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltR : ∀ q, ∀ e ∈ GrR.edgesFrom q, e.tgt < GrR.modes.length := by
  intro q e he
  have hmem : e ∈ GrR.edges := List.mem_of_mem_filter he
  simp only [GrR, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrR, edgeR]

theorem hRvR : ∀ q m, GrR.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeR q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrR] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrR] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrR] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrR])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRR q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRR q) (Term.const 1) (hfRR q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRR hy

theorem edgeR_mem : ∀ st tgt, edgeR st tgt ∈ GrR.edges →
    edgeR st tgt ∈ GrR.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeR]⟩

theorem hfreshR : ∀ q m, GrR.modeAt q = some m →
    mvR ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvR q m hm (vars_ode_sub _ _ (Or.inl hmv)))

