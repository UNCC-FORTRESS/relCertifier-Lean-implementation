/-- **`refinement_ladder_rover_rung3_6to8`, modal Theorem 3** — the region-carrying chain at
the tool's λ = 17/10: each right mode's checked-cut ceiling `v_R ≤ c_m` rides the
loop invariant as its region (`mvRegionR`), the six climb verdict packs carry the
face first so every later component sees the ceiling, and the response climbs to
`max(window, start)` before running two coupled pieces. Residuals: six 5-query
stratified packs. -/
theorem rover_ladder_rung3_6to8_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv00 : VerdR 0 0) (hv01 : VerdR 0 1) (hv02 : VerdR 0 2)
    (hv11 : VerdR 1 1) (hv12 : VerdR 1 2) (hv22 : VerdR 2 2) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsR dt))
      (rightAutomatonBody GrR mvR)
      (RFormula.and (RFormula.and (canonInvM gR gsR) (envLR domLR domRR))
        (mvRegionR mvR regionR GrR.modes.length))) := by
  refine theorem3_faithful_multiR_LR GrR mvR (FM gR gsR) domLR domRR regionR
    (leftProgsR dt) (canonInvM gR gsR) (encode_canonInvM gR gsR) ?_ ?_ ?_
  · refine sides_disjoint 0 1 0 (by decide) (by decide) ?_ ?_
    · refine vars_bigChoice_sub _ _ ?_
      intro p hp
      simp only [leftProgsR, List.mem_map] at hp
      obtain ⟨d, hd, rfl⟩ := hp
      exact vars_gwindowSegL_sub d.1 d.2.1 d.2.2.1 1 dt d.2.2.2 (hLR d hd).1
        (hLR d hd).2.1 (hLR d hd).2.2
    · intro x hx
      rw [Program.rename_refl] at hx
      rcases vars_bodyU_sub GrR _ httR hRvR hx with hx | hx
      · exact Or.inl (Set.mem_insert_iff.mpr (Or.inl (Set.mem_singleton_iff.mp hx)))
      · exact Or.inr hx
  · exact hstep_assembled_multiR GrR mvR (FM gR gsR) envR regionR
      (leftProgsR dt) hmvFR hmvenvR hmvregR hfreshR httR hltR (hframesR dt)
      (HmultiR dt hdt hv00 hv01 hv02 hv11 hv12 hv22)
  · exact hddF_multiR GrR 0 1 dt leftDataR regionR (canonInvM gR gsR) domLR domRR
      (by decide) httR hRvR hLR (fun q _ => regionR_fv q)
      (canonInvM_varsL gR gsR (by
        intro g' hg'
        simp only [gR, gsR, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl | rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gR gsR) hdomLR hdomRR

end RoverLadderRung3Modal
