theorem esR (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gR (gs9R m)) envR) σ →
      HExistSegB (fLR l) (fRR m) (Term.const ((9:ℝ)/4)) domLR domRR dt
        (Function.update σ tgR 0) := by
  intro σ hσ
  have hceil : σ (Rv 0) ≤ (if m = 0 then 3/10 else if m = 1 then 1/2 else 13/20) := by
    have := (sat_FM_iff gR (gs9R m) σ).mp hσ.1 (ceilR m)
      (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl)))
    simp only [ceilR, Term.eval, AOp.interp] at this
    linarith
  have hR : Formula.sat domRR σ := hσ.2.2
  rw [sat_domRR] at hR
  obtain ⟨hd3l, hd3h, hd5l, hd5h, hd7l, hd7h, hd2l, hd2h, hd1l, hd4l, hd4h, hd0l, hd0h, hd6l, hd6h⟩ := hR
  have hupd : ∀ j : Fin 8, σ (Side.R, j) = Function.update σ tgR 0 (Side.R, j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgR, Prod.ext_iff])]
  have hfS : ∀ gT' ∈ gsSR, Term.eval gT' (Function.update σ tgR 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsSR, List.mem_cons, List.not_mem_nil, or_false] at hgT
