theorem ceilR_fv (m : ℕ) : (ceilR m).fv ⊆ range Rv := by
  intro x hx
  simp only [ceilR, Term.fv, Set.union_empty, Set.mem_singleton_iff] at hx
  exact ⟨0, hx.symm⟩

theorem regionR_fv (m : ℕ) : (regionR m).fv ⊆ range Rv := by
  intro x hx
  simp only [regionR, Formula.fv, Term.fv, Set.union_empty] at hx
  exact ceilR_fv m hx

theorem hmvregR : ∀ q, mvR ∉ (regionR q).fv := fun q h =>
  absurd (regionR_fv q h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

theorem sat_regionR_iff (m : ℕ) (ν : State (Var 8)) :
    Formula.sat (regionR m) ν ↔
      ν (Rv 0) ≤ (if m = 0 then 3/10 else if m = 1 then 1/2 else 13/20) := by
  simp only [regionR, ceilR, Formula.sat, CompOp.interp, Term.eval, AOp.interp]
  constructor <;> intro h <;> linarith

theorem cstR_mono {a b : ℕ} (ha : a < 3) (hb : b < 3) (hab : a ≤ b) :
    (if a = 0 then (3:ℝ)/10 else if a = 1 then 1/2 else 13/20)
      ≤ (if b = 0 then (3:ℝ)/10 else if b = 1 then 1/2 else 13/20) := by
  interval_cases a <;> interval_cases b <;> norm_num <;> omega

theorem htggs9R (m : ℕ) : ∀ g' ∈ gR :: gs9R m, tgR ∉ g'.fv := by
  intro g' hg' h
