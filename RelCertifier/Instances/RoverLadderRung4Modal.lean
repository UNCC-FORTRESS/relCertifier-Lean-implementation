theorem ceilF_fv (m : ℕ) : (ceilF m).fv ⊆ range Rv := by
  intro x hx
  simp only [ceilF, Term.fv, Set.union_empty, Set.mem_singleton_iff] at hx
  exact ⟨0, hx.symm⟩

theorem regionF_fv (m : ℕ) : (regionF m).fv ⊆ range Rv := by
  intro x hx
  simp only [regionF, Formula.fv, Term.fv, Set.union_empty] at hx
  exact ceilF_fv m hx

theorem hmvregF : ∀ q, mvF ∉ (regionF q).fv := fun q h =>
  absurd (regionF_fv q h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

theorem sat_regionF_iff (m : ℕ) (ν : State (Var 12)) :
    Formula.sat (regionF m) ν ↔
      ν (Rv 0) ≤ (if m = 0 then 3/10 else if m = 1 then 1/2 else 13/20) := by
  simp only [regionF, ceilF, Formula.sat, CompOp.interp, Term.eval, AOp.interp]
  constructor <;> intro h <;> linarith

theorem cstF_mono {a b : ℕ} (ha : a < 3) (hb : b < 3) (hab : a ≤ b) :
    (if a = 0 then (3:ℝ)/10 else if a = 1 then 1/2 else 13/20)
      ≤ (if b = 0 then (3:ℝ)/10 else if b = 1 then 1/2 else 13/20) := by
  interval_cases a <;> interval_cases b <;> norm_num <;> omega

