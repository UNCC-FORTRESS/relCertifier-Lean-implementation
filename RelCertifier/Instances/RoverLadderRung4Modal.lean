/-! ## The route verdicts — region face FIRST in the strata order, so every later
component's query carries the cut ceiling in its domain -/

noncomputable def gsVF (m : ℕ) : List (Term (Var 12)) := gF :: gsF

def VerdF (l m : ℕ) : Prop :=
  ∀ i (hi : i < (ceilF m :: gsVF m).length),
    z3solve (flowQuery ⟨(ceilF m :: gsVF m)[i], fLF l, fRF m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLF domRF) ((ceilF m :: gsVF m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(ceilF m :: gsVF m)[i], fLF l, fRF m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLF domRF) ((ceilF m :: gsVF m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(ceilF m :: gsVF m)[i], fLF l, fRF m, Term.const ((17:ℝ)/10),
      strataDomHost (Formula.and domLF domRF) ((ceilF m :: gsVF m).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ = 17/10 over the enriched invariant, and its transport -/

theorem coupleF (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdF l m) :
    ∀ σ', Formula.sat (Formula.and (FM gF (gs9F m)) envF) σ' → σ' tgF = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgF (leftBlock (fLF l))) domLF)
        (Program.ode (rightBlock (fRF m) (Term.const ((17:ℝ)/10))) domRF)
        (Formula.and (FM gF (gs9F m)) envF) tgF dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgF (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgF
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLF l) (fRF m) (Term.const ((17:ℝ)/10))
    (Formula.and domLF domRF) (ceilF m :: gsVF m) hv
  have hmemV : ∀ g' ∈ gF :: gs9F m, g' ∈ ceilF m :: gsVF m := by
    intro g' hg'
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact List.mem_cons_of_mem _ List.mem_cons_self
    · rcases List.mem_append.mp hg' with hg' | hg'
      · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hg')
      · rw [List.mem_singleton] at hg'
        subst hg'
        exact List.mem_cons_self
  have hboxes : ∀ g' ∈ gF :: gs9F m, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLF l) ++ rightBlock (fRF m) (Term.const ((17:ℝ)/10)))
      (Formula.and domLF domRF)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' (hmemV g' hg')
    intro g hg
    have hgmem : g ∈ gF :: gs9F m := by
      rcases List.mem_cons.mp hg with rfl | hg
      · exact List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl))
      · rcases List.mem_cons.mp hg with rfl | hg
        · exact List.mem_cons_self
        · exact List.mem_cons_of_mem _ (List.mem_append_left _ hg)
    exact (sat_FM_iff gF (gs9F m) σ').mp hσ'.1 g hgmem
  have hbase := segment_faModalB_from_certB_list gF (gs9F m) (fLF l) (fRF m)
    (Term.const ((17:ℝ)/10)) domLF domRF tgF dt
    (LR_blocks_disjoint _ _ _ (hfLF l hl) (hfRF m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLF hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRF hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLF l) _ h
      exact aux_ne_Lv aF i hi)
    (fun h => aux_notin_range_Lv aF (leftBlock_readVars_sub (fLF l) (hfLF l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRF m) (Term.const ((17:ℝ)/10)) _ h
      exact aux_ne_Rv aF i hi)
    (fun h => aux_notin_range_Rv aF (rightBlock_readVars_sub (fRF m)
      (Term.const ((17:ℝ)/10)) (hfRF m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aF (rightBlock_boundSet_sub (fRF m)
      (Term.const ((17:ℝ)/10)) h))
    (fun h => aux_notin_range_Lv aF (hdomLF h))
    (fun h => aux_notin_range_Rv aF (hdomRF h))
    (htggs9F m) hboxes
    (esF l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLF ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRF μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLF μ := by
    rwa [(Formula.coincidence domLF (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLF hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRF m) (Term.const ((17:ℝ)/10)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLF μ ↔ Formula.sat domLF ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1F (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdF l m) :
    ∀ σ, Formula.sat (Formula.and (FM gF (gs9F m)) envF) σ →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgF (leftBlock (fLF l))) domLF)
        (Program.ode (rightBlock (fRF m) (Term.const 1)) domRF)
        (Formula.and (FM gF (gs9F m)) envF) tgF dt
        (Function.update σ tgF 0) := by
  intro σ hσ
  have htgφ : tgF ∉ (Formula.and (FM gF (gs9F m)) envF).fv := by
    intro h
    rcases h with h | h
    · exact htgF9F m h
    · exact htgenvF h
  have hupdφ : Formula.sat (Formula.and (FM gF (gs9F m)) envF)
      (Function.update σ tgF 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gF (gs9F m)) envF) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gF (gs9F m)) envF) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleF l m hl hm dt hdt hv
    (Function.update σ tgF 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam ((17:ℝ)/10) 1 (by norm_num) one_pos hsem


theorem sat_faModal_monoPost {P Q : Program (Var 12)} {A B : Formula (Var 12)}
    (hAB : ∀ ν, Formula.sat A ν → Formula.sat B ν) {σ : State (Var 12)}
    (h : Formula.sat (faModal (Equiv.refl (Var 12)) P Q A) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12)) P Q B) σ := by
  rw [faModal_sat] at h ⊢
  intro ν hν
  obtain ⟨μ, hμ, hA⟩ := h ν hν
  exact ⟨μ, hμ, hAB μ hA⟩

/-! ## The window response — hop prefix, two coupled pieces, region owed -/

theorem respondF (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdF l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 12)}
    (hσE : Formula.sat (Formula.and (FM gF (gs9F m)) envF) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLF l)) domLF tgF dt 2)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRF p) (Term.const 1)) domRF))
        ++ [Program.ode (rightBlock (fRF m) (Term.const 1)) domRF,
            Program.ode (rightBlock (fRF m) (Term.const 1)) domRF]))
      (Formula.and (Formula.and (FM gF gsF) envF) (regionF m))) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLF l) domLF (FM gF (gs9F m)) envF
    aF dt 2 (htgF9F m) htgenvF
    (path.map (fun p => (⟨fRF p, Term.const 1, domRF⟩ : RepoHop 12)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRF p (hpath p hp), by simp [Term.fv], hdomRF⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRF p)
        (lam := Term.const 1) (domR := domRF) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLF l hl) hdomLF
    (List.replicate 2 (Program.ode (rightBlock (fRF m) (Term.const 1)) domRF))
    (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRF m, Term.const 1, domRF⟩ : RepoHop 12)
        (hfRF m hm) (by simp [Term.fv]) hdomRF (hfLF l hl) hdomLF)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1F l m hl hm dt hdt hv σ' hσ')
    hσE
  rw [show (path.map (fun p => (⟨fRF p, Term.const 1, domRF⟩ : RepoHop 12))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRF p) (Term.const 1)) domRF)
    from by rw [List.map_map]; rfl] at hfa
  have hfa2 : Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLF l)) domLF tgF dt 2)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRF p) (Term.const 1)) domRF))
        ++ [Program.ode (rightBlock (fRF m) (Term.const 1)) domRF,
            Program.ode (rightBlock (fRF m) (Term.const 1)) domRF]))
      (Formula.and (FM gF (gs9F m)) envF)) σ := by
    simpa [List.replicate] using hfa
  refine sat_faModal_monoPost ?_ hfa2
  intro ν hν
  refine ⟨⟨FM_drop9F m hν.1, hν.2⟩, ?_⟩
  rw [sat_regionF_iff]
  have hface := (sat_FM_iff gF (gs9F m) ν).mp hν.1 (ceilF m)
    (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl)))
  simp only [ceilF, Term.eval, AOp.interp] at hface
  linarith

/-! ## The step provider — climb to `max(l, q)`, region received and owed -/

theorem HmultiF (dt : ℝ) (hdt : 0 ≤ dt)
    (hv00 : VerdF 0 0) (hv01 : VerdF 0 1) (hv02 : VerdF 0 2)
    (hv11 : VerdF 1 1) (hv12 : VerdF 1 2) (hv22 : VerdF 2 2) :
    ∀ P ∈ leftProgsF dt, ∀ (q : ℕ), q < GrF.modes.length → ∀ σ, σ mvF = (q : ℝ) →
      Formula.sat (Formula.and (FM gF gsF) envF) σ → Formula.sat (regionF q) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrF.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrF.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (Formula.and (FM gF gsF) envF)
            (regionF (qfOf segs q)))) σ := by
  intro P hP q hq σ hmv hσ hreg
  have hq3 : q < 3 := by simpa [GrF] using hq
  have hstep : ∀ (a b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeF st tgt ∈ GrF.edges →
      GrF.modeAt st = some (modeF st) ∧ edgeF st tgt ∈ GrF.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrF_modeAt st hs, edgeF_mem st tgt he⟩
  have hregv : σ (Rv 0) ≤ (if q = 0 then 3/10 else if q = 1 then 1/2 else 13/20) :=
    (sat_regionF_iff q σ).mp hreg
  have henr : ∀ m : ℕ, m < 3 → q ≤ m →
      Formula.sat (Formula.and (FM gF (gs9F m)) envF) σ :=
    fun m hm3 hqm => ⟨FM_add9F m hσ.1 (le_trans hregv (cstF_mono hq3 hm3 hqm)), hσ.2⟩
  simp only [leftProgsF, leftDataF, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have hgate : ∀ (l : ℕ) (R : Program (Var 12)) (ψ : Formula (Var 12)),
      Formula.sat (faModal (Equiv.refl (Var 12))
        (windowSeg (leftBlock (fLF l)) domLF tgF dt 2) R ψ) σ →
      Formula.sat (faModal (Equiv.refl (Var 12))
        (gwindowSeg Formula.tt (leftBlock (fLF l)) domLF tgF dt 2) R ψ) σ := by
    intro l R ψ hbody
    refine faModal_seqL _ _ _ _ _ _ ?_
    rw [sat_box]
    intro ν hν
    rw [sem_test] at hν
    obtain ⟨rfl, -⟩ := hν
    exact hbody
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeF 0, edgeF 0 0), (0, modeF 0, edgeF 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp)
        (henr 0 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeF 0, edgeF 0 0), (0, modeF 0, edgeF 0 0)] 0 = 0 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)] 1 = 1 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)] 2 = 2 := rfl
      rw [hq]
      exact hgate 0 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(0, modeF 0, edgeF 0 1), (1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 1 1 (by norm_num) (by norm_num) dt hdt hv11 [0] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl <;> norm_num)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeF 0, edgeF 0 1), (1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)] 0 = 1 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp)
        (henr 1 (by norm_num) (by norm_num))
      have hq : qfOf [(1, modeF 1, edgeF 1 1), (1, modeF 1, edgeF 1 1)] 1 = 1 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (by simp))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)] 2 = 2 := rfl
      rw [hq]
      exact hgate 1 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(0, modeF 0, edgeF 0 1), (1, modeF 1, edgeF 1 2), (2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl | rfl
      · exact halign 0 1 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 1 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp))))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 2 2 (by norm_num) (by norm_num) dt hdt hv22 [0, 1] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl | rfl <;> norm_num)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(0, modeF 0, edgeF 0 1), (1, modeF 1, edgeF 1 2), (2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)] 0 = 2 := rfl
      rw [hq]
      exact hgate 2 _ _ (by simpa [modeF, List.replicate] using this)
  · refine ⟨[(1, modeF 1, edgeF 1 2), (2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl | rfl | rfl
      · exact halign 1 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrF])
    · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondF 2 2 (by norm_num) (by norm_num) dt hdt hv22 [1] (by intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp; rcases hp with rfl <;> norm_num)
        (henr 2 (by norm_num) (by norm_num))
      have hq : qfOf [(1, modeF 1, edgeF 1 2), (2, modeF 2, edgeF 2 2), (2, modeF 2, edgeF 2 2)] 1 = 2 := rfl
