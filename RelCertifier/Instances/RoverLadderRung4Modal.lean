theorem esF (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gF (gs9F m)) envF) σ →
      HExistSegB (fLF l) (fRF m) (Term.const ((17:ℝ)/10)) domLF domRF dt
        (Function.update σ tgF 0) := by
  intro σ hσ
  have hceil : σ (Rv 0) ≤ (if m = 0 then 3/10 else if m = 1 then 1/2 else 13/20) := by
