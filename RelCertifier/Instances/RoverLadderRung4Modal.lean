/-! ## Lipschitz and field bound -/

theorem hLip_F (q : ℕ) (hq : q < 3) (ν : State (Var 12))
    (hν : ∀ gT' ∈ gsSF, Term.eval gT' ν ≤ 0) :
    LipschitzOnWith 60 (odeField (jointSys (fun _ => Term.const 0) (fRF q) (Term.const ((17:ℝ)/10))))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 12), a ≠ b → (Rv a : Var 12) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RF q hq, odeField_RF q hq]
  have hdc : ∀ j : Fin 12, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((60 : NNReal) : ℝ) = 60 := rfl
  rw [hcoe]
  have hband : ∀ (w : State (Var 12)), dist w ν ≤ 1 → ∀ (j : Fin 12) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -2 ≤ lo → hi ≤ 2 → |w (Rv j)| ≤ 3 := by
    intro w hw j lo hi hl hh hlo1 hhi1
    have h := dist_le_pi_dist w ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (w (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hw]
  have hνv1 : 0 ≤ ν (Rv 0) := by
    have := hν faceVLo (by simp [gsSF])
    simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
  have hνv2 : ν (Rv 0) ≤ (4:ℝ)/5 := by
    have := hν faceVHi (by simp [gsSF])
    simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
  have hνp1 : -(1:ℝ) ≤ ν (Rv 2) := by
    have := hν facePsAuxLo (by simp [gsSF])
    simp only [facePsAuxLo, Term.eval, AOp.interp] at this; linarith
  have hνp2 : ν (Rv 2) ≤ (1:ℝ) := by
    have := hν facePsAuxHi (by simp [gsSF])
    simp only [facePsAuxHi, Term.eval, AOp.interp] at this; linarith
  have hνt1 : -(1:ℝ) ≤ ν (Rv 4) := by
    have := hν faceThAuxLo (by simp [gsSF])
    simp only [faceThAuxLo, Term.eval, AOp.interp] at this; linarith
  have hνt2 : ν (Rv 4) ≤ (1:ℝ) := by
    have := hν faceThAuxHi (by simp [gsSF])
    simp only [faceThAuxHi, Term.eval, AOp.interp] at this; linarith
  have hyb0 : |y (Rv 0)| ≤ 3 := hband y hy 0 (0) ((4:ℝ)/5) hνv1 hνv2 (by norm_num) (by norm_num)
  have hxb2 : |x (Rv 2)| ≤ 3 := hband x hx 2 (-(1:ℝ)) ((1:ℝ)) hνp1 hνp2 (by norm_num) (by norm_num)
  have hyb2 : |y (Rv 2)| ≤ 3 := hband y hy 2 (-(1:ℝ)) ((1:ℝ)) hνp1 hνp2 (by norm_num) (by norm_num)
  have hxb4 : |x (Rv 4)| ≤ 3 := hband x hx 4 (-(1:ℝ)) ((1:ℝ)) hνt1 hνt2 (by norm_num) (by norm_num)
  have hyb4 : |y (Rv 4)| ≤ 3 := hband y hy 4 (-(1:ℝ)) ((1:ℝ)) hνt1 hνt2 (by norm_num) (by norm_num)
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |3 * (cstF q - x (Rv 0)) - 3 * (cstF q - y (Rv 0))| ≤ 3 * dist x y := by
      have hdiff : 3 * (cstF q - x (Rv 0)) - 3 * (cstF q - y (Rv 0)) = -(3 : ℝ) * (x (Rv 0) - y (Rv 0)) := by ring
      rw [hdiff, abs_mul]
      have habs : |-(3 : ℝ)| = 3 := by norm_num
      rw [habs]
      nlinarith [hdc 0]
    have hfac : ∀ A B : ℝ, ((17:ℝ)/10) * A - ((17:ℝ)/10) * B = ((17:ℝ)/10) * (A - B) := by
      intro A B; ring
    rw [hfac, abs_mul, abs_of_pos (show (0:ℝ) < ((17:ℝ)/10) by norm_num)]
    nlinarith [hcore, hd]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hcore : |x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))
        - y (Rv 0) * ((1 - 1/2 * (y (Rv 2) * y (Rv 2))) - 3/10 * (y (Rv 4) * y (Rv 4)))|
        ≤ 27 * dist x y := by
      have hdiff : x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))
          - y (Rv 0) * ((1 - 1/2 * (y (Rv 2) * y (Rv 2))) - 3/10 * (y (Rv 4) * y (Rv 4)))
          = ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))
              * (x (Rv 0) - y (Rv 0))
            + y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
                - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4)))) := by
        ring
      rw [hdiff]
      have hBx : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))| ≤ 9 := by
        have h2 : x (Rv 2) * x (Rv 2) ≤ 9 := by nlinarith [abs_le.mp hxb2]
        have h3 : x (Rv 4) * x (Rv 4) ≤ 9 := by nlinarith [abs_le.mp hxb4]
        have h2n : 0 ≤ x (Rv 2) * x (Rv 2) := mul_self_nonneg _
        have h3n : 0 ≤ x (Rv 4) * x (Rv 4) := mul_self_nonneg _
        rw [abs_le]
        constructor <;> nlinarith
      have htri : |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
            - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))))| ≤ 6 * dist x y := by
        have hA : |(x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2))| ≤ 6 * dist x y := by
          rw [abs_mul]
          have hs : |x (Rv 2) + y (Rv 2)| ≤ 6 := by
            calc |x (Rv 2) + y (Rv 2)| ≤ |x (Rv 2)| + |y (Rv 2)| := abs_add_le _ _
              _ ≤ 6 := by linarith [abs_le.mp hxb2, abs_le.mp hyb2]
          nlinarith [hdc 2, abs_nonneg (x (Rv 2) + y (Rv 2)), abs_nonneg (x (Rv 2) - y (Rv 2))]
        have hB2 : |(x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))| ≤ 6 * dist x y := by
          rw [abs_mul]
          have hs : |x (Rv 4) + y (Rv 4)| ≤ 6 := by
            calc |x (Rv 4) + y (Rv 4)| ≤ |x (Rv 4)| + |y (Rv 4)| := abs_add_le _ _
              _ ≤ 6 := by linarith [abs_le.mp hxb4, abs_le.mp hyb4]
          nlinarith [hdc 4, abs_nonneg (x (Rv 4) + y (Rv 4)), abs_nonneg (x (Rv 4) - y (Rv 4))]
        have e1 : |(-(1/2) : ℝ) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))|
            ≤ 1/2 * (6 * dist x y) := by
          rw [abs_mul]
          have h : |(-(1/2) : ℝ)| = 1/2 := by norm_num
          rw [h]
          nlinarith [abs_nonneg ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))]
        have e2 : |((3:ℝ)/10) * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4)))|
            ≤ 3/10 * (6 * dist x y) := by
          rw [abs_mul]
          have h : |((3:ℝ)/10)| = 3/10 := by norm_num
          rw [h]
          nlinarith [abs_nonneg ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4)))]
        have hsub : |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
              - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))))|
            ≤ |(-(1/2) : ℝ) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))|
              + |((3:ℝ)/10) * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4)))| := by
          rw [sub_eq_add_neg]
          refine (abs_add_le _ _).trans ?_
          rw [abs_neg]
        linarith
      have hfin1 : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))|
          * |x (Rv 0) - y (Rv 0)| ≤ 9 * dist x y :=
        mul_le_mul hBx (hdc 0) (abs_nonneg _) (by norm_num)
      have hfin2 : |y (Rv 0)| * |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
            - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))))|
          ≤ 3 * (6 * dist x y) :=
        mul_le_mul hyb0 htri (abs_nonneg _) (by norm_num)
      have hsplit : |((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))
              * (x (Rv 0) - y (Rv 0))
            + y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
                - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))))|
          ≤ |((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))
              * (x (Rv 0) - y (Rv 0))|
            + |y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
                - 3/10 * ((x (Rv 4) + y (Rv 4)) * (x (Rv 4) - y (Rv 4))))| := abs_add_le _ _
      rw [abs_mul, abs_mul] at hsplit
      linarith
