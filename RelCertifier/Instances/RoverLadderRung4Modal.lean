      odeField_RF q hq]
    simp only [if_neg (hne 3 0 (by decide)), if_neg (hne 3 1 (by decide)), if_neg (hne 3 2 (by decide)), eq_self_iff_true, if_true, if_pos rfl, hx]
    norm_num
