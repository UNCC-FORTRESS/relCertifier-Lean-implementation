      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLT_pipe : domLT =
    (((some (mLT 0)).bind (fun m => Run.lowerF vsT 2 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRT_pipe : domRT =
