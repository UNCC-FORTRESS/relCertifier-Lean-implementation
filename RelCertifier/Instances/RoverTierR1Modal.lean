theorem GrX_modeAt (q : ℕ) (hq : q < 1) : GrX.modeAt q = some (modeX q) := by
  interval_cases q <;> rfl

theorem httX : ∀ q, ∀ e ∈ GrX.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrX.edges := List.mem_of_mem_filter he
  simp only [GrX, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl <;> rfl

theorem hltX : ∀ q, ∀ e ∈ GrX.edgesFrom q, e.tgt < GrX.modes.length := by
  intro q e he
  have hmem : e ∈ GrX.edges := List.mem_of_mem_filter he
  simp only [GrX, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl <;> norm_num [GrX, edgeX]

theorem hRvX : ∀ q m, GrX.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 1 ∧ m = modeX q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrX] using hm.symm⟩
    | q + 1 => exact absurd hm (by simp [SearchGraph.modeAt, GrX])
  obtain ⟨hq1, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRX q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRX q) (Term.const 1) (hfRX q hq1)
      (by simp [Term.fv]) hy
  · exact hdomRX hy

theorem edgeX_mem : ∀ st tgt, edgeX st tgt ∈ GrX.edges →
    edgeX st tgt ∈ GrX.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeX]⟩

