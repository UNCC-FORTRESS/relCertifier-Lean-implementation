/-! ## Existence — the CLOSED-FORM polynomial witness

The right field at λ = 19/4 freezes `a`, drives `v` linearly, `s`
quadratically: the run from anchor `μ` is written down explicitly, no
Picard machinery involved. -/

theorem esX (l m : ℕ) (hl : l < 1) (hm : m < 1) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gX (gs9X m)) envX) σ →
      HExistSegB (fLX l) (fRX m) (Term.const ((19:ℝ)/4)) domLX domRX dt
        (Function.update σ tgX 0) := by
  intro σ hσ
  have hR : Formula.sat domRX σ := hσ.2.2
  rw [sat_domRX] at hR
  obtain ⟨hd2l, hd2h, hd0l, hd1l⟩ := hR
  have hreg : (3:ℝ)/10 ≤ σ (Rv 1) := by
    have := (sat_FM_iff gX (gs9X m) σ).mp hσ.1 (ceilX m)
      (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl)))
    simp only [ceilX, Term.eval, AOp.interp] at this
    linarith
  intro s ΦL hs0 hsdt hΦL0 hderL hmaskL hdomL
  set μ : State (Var 3) := ΦL s with hμ
  have hμcoin : ∀ j : Fin 3, μ (Rv j) = Function.update σ tgX 0 (Rv j) := by
    intro j
    refine hmaskL s (right_mem_Icc.mpr hs0) (Rv j) ?_
    intro hb
    obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLX l) _ hb
    exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])
  have hupd : ∀ j : Fin 3, Function.update σ tgX 0 (Rv j) = σ (Rv j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgX, Prod.ext_iff])]
  have ha0 : (3:ℝ)/10 ≤ μ (Rv 2) := by rw [hμcoin 2, hupd 2]; exact hd2l
  have ha0h : μ (Rv 2) ≤ (3:ℝ)/5 := by rw [hμcoin 2, hupd 2]; exact hd2h
  have hv0 : (3:ℝ)/10 ≤ μ (Rv 1) := by rw [hμcoin 1, hupd 1]; exact hreg
  have hs0' : (0:ℝ) ≤ μ (Rv 0) := by rw [hμcoin 0, hupd 0]; exact hd0l
  set lam : ℝ := (19:ℝ)/4 with hlam
  classical
  refine ⟨fun t x => if x = Rv 0 then
      μ (Rv 0) + lam * μ (Rv 1) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
    else if x = Rv 1 then μ (Rv 1) + lam * μ (Rv 2) * t
    else μ x, ?_, ?_, ?_, ?_⟩
  · funext x
    by_cases h0 : x = Rv 0
    · subst h0; simp
    · by_cases h1 : x = Rv 1
      · subst h1
        simp [if_neg (show (Rv 1 : Var 3) ≠ Rv 0 by simp [Rv, Prod.ext_iff])]
      · simp [if_neg h0, if_neg h1]
  · intro t ht p hp
    simp only [rightBlock, List.mem_map, List.mem_finRange] at hp
    obtain ⟨i, -, rfl⟩ := hp
    have hne10 : (Rv 1 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    have hne20 : (Rv 2 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    have hne21 : (Rv 2 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    fin_cases i
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRX m ⟨0, by norm_num⟩))
          (fun x => if x = Rv 0 then
              μ (Rv 0) + lam * μ (Rv 1) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 1 then μ (Rv 1) + lam * μ (Rv 2) * t
            else μ x)
          = lam * (μ (Rv 1) + lam * μ (Rv 2) * t) := by
        simp [Term.eval, AOp.interp, show fRX m ⟨0, by norm_num⟩ = fRX m 0 from rfl,
          fRX0_eval m hm, if_neg hne10, hlam]
      simp only [heval]
      have h2 : HasDerivWithinAt (fun u : ℝ => μ (Rv 0) + lam * μ (Rv 1) * u)
          (lam * μ (Rv 1) * 1) (Set.Icc 0 s) t :=
        ((hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).const_mul
          (lam * μ (Rv 1))).const_add (μ (Rv 0))
      have hp2 : HasDerivWithinAt (fun u : ℝ => u * u) (1 * t + t * 1)
          (Set.Icc 0 s) t :=
        (hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).mul
          (hasDerivWithinAt_id t (Set.Icc (0:ℝ) s))
      have h3 := hp2.const_mul (lam ^ 2 * μ (Rv 2) / 2)
      have hsum := h2.add h3
      have heqd : lam * μ (Rv 1) * 1 + lam ^ 2 * μ (Rv 2) / 2 * (1 * t + t * 1)
          = lam * (μ (Rv 1) + lam * μ (Rv 2) * t) := by ring
      rw [heqd] at hsum
      refine HasDerivWithinAt.congr hsum ?_ ?_
      · intro y _
        simp [Pi.add_apply]
      · simp [Pi.add_apply]
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRX m ⟨1, by norm_num⟩))
          (fun x => if x = Rv 0 then
              μ (Rv 0) + lam * μ (Rv 1) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 1 then μ (Rv 1) + lam * μ (Rv 2) * t
            else μ x)
          = lam * μ (Rv 2) := by
        simp [Term.eval, AOp.interp, show fRX m ⟨1, by norm_num⟩ = fRX m 1 from rfl,
          fRX1_eval m hm, if_neg hne20, if_neg hne21, hlam]
      simp only [heval]
      have h2 : HasDerivWithinAt (fun u : ℝ => μ (Rv 1) + lam * μ (Rv 2) * u)
          (lam * μ (Rv 2) * 1) (Set.Icc 0 s) t :=
        ((hasDerivWithinAt_id t (Set.Icc (0:ℝ) s)).const_mul
          (lam * μ (Rv 2))).const_add (μ (Rv 1))
      have heqd : lam * μ (Rv 2) * 1 = lam * μ (Rv 2) := by ring
      rw [heqd] at h2
      refine HasDerivWithinAt.congr h2 ?_ ?_
      · intro y _
        simp [if_neg hne10]
      · simp [if_neg hne10]
    · have heval : Term.eval (Term.binop AOp.mul (Term.const lam) (fRX m ⟨2, by norm_num⟩))
          (fun x => if x = Rv 0 then
              μ (Rv 0) + lam * μ (Rv 1) * t + lam ^ 2 * μ (Rv 2) / 2 * (t * t)
            else if x = Rv 1 then μ (Rv 1) + lam * μ (Rv 2) * t
            else μ x)
          = 0 := by
        simp [Term.eval, AOp.interp, show fRX m ⟨2, by norm_num⟩ = fRX m 2 from rfl,
          fRX2_eval m hm]
      simp only [heval]
      refine HasDerivWithinAt.congr
        (hasDerivWithinAt_const t (Set.Icc (0:ℝ) s) (μ (Rv 2))) ?_ ?_
      · intro y _
        simp [if_neg hne20, if_neg hne21]
      · simp [if_neg hne20, if_neg hne21]
  · intro t ht x hx
    have hx0 : x ≠ Rv 0 := by
      intro h; subst h
      exact hx (by
        simp only [rightBlock, ODESystem.bound, List.map_map, List.mem_map]
        exact ⟨0, List.mem_finRange 0, rfl⟩)
    have hx1 : x ≠ Rv 1 := by
      intro h; subst h
      exact hx (by
        simp only [rightBlock, ODESystem.bound, List.map_map, List.mem_map]
        exact ⟨1, List.mem_finRange 1, rfl⟩)
    simp [if_neg hx0, if_neg hx1]
  · intro t ht
    rw [sat_domRX]
    have ht0 : (0:ℝ) ≤ t := ht.1
    have hne10 : (Rv 1 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    have hne20 : (Rv 2 : Var 3) ≠ Rv 0 := by simp [Rv, Prod.ext_iff]
    have hne21 : (Rv 2 : Var 3) ≠ Rv 1 := by simp [Rv, Prod.ext_iff]
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [if_neg hne20, if_neg hne21]
      exact ha0
    · simp only [if_neg hne20, if_neg hne21]
      exact ha0h
    · simp only [eq_self_iff_true, if_true, if_pos rfl]
      have hlpos : (0:ℝ) < lam := by norm_num [hlam]
      have hq1 : 0 ≤ lam * μ (Rv 1) * t :=
        mul_nonneg (mul_nonneg hlpos.le (by linarith)) ht0
      have hq2 : 0 ≤ lam ^ 2 * μ (Rv 2) / 2 * (t * t) :=
        mul_nonneg (div_nonneg (mul_nonneg (sq_nonneg _) (by linarith)) (by norm_num)) (mul_self_nonneg t)
      exact add_nonneg (add_nonneg hs0' hq1) hq2
    · simp only [if_neg hne10, eq_self_iff_true, if_true, if_pos rfl]
      have hlpos : (0:ℝ) < lam := by norm_num [hlam]
      have h4 : 0 ≤ lam * μ (Rv 2) * t :=
        mul_nonneg (mul_nonneg hlpos.le (by linarith)) ht0
      calc (1:ℝ)/4 ≤ (3:ℝ)/10 := by norm_num
        _ ≤ μ (Rv 1) := hv0
        _ ≤ μ (Rv 1) + lam * μ (Rv 2) * t := by linarith

/-! ## The route verdicts — region face FIRST in the strata order, so every later
component's query carries the cut ceiling in its domain -/

noncomputable def gsVX (m : ℕ) : List (Term (Var 3)) := gX :: gsX

def VerdX (l m : ℕ) : Prop :=
  ∀ i (hi : i < (ceilX m :: gsVX m).length),
    z3solve (flowQuery ⟨(ceilX m :: gsVX m)[i], fLX l, fRX m, Term.const ((19:ℝ)/4),
      strataDomHost (Formula.and domLX domRX) ((ceilX m :: gsVX m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(ceilX m :: gsVX m)[i], fLX l, fRX m, Term.const ((19:ℝ)/4),
      strataDomHost (Formula.and domLX domRX) ((ceilX m :: gsVX m).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(ceilX m :: gsVX m)[i], fLX l, fRX m, Term.const ((19:ℝ)/4),
      strataDomHost (Formula.and domLX domRX) ((ceilX m :: gsVX m).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ = 17/10 over the enriched invariant, and its transport -/

theorem coupleX (l m : ℕ) (hl : l < 1) (hm : m < 1) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdX l m) :
    ∀ σ', Formula.sat (Formula.and (FM gX (gs9X m)) envX) σ' → σ' tgX = 0 →
      faModalB (Equiv.refl (Var 3))
        (Program.ode (DLCalTiming.clk tgX (leftBlock (fLX l))) domLX)
        (Program.ode (rightBlock (fRX m) (Term.const ((19:ℝ)/4))) domRX)
        (Formula.and (FM gX (gs9X m)) envX) tgX dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgX (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgX
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLX l) (fRX m) (Term.const ((19:ℝ)/4))
    (Formula.and domLX domRX) (ceilX m :: gsVX m) hv
  have hmemV : ∀ g' ∈ gX :: gs9X m, g' ∈ ceilX m :: gsVX m := by
    intro g' hg'
    rcases List.mem_cons.mp hg' with rfl | hg'
    · exact List.mem_cons_of_mem _ List.mem_cons_self
    · rcases List.mem_append.mp hg' with hg' | hg'
      · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hg')
      · rw [List.mem_singleton] at hg'
        subst hg'
        exact List.mem_cons_self
  have hboxes : ∀ g' ∈ gX :: gs9X m, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLX l) ++ rightBlock (fRX m) (Term.const ((19:ℝ)/4)))
      (Formula.and domLX domRX)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' (hmemV g' hg')
    intro g hg
    have hgmem : g ∈ gX :: gs9X m := by
      rcases List.mem_cons.mp hg with rfl | hg
      · exact List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl))
      · rcases List.mem_cons.mp hg with rfl | hg
        · exact List.mem_cons_self
        · exact List.mem_cons_of_mem _ (List.mem_append_left _ hg)
    exact (sat_FM_iff gX (gs9X m) σ').mp hσ'.1 g hgmem
  have hbase := segment_faModalB_from_certB_list gX (gs9X m) (fLX l) (fRX m)
    (Term.const ((19:ℝ)/4)) domLX domRX tgX dt
    (LR_blocks_disjoint _ _ _ (hfLX l hl) (hfRX m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLX hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRX hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLX l) _ h
      exact aux_ne_Lv aX i hi)
    (fun h => aux_notin_range_Lv aX (leftBlock_readVars_sub (fLX l) (hfLX l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRX m) (Term.const ((19:ℝ)/4)) _ h
      exact aux_ne_Rv aX i hi)
    (fun h => aux_notin_range_Rv aX (rightBlock_readVars_sub (fRX m)
      (Term.const ((19:ℝ)/4)) (hfRX m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aX (rightBlock_boundSet_sub (fRX m)
      (Term.const ((19:ℝ)/4)) h))
    (fun h => aux_notin_range_Lv aX (hdomLX h))
    (fun h => aux_notin_range_Rv aX (hdomRX h))
    (htggs9X m) hboxes
    (esX l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLX ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRX μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLX μ := by
    rwa [(Formula.coincidence domLX (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLX hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRX m) (Term.const ((19:ℝ)/4)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLX μ ↔ Formula.sat domLX ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1X (l m : ℕ) (hl : l < 1) (hm : m < 1) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdX l m) :
    ∀ σ, Formula.sat (Formula.and (FM gX (gs9X m)) envX) σ →
      faModalB (Equiv.refl (Var 3))
        (Program.ode (DLCalTiming.clk tgX (leftBlock (fLX l))) domLX)
        (Program.ode (rightBlock (fRX m) (Term.const 1)) domRX)
        (Formula.and (FM gX (gs9X m)) envX) tgX dt
        (Function.update σ tgX 0) := by
  intro σ hσ
  have htgφ : tgX ∉ (Formula.and (FM gX (gs9X m)) envX).fv := by
    intro h
    rcases h with h | h
    · exact htgF9X m h
    · exact htgenvX h
  have hupdφ : Formula.sat (Formula.and (FM gX (gs9X m)) envX)
      (Function.update σ tgX 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gX (gs9X m)) envX) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gX (gs9X m)) envX) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleX l m hl hm dt hdt hv
    (Function.update σ tgX 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam ((19:ℝ)/4) 1 (by norm_num) one_pos hsem


theorem sat_faModal_monoPost {P Q : Program (Var 3)} {A B : Formula (Var 3)}
    (hAB : ∀ ν, Formula.sat A ν → Formula.sat B ν) {σ : State (Var 3)}
    (h : Formula.sat (faModal (Equiv.refl (Var 3)) P Q A) σ) :
    Formula.sat (faModal (Equiv.refl (Var 3)) P Q B) σ := by
  rw [faModal_sat] at h ⊢
  intro ν hν
  obtain ⟨μ, hμ, hA⟩ := h ν hν
  exact ⟨μ, hμ, hAB μ hA⟩

/-! ## The window response — hop prefix, two coupled pieces, region owed -/

theorem respondX (l m : ℕ) (hl : l < 1) (hm : m < 1) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdX l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 1)
    {σ : State (Var 3)}
    (hσE : Formula.sat (Formula.and (FM gX (gs9X m)) envX) σ) :
    Formula.sat (faModal (Equiv.refl (Var 3))
      (windowSeg (leftBlock (fLX l)) domLX tgX dt 5)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRX p) (Term.const 1)) domRX))
        ++ [Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX]))
      (Formula.and (Formula.and (FM gX gsX) envX) (regionX m))) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLX l) domLX (FM gX (gs9X m)) envX
    aX dt 5 (htgF9X m) htgenvX
    (path.map (fun p => (⟨fRX p, Term.const 1, domRX⟩ : RepoHop 3)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRX p (hpath p hp), by simp [Term.fv], hdomRX⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRX p)
        (lam := Term.const 1) (domR := domRX) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLX l hl) hdomLX
    (List.replicate 5 (Program.ode (rightBlock (fRX m) (Term.const 1)) domRX))
    (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRX m, Term.const 1, domRX⟩ : RepoHop 3)
        (hfRX m hm) (by simp [Term.fv]) hdomRX (hfLX l hl) hdomLX)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1X l m hl hm dt hdt hv σ' hσ')
    hσE
  rw [show (path.map (fun p => (⟨fRX p, Term.const 1, domRX⟩ : RepoHop 3))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRX p) (Term.const 1)) domRX)
    from by rw [List.map_map]; rfl] at hfa
  have hfa2 : Formula.sat (faModal (Equiv.refl (Var 3))
      (windowSeg (leftBlock (fLX l)) domLX tgX dt 5)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRX p) (Term.const 1)) domRX))
        ++ [Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX,
            Program.ode (rightBlock (fRX m) (Term.const 1)) domRX]))
      (Formula.and (FM gX (gs9X m)) envX)) σ := by
    simpa [List.replicate] using hfa
  refine sat_faModal_monoPost ?_ hfa2
  intro ν hν
  refine ⟨⟨FM_drop9X m hν.1, hν.2⟩, ?_⟩
  rw [sat_regionX_iff]
  have hface := (sat_FM_iff gX (gs9X m) ν).mp hν.1 (ceilX m)
    (List.mem_cons_of_mem _ (List.mem_append_right _ (List.mem_singleton.mpr rfl)))
  simp only [ceilX, Term.eval, AOp.interp] at hface
  linarith

/-! ## The step provider — climb to `max(l, q)`, region received and owed -/

theorem HmultiX (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdX 0 0) :
    ∀ P ∈ leftProgsX dt, ∀ (q : ℕ), q < GrX.modes.length → ∀ σ, σ mvX = (q : ℝ) →
      Formula.sat (Formula.and (FM gX gsX) envX) σ → Formula.sat (regionX q) σ →
      ∃ segs : List (ℕ × RMode (Var 3) × REdge (Var 3)),
        (∀ s ∈ segs, GrX.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrX.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 3)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (Formula.and (FM gX gsX) envX)
            (regionX (qfOf segs q)))) σ := by
  intro P hP q hq σ hmv hσ hreg
  have hq1 : q < 1 := by simpa [GrX] using hq
  interval_cases q
  have hstep : ∀ (a b : ℕ × RMode (Var 3) × REdge (Var 3)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 3) × REdge (Var 3)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  have hself : GrX.modeAt 0 = some (modeX 0) ∧ edgeX 0 0 ∈ GrX.edgesFrom 0 :=
    ⟨GrX_modeAt 0 (by norm_num), edgeX_mem 0 0 (by simp [GrX])⟩
  have henr : Formula.sat (Formula.and (FM gX (gs9X 0)) envX) σ :=
    ⟨FM_add9X 0 hσ.1 ((sat_regionX_iff 0 σ).mp hreg), hσ.2⟩
  simp only [leftProgsX, leftDataX, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have hgate : ∀ (l : ℕ) (R : Program (Var 3)) (ψ : Formula (Var 3)),
      Formula.sat (faModal (Equiv.refl (Var 3))
        (windowSeg (leftBlock (fLX l)) domLX tgX dt 5) R ψ) σ →
      Formula.sat (faModal (Equiv.refl (Var 3))
        (gwindowSeg Formula.tt (leftBlock (fLX l)) domLX tgX dt 5) R ψ) σ := by
    intro l R ψ hbody
    refine faModal_seqL _ _ _ _ _ _ ?_
    rw [sat_box]
    intro ν hν
    rw [sem_test] at hν
    obtain ⟨rfl, -⟩ := hν
    exact hbody
  subst hP
  refine ⟨[(0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0),
      (0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0)], ?_, ?_, ?_, ?_⟩
  · intro s hs
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl | rfl | rfl | rfl <;> exact hself
  · exact (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (hstep _ _ _ rfl (by simp)))))
  · exact fun s hs => by rw [hhead1 _ _ _ hs]
  · have := respondX 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) henr
    have hq0 : qfOf [(0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0),
        (0, modeX 0, edgeX 0 0), (0, modeX 0, edgeX 0 0)] 0 = 0 := rfl
    rw [hq0]
    exact hgate 0 _ _ (by simpa [modeX, List.replicate] using this)

/-- **`rover_tier_r1`, modal Theorem 3** — the region-carrying chain at
the tool's λ = 17/10: each right mode's checked-cut ceiling `v_R ≤ c_m` rides the
loop invariant as its region (`mvRegionR`), the six climb verdict packs carry the
face first so every later component sees the ceiling, and the response climbs to
`max(window, start)` before running two coupled pieces. Residuals: six 5-query
stratified packs. -/
theorem rover_tier_r1_modal (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdX 0 0) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsX dt))
      (rightAutomatonBody GrX mvX)
      (RFormula.and (RFormula.and (canonInvM gX gsX) (envLR domLX domRX))
        (mvRegionR mvX regionX GrX.modes.length))) := by
  refine theorem3_faithful_multiR_LR GrX mvX (FM gX gsX) domLX domRX regionX
    (leftProgsX dt) (canonInvM gX gsX) (encode_canonInvM gX gsX) ?_ ?_ ?_
  · refine sides_disjoint 0 1 0 (by decide) (by decide) ?_ ?_
    · refine vars_bigChoice_sub _ _ ?_
      intro p hp
      simp only [leftProgsX, List.mem_map] at hp
      obtain ⟨d, hd, rfl⟩ := hp
      exact vars_gwindowSegL_sub d.1 d.2.1 d.2.2.1 1 dt d.2.2.2 (hLX d hd).1
        (hLX d hd).2.1 (hLX d hd).2.2
    · intro x hx
      rw [Program.rename_refl] at hx
      rcases vars_bodyU_sub GrX _ httX hRvX hx with hx | hx
      · exact Or.inl (Set.mem_insert_iff.mpr (Or.inl (Set.mem_singleton_iff.mp hx)))
      · exact Or.inr hx
  · exact hstep_assembled_multiR GrX mvX (FM gX gsX) envX regionX
      (leftProgsX dt) hmvFX hmvenvX hmvregX hfreshX httX hltX (hframesX dt)
      (HmultiX dt hdt hv00)
  · exact hddF_multiR GrX 0 1 dt leftDataX regionX (canonInvM gX gsX) domLX domRX
