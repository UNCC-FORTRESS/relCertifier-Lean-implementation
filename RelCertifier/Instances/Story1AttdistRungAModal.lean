        linarith
      have hfin1 : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))|
          * |x (Rv 0) - y (Rv 0)| ≤ 9 * dist x y :=
