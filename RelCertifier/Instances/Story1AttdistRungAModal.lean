/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdD (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gD :: gsD).length),
    z3solve (flowQuery ⟨(gD :: gsD)[i], fLD l, fRD m, Term.const (1),
      strataDomHost (Formula.and domLD domRD) ((gD :: gsD).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gD :: gsD)[i], fLD l, fRD m, Term.const (1),
      strataDomHost (Formula.and domLD domRD) ((gD :: gsD).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gD :: gsD)[i], fLD l, fRD m, Term.const (1),
      strataDomHost (Formula.and domLD domRD) ((gD :: gsD).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleD (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdD l m) :
    ∀ σ', Formula.sat (Formula.and (FM gD gsD) envD) σ' → σ' tgD = 0 →
      faModalB (Equiv.refl (Var 8))
        (Program.ode (DLCalTiming.clk tgD (leftBlock (fLD l))) domLD)
        (Program.ode (rightBlock (fRD m) (Term.const (1))) domRD)
        (Formula.and (FM gD gsD) envD) tgD dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgD (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgD
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLD l) (fRD m) (Term.const (1))
    (Formula.and domLD domRD) (gD :: gsD) hv
  have hboxes : ∀ g' ∈ gD :: gsD, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLD l) ++ rightBlock (fRD m) (Term.const (1)))
      (Formula.and domLD domRD)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gD gsD σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gD gsD (fLD l) (fRD m)
    (Term.const (1)) domLD domRD tgD dt
    (LR_blocks_disjoint _ _ _ (hfLD l hl) (hfRD m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLD hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRD hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLD l) _ h
      exact aux_ne_Lv aD i hi)
    (fun h => aux_notin_range_Lv aD (leftBlock_readVars_sub (fLD l) (hfLD l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRD m) (Term.const (1)) _ h
      exact aux_ne_Rv aD i hi)
    (fun h => aux_notin_range_Rv aD (rightBlock_readVars_sub (fRD m)
      (Term.const (1)) (hfRD m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aD (rightBlock_boundSet_sub (fRD m)
      (Term.const (1)) h))
    (fun h => aux_notin_range_Lv aD (hdomLD h))
    (fun h => aux_notin_range_Rv aD (hdomRD h))
    htgg hboxes
    (esD l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLD ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRD μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLD μ := by
    rwa [(Formula.coincidence domLD (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLD hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRD m) (Term.const (1)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLD μ ↔ Formula.sat domLD ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1D (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdD l m) :
    ∀ σ, Formula.sat (Formula.and (FM gD gsD) envD) σ →
      faModalB (Equiv.refl (Var 8))
        (Program.ode (DLCalTiming.clk tgD (leftBlock (fLD l))) domLD)
        (Program.ode (rightBlock (fRD m) (Term.const 1)) domRD) (Formula.and (FM gD gsD) envD) tgD dt
        (Function.update σ tgD 0) := by
  intro σ hσ
  have htgφ : tgD ∉ (Formula.and (FM gD gsD) envD).fv := by
    intro h
    rcases h with h | h
    · exact htgFD h
    · exact htgenvD h
  have hupdφ : Formula.sat (Formula.and (FM gD gsD) envD)
      (Function.update σ tgD 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gD gsD) envD) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gD gsD) envD) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleD l m hl hm dt hdt hv
    (Function.update σ tgD 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (1) 1 (by norm_num) one_pos hsem

/-! ## The window response (1 pieces at the in-place mode) -/

theorem respondD (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdD l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 8)}
    (hσ : Formula.sat (Formula.and (FM gD gsD) envD) σ) :
    Formula.sat (faModal (Equiv.refl (Var 8))
      (windowSeg (leftBlock (fLD l)) domLD tgD dt 1)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRD p) (Term.const 1)) domRD))
        ++ [Program.ode (rightBlock (fRD m) (Term.const 1)) domRD]))
      (Formula.and (FM gD gsD) envD)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLD l) domLD (FM gD gsD) envD
    aD dt 1 htgFD htgenvD
    (path.map (fun p => (⟨fRD p, Term.const 1, domRD⟩ : RepoHop 8)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRD p (hpath p hp), by simp [Term.fv], hdomRD⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRD p)
        (lam := Term.const 1) (domR := domRD) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLD l hl) hdomLD
    (List.replicate 1 (Program.ode (rightBlock (fRD m) (Term.const 1)) domRD)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRD m, Term.const 1, domRD⟩ : RepoHop 8)
        (hfRD m hm) (by simp [Term.fv]) hdomRD (hfLD l hl) hdomLD)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1D l m hl hm dt hdt hv σ' hσ')
    hσ
  rw [show (path.map (fun p => (⟨fRD p, Term.const 1, domRD⟩ : RepoHop 8))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRD p) (Term.const 1)) domRD)
    from by rw [List.map_map]; rfl] at hfa
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiD (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdD 0 0) (hv01 : VerdD 0 1) (hv02 : VerdD 0 2) (hv10 : VerdD 1 0) (hv11 : VerdD 1 1) (hv12 : VerdD 1 2) (hv20 : VerdD 2 0) (hv21 : VerdD 2 1) (hv22 : VerdD 2 2) :
    ∀ P ∈ leftProgsD dt, ∀ (q : ℕ), q < GrD.modes.length → ∀ σ, σ mvD = (q : ℝ) →
      Formula.sat (Formula.and (FM gD gsD) envD) σ →
      ∃ segs : List (ℕ × RMode (Var 8) × REdge (Var 8)),
        (∀ s ∈ segs, GrD.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrD.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 8)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gD gsD) envD)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrD] using hq
  have hself : GrD.modeAt q = some (modeD q) ∧ edgeD q q ∈ GrD.edgesFrom q := by
    refine ⟨GrD_modeAt q hq3, edgeD_mem q q ?_⟩
    interval_cases q <;> simp [GrD]
  have hstep : ∀ (a b : ℕ × RMode (Var 8) × REdge (Var 8)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 8) × REdge (Var 8)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsD, leftDataD, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeD st tgt ∈ GrD.edges →
      GrD.modeAt st = some (modeD st) ∧ edgeD st tgt ∈ GrD.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrD_modeAt st hs, edgeD_mem st tgt he⟩
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeD 0, edgeD 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(1, modeD 1, edgeD 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(2, modeD 2, edgeD 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(0, modeD 0, edgeD 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 1 0 (by norm_num) (by norm_num) dt hdt hv10 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(1, modeD 1, edgeD 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(2, modeD 2, edgeD 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(0, modeD 0, edgeD 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 2 0 (by norm_num) (by norm_num) dt hdt hv20 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(1, modeD 1, edgeD 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 2 1 (by norm_num) (by norm_num) dt hdt hv21 [] (by simp) hσ
      simpa [modeD, List.replicate] using this
  · refine ⟨[(2, modeD 2, edgeD 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrD])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondD 2 2 (by norm_num) (by norm_num) dt hdt hv22 [] (by simp) hσ
      simpa [modeD, List.replicate] using this

/-- **`story1_attdist_rung_a_6to8`, modal Theorem 3** (λ = 1, k = 1). -/
theorem story1_attdist_rung_a_modal (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdD 0 0) (hv01 : VerdD 0 1) (hv02 : VerdD 0 2) (hv10 : VerdD 1 0) (hv11 : VerdD 1 1) (hv12 : VerdD 1 2) (hv20 : VerdD 2 0) (hv21 : VerdD 2 1) (hv22 : VerdD 2 2) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsD dt))
      (rightAutomatonBody GrD mvD)
      (RFormula.and (RFormula.and (canonInvM gD gsD) (envLR domLD domRD))
        (mvValidR mvD GrD.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrD mvD (FM gD gsD) domLD domRD
    (leftProgsD dt) (canonInvM gD gsD) (encode_canonInvM gD gsD) ?_ ?_ ?_
  · exact hdis_multi GrD 0 1 dt leftDataD (by decide) httD hRvD hLD
  · exact hstep_assembled_multiF GrD mvD (FM gD gsD) envD (leftProgsD dt)
      hmvFD hmvenvD hfreshD httD hltD (hframesD dt)
      (HmultiD dt hdt hv00 hv01 hv02 hv10 hv11 hv12 hv20 hv21 hv22)
  · exact hddF_multiE GrD 0 1 dt leftDataD (canonInvM gD gsD) domLD domRD
      (by decide) httD hRvD hLD
      (canonInvM_varsL gD gsD (by
        intro g' hg'
        simp only [gD, gsD, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gD gsD) hdomLD hdomRD

