theorem hfbnd_D (q : ℕ) (hq : q < 3) (ν : State (Var 8))
    (hν : ∀ gT' ∈ gsSD, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
      ‖odeField (jointSys (fun _ => Term.const 0) (fRD q) (Term.const (1))) x‖
        ≤ ((60:NNReal) : ℝ) := by
  have hne : ∀ (a b : Fin 8), a ≠ b → (Rv a : Var 8) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  intro x hx
  rw [Metric.mem_closedBall] at hx
  have hbandf : ∀ (j : Fin 8) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -2 ≤ lo → hi ≤ 2 → |x (Rv j)| ≤ 3 := by
    intro j lo hi hl hh hlo1 hhi1
    have h := dist_le_pi_dist x ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 2 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (x (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hx]
  have hxb0 : |x (Rv 0)| ≤ 3 := by
    refine hbandf 0 (0) ((4:ℝ)/5) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceVLo (by simp [gsSD])
      simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceVHi (by simp [gsSD])
      simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
  have hxb2 : |x (Rv 2)| ≤ 3 := by
    refine hbandf 2 (-(1:ℝ)/2) ((3:ℝ)/20) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν facePsiLo (by simp [gsSD])
      simp only [facePsiLo, Term.eval, AOp.interp] at this; linarith
    · have := hν facePsiHi (by simp [gsSD])
      simp only [facePsiHi, Term.eval, AOp.interp] at this; linarith
  have hxb4 : |x (Rv 4)| ≤ 3 := by
    refine hbandf 4 (-(1:ℝ)/2) ((3:ℝ)/20) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceThLo (by simp [gsSD])
      simp only [faceThLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceThHi (by simp [gsSD])
      simp only [faceThHi, Term.eval, AOp.interp] at this; linarith
  have hxb6 : |x (Rv 6)| ≤ 3 := by
    refine hbandf 6 (-(1:ℝ)) ((3:ℝ)/20) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν faceZLo (by simp [gsSD])
      simp only [faceZLo, Term.eval, AOp.interp] at this; linarith
    · have := hν faceZHi (by simp [gsSD])
      simp only [faceZHi, Term.eval, AOp.interp] at this; linarith
  have hxb7 : |x (Rv 7)| ≤ 3 := by
    refine hbandf 7 (-(1:ℝ)/2) ((3:ℝ)/20) ?_ ?_ (by norm_num) (by norm_num)
    · have := hν facePhLo (by simp [gsSD])
      simp only [facePhLo, Term.eval, AOp.interp] at this; linarith
    · have := hν facePhHi (by simp [gsSD])
      simp only [facePhHi, Term.eval, AOp.interp] at this; linarith
  rw [odeField_RD q hq]
  refine pi_norm_le_iff_of_nonneg (by norm_num) |>.mpr ?_
  intro c
  have hLcoe : ((60:NNReal) : ℝ) = 60 := rfl
  rw [hLcoe]
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcst : 0 ≤ cstD q ∧ cstD q ≤ 1 := by
      interval_cases q <;> norm_num [cstD]
    have hcore : |3 * (cstD q - x (Rv 0))| ≤ 12 := by
      obtain ⟨hcl, hch⟩ := hcst
      rw [abs_le]
      constructor <;> nlinarith [abs_le.mp hxb0]

    nlinarith [hcore, abs_nonneg (3 * (cstD q - x (Rv 0)))]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hBx : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))| ≤ 9 := by
      have h2 : x (Rv 2) * x (Rv 2) ≤ 9 := by nlinarith [abs_le.mp hxb2]
      have h3 : x (Rv 4) * x (Rv 4) ≤ 9 := by nlinarith [abs_le.mp hxb4]
      have h2n : 0 ≤ x (Rv 2) * x (Rv 2) := mul_self_nonneg _
      have h3n : 0 ≤ x (Rv 4) * x (Rv 4) := mul_self_nonneg _
      rw [abs_le]
      constructor <;> nlinarith
    have hcore : |x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))| ≤ 27 := by
      rw [abs_mul]
      nlinarith [abs_nonneg (x (Rv 0)), abs_le.mp hxb0, abs_nonneg ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4)))]

    nlinarith [hcore, abs_nonneg (x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 4) * x (Rv 4))))]
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |-1 * x (Rv 2)| ≤ 3 := by
      rw [abs_mul]
      have habs : |(-1 : ℝ)| = 1 := by norm_num
      rw [habs]
      linarith [abs_le.mp hxb2, abs_nonneg (x (Rv 2))]

    nlinarith [hcore, abs_nonneg (-1 * x (Rv 2))]
  by_cases hc4 : c = Rv 4
  · subst hc4
    simp only [if_neg (hne 4 0 (by decide)), if_neg (hne 4 1 (by decide)), if_neg (hne 4 2 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |-1 * x (Rv 4)| ≤ 3 := by
      rw [abs_mul]
      have habs : |(-1 : ℝ)| = 1 := by norm_num
      rw [habs]
      linarith [abs_le.mp hxb4, abs_nonneg (x (Rv 4))]

    nlinarith [hcore, abs_nonneg (-1 * x (Rv 4))]
  by_cases hc6 : c = Rv 6
  · subst hc6
    simp only [if_neg (hne 6 0 (by decide)), if_neg (hne 6 1 (by decide)), if_neg (hne 6 2 (by decide)), if_neg (hne 6 4 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |-1 * x (Rv 6)| ≤ 3 := by
      rw [abs_mul]
      have habs : |(-1 : ℝ)| = 1 := by norm_num
      rw [habs]
      linarith [abs_le.mp hxb6, abs_nonneg (x (Rv 6))]

    nlinarith [hcore, abs_nonneg (-1 * x (Rv 6))]
  by_cases hc7 : c = Rv 7
  · subst hc7
    simp only [if_neg (hne 7 0 (by decide)), if_neg (hne 7 1 (by decide)), if_neg (hne 7 2 (by decide)), if_neg (hne 7 4 (by decide)), if_neg (hne 7 6 (by decide)), eq_self_iff_true, if_true, if_pos rfl, Real.norm_eq_abs]
    have hcore : |-1 * x (Rv 7)| ≤ 3 := by
      rw [abs_mul]
      have habs : |(-1 : ℝ)| = 1 := by norm_num
      rw [habs]
      linarith [abs_le.mp hxb7, abs_nonneg (x (Rv 7))]

    nlinarith [hcore, abs_nonneg (-1 * x (Rv 7))]
  · simp only [if_neg hc0, if_neg hc1, if_neg hc2, if_neg hc4, if_neg hc6, if_neg hc7]
    norm_num

/-! ## Existence -/

theorem esD (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt) :
    ∀ σ, Formula.sat (Formula.and (FM gD gsD) envD) σ →
      HExistSegB (fLD l) (fRD m) (Term.const (1)) domLD domRD dt
        (Function.update σ tgD 0) := by
  intro σ hσ
  have hR : Formula.sat domRD σ := hσ.2.2
  rw [sat_domRD] at hR
  obtain ⟨hd3l, hd3h, hd5l, hd5h, hd7l, hd7h, hd2l, hd2h, hd1l, hd4l, hd4h, hd0l, hd0h, hd6l, hd6h⟩ := hR
  have hupd : ∀ j : Fin 8, σ (Side.R, j) = Function.update σ tgD 0 (Side.R, j) := by
    intro j
    rw [Function.update_of_ne (by simp [tgD, Prod.ext_iff])]
  have hfS : ∀ gT' ∈ gsSD, Term.eval gT' (Function.update σ tgD 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsSD, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      · first
          | (simp only [faceVLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceVHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [facePsiLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [facePsiHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceThLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceThHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceZLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceZHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [facePhLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [facePhHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  have hfN : ∀ gT' ∈ gsND, Term.eval gT' (Function.update σ tgD 0) ≤ 0 := by
    intro gT' hgT
    simp only [gsND, List.mem_cons, List.not_mem_nil, or_false] at hgT
    rcases hgT with rfl | rfl | rfl | rfl | rfl <;>
      · first
          | (simp only [faceSLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceOPsLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceOPsHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceOThLo, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
          | (simp only [faceOThHi, Term.eval, AOp.interp, Rv]; rw [← hupd]; linarith)
  refine HExistSegB_of_viability_stratified (fLD l) (fRD m) (Term.const (1))
    domLD domRD gsSD [] gsND 0 le_rfl
    (jointSys_wellFormed _ _ _)
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLD l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RD gT' (by
        rcases List.mem_append.mp hgT with h | h
        · exact List.mem_append_left _ h
        · exact absurd h (List.not_mem_nil)) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x hxf hb
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLD l) _ hb
      obtain ⟨j, hj⟩ := faces_fv_RD gT' (List.mem_append_right _ hgT) x hxf
      rw [← hj] at hi
      exact absurd hi (by simp [Lv, Rv, Prod.ext_iff]))
    (by
      intro gT' hgT x _ hface
      exact hbndS_D m hm gT' hgT x hface)
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))
    (by
      intro i hi x hxs _
      exact hbndN_D m hm i hi x hxs)
    (by
      intro x hS hN
      have hS' : ∀ gT' ∈ gsSD, Term.eval gT' x ≤ 0 :=
        fun gT' hgT => hS gT' (List.mem_append_left _ hgT)
      have hb0l : 0 ≤ x (Rv 0) := by
        have := hS' faceVLo (by simp [gsSD])
        simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
      have hb0h : x (Rv 0) ≤ (4:ℝ)/5 := by
        have := hS' faceVHi (by simp [gsSD])
        simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
      have hb2l : -(1:ℝ)/2 ≤ x (Rv 2) := by
        have := hS' facePsiLo (by simp [gsSD])
        simp only [facePsiLo, Term.eval, AOp.interp] at this; linarith
      have hb2h : x (Rv 2) ≤ (3:ℝ)/20 := by
        have := hS' facePsiHi (by simp [gsSD])
        simp only [facePsiHi, Term.eval, AOp.interp] at this; linarith
      have hb4l : -(1:ℝ)/2 ≤ x (Rv 4) := by
