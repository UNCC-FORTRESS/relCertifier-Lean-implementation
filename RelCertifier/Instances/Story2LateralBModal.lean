/-! ## The right graph (one-way chain) -/

noncomputable def modeZ (q : ℕ) : RMode (Var 12) :=
  { sys := rightBlock (fRZ q) (Term.const 1), dom := domRZ, weight := 1 }

def edgeZ (st tgt : ℕ) : REdge (Var 12) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrZ : SearchGraph (Var 12) :=
  { modes := [modeZ 0, modeZ 1, modeZ 2],
    edges := [edgeZ 0 1, edgeZ 0 0, edgeZ 1 2, edgeZ 1 1, edgeZ 2 2] }

theorem GrZ_modeAt (q : ℕ) (hq : q < 3) : GrZ.modeAt q = some (modeZ q) := by
  interval_cases q <;> rfl

theorem httZ : ∀ q, ∀ e ∈ GrZ.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrZ.edges := List.mem_of_mem_filter he
  simp only [GrZ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltZ : ∀ q, ∀ e ∈ GrZ.edgesFrom q, e.tgt < GrZ.modes.length := by
  intro q e he
  have hmem : e ∈ GrZ.edges := List.mem_of_mem_filter he
  simp only [GrZ, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrZ, edgeZ]

theorem hRvZ : ∀ q m, GrZ.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeZ q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrZ] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrZ] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrZ] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrZ])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRZ q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRZ q) (Term.const 1) (hfRZ q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRZ hy

theorem edgeZ_mem : ∀ st tgt, edgeZ st tgt ∈ GrZ.edges →
    edgeZ st tgt ∈ GrZ.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeZ]⟩

theorem hfreshZ : ∀ q m, GrZ.modeAt q = some m →
    mvZ ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvZ q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataZ : List ((Fin 12 → Term (Var 12)) × Formula (Var 12) × ℕ) :=
  [(fLZ 0, domLZ, 1), (fLZ 1, domLZ, 1), (fLZ 2, domLZ, 1)]

noncomputable def leftProgsZ (dt : ℝ) : List (Program (Var 12)) :=
  leftDataZ.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgZ dt d.2.2)

theorem hLZ : ∀ d ∈ leftDataZ, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataZ, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLZ 0 (by norm_num), hdomLZ⟩
  · exact ⟨hfLZ 1 (by norm_num), hdomLZ⟩
  · exact ⟨hfLZ 2 (by norm_num), hdomLZ⟩

theorem hframesZ (dt : ℝ) : ∀ P ∈ leftProgsZ dt, FramesMv P mvZ := by
  intro P hP
  simp only [leftProgsZ, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgZ dt d.2.2 mvZ (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

