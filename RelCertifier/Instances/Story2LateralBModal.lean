    (by intro p hp; exact absurd hp (List.not_mem_nil))
    (by
      intro p hp
      simp only [gsALZ, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl
      · show (0:ℝ) ≤ Function.update σ tgZ 0 (Rv 4)
        rw [← hupd 4]
        linarith
      · show (0:ℝ) ≤ Function.update σ tgZ 0 (Rv 5)
        rw [← hupd 5]
        linarith)
    (by intro gT' hgT; exact absurd hgT (List.not_mem_nil))

/-! ## The route verdicts (stratified-DC over the two components) -/

def VerdZ (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gZ :: gsZ).length),
    z3solve (flowQuery ⟨(gZ :: gsZ)[i], fLZ l, fRZ m, Term.const 1,
      strataDomHost (Formula.and domLZ domRZ) ((gZ :: gsZ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gZ :: gsZ)[i], fLZ l, fRZ m, Term.const 1,
      strataDomHost (Formula.and domLZ domRZ) ((gZ :: gsZ).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gZ :: gsZ)[i], fLZ l, fRZ m, Term.const 1,
      strataDomHost (Formula.and domLZ domRZ) ((gZ :: gsZ).take i)⟩) = Verdict.unsat

/-! ## The certified couplings -/

theorem coupleZ (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdZ l m) :
    ∀ σ', Formula.sat (Formula.and (FM gZ gsZ) envZ) σ' → σ' tgZ = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgZ (leftBlock (fLZ l))) domLZ)
        (Program.ode (rightBlock (fRZ m) (Term.const 1)) domRZ)
        (Formula.and (FM gZ gsZ) envZ) tgZ dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgZ (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgZ
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLZ l) (fRZ m) (Term.const 1)
    (Formula.and domLZ domRZ) (gZ :: gsZ) hv
  have hboxes : ∀ g' ∈ gZ :: gsZ, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLZ l) ++ rightBlock (fRZ m) (Term.const 1))
      (Formula.and domLZ domRZ)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gZ gsZ σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gZ gsZ (fLZ l) (fRZ m)
    (Term.const 1) domLZ domRZ tgZ dt
    (LR_blocks_disjoint _ _ _ (hfLZ l hl) (hfRZ m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLZ hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRZ hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLZ l) _ h
      exact aux_ne_Lv aZ i hi)
    (fun h => aux_notin_range_Lv aZ (leftBlock_readVars_sub (fLZ l) (hfLZ l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRZ m) (Term.const 1) _ h
      exact aux_ne_Rv aZ i hi)
    (fun h => aux_notin_range_Rv aZ (rightBlock_readVars_sub (fRZ m) (Term.const 1)
      (hfRZ m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aZ (rightBlock_boundSet_sub (fRZ m) (Term.const 1) h))
    (fun h => aux_notin_range_Lv aZ (hdomLZ h))
    (fun h => aux_notin_range_Rv aZ (hdomRZ h))
    htgg hboxes
    (esZ l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLZ ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRZ μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLZ μ := by
    rwa [(Formula.coincidence domLZ (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLZ hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRZ m) (Term.const 1) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLZ μ ↔ Formula.sat domLZ ν)]
  exact ⟨hdomLμ, hdomRμ⟩

/-! ## Static hops and the window response -/

theorem static_hopZ (fR : Fin 12 → Term (Var 12)) (lam : Term (Var 12))
    (φ : Formula (Var 12)) (σ : State (Var 12)) (hσφ : Formula.sat φ σ)
    (hdom : Formula.sat (Formula.and domLZ domRZ) σ) :
    ∃ ρ, Program.sem ((⟨fR, lam, domRZ⟩ : RepoHop 12).prog domLZ) σ ρ
      ∧ Formula.sat φ ρ := by
  refine ⟨σ, ⟨0, fun _ => σ, le_refl 0, rfl, rfl, ?_, ?_, ?_⟩, hσφ⟩
  · intro t ht p hp
    have h0 : t = 0 := le_antisymm ht.2 ht.1
    subst h0
    rw [hasDerivWithinAt_iff_tendsto_slope]
    have hempty : (Set.Icc (0:ℝ) 0) \ {0} = (∅ : Set ℝ) := by
      simp [Set.Icc_self]
    rw [hempty, nhdsWithin_empty]
    exact Filter.tendsto_bot
  · intro t ht x hx
    rfl
  · intro t ht
    exact hdom

theorem hops_convZ : ∀ (ps : List ℕ), (∀ p ∈ ps, p < 3) →
    List.Forall₂ (fun p q => ∀ ν μ, Program.sem p ν μ → Program.sem q ν μ)
      (ps.map (fun p => (⟨fRZ p, Term.const 1, domRZ⟩ : RepoHop 12).prog domLZ))
      (ps.map (fun p => Program.ode (rightBlock (fRZ p) (Term.const 1)) domRZ)) := by
  intro ps
  induction ps with
  | nil => intro _; exact List.Forall₂.nil
  | cons a as ih =>
      intro hps
      refine List.Forall₂.cons ?_ (ih (fun p hp => hps p (List.mem_cons_of_mem a hp)))
      intro ν μ hrun
      exact joint_run_toR (hfRZ a (hps a List.mem_cons_self)) (by simp [Term.fv]) hrun

/-- The window response: static hops up the chain, the certified coupling at the
reached mode. -/
theorem respondZ (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdZ l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 12)} (hσ : Formula.sat (Formula.and (FM gZ gsZ) envZ) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLZ l)) domLZ tgZ dt 1)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRZ p) (Term.const 1))
          domRZ))
        ++ [Program.ode (rightBlock (fRZ m) (Term.const 1)) domRZ]))
      (Formula.and (FM gZ gsZ) envZ)) σ := by
  have hfa := Hmulti_window1_prefixedF (fLZ l) domLZ (FM gZ gsZ) envZ aZ dt
    htgFZ htgenvZ
    (path.map (fun p => (⟨fRZ p, Term.const 1, domRZ⟩ : RepoHop 12)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRZ p (hpath p hp), by simp [Term.fv], hdomRZ⟩)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact static_hopZ (fRZ p) (Term.const 1) _ σ' hσ' hσ'.2)
    (hfLZ l hl) hdomLZ
    (Program.ode (rightBlock (fRZ m) (Term.const 1)) domRZ)
    (coupleZ l m hl hm dt hdt hv)
    hσ
  rw [show (path.map (fun p => (⟨fRZ p, Term.const 1, domRZ⟩ : RepoHop 12))).map
      (fun h => h.prog domLZ)
      = path.map (fun p => (⟨fRZ p, Term.const 1, domRZ⟩ : RepoHop 12).prog domLZ)
    from by rw [List.map_map]; rfl] at hfa
  exact sat_faModal_monoR (fun ν μ hrun => sem_bigSeq_mono
    (List.rel_append (hops_convZ path hpath)
      (List.Forall₂.cons (fun _ _ h => h) List.Forall₂.nil)) ν μ hrun) hfa

/-! ## The step provider (in-place at or ahead, climb from behind) -/

theorem HmultiZ (dt : ℝ) (hdt : 0 ≤ dt)
    (hv00 : VerdZ 0 0) (hv01 : VerdZ 0 1) (hv02 : VerdZ 0 2)
    (hv11 : VerdZ 1 1) (hv12 : VerdZ 1 2) (hv22 : VerdZ 2 2) :
    ∀ P ∈ leftProgsZ dt, ∀ (q : ℕ), q < GrZ.modes.length → ∀ σ, σ mvZ = (q : ℝ) →
      Formula.sat (Formula.and (FM gZ gsZ) envZ) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrZ.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrZ.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gZ gsZ) envZ)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrZ] using hq
  have hsingle : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)),
      List.IsChain (fun a b => a.2.2.tgt = b.1) [a] := by
    intro a; simp
  have hstep : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12))
      (b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsZ, leftDataZ, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  -- window STEEP: every start couples in place
  · exact ⟨[(0, modeZ 0, edgeZ 0 0)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 0 (by norm_num), edgeZ_mem 0 0 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(1, modeZ 1, edgeZ 1 1)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 1 (by norm_num), edgeZ_mem 1 1 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(2, modeZ 2, edgeZ 2 2)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 2 (by norm_num), edgeZ_mem 2 2 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp) hσ
        simpa [modeZ] using this)⟩
  -- window MODER: start STEEP climbs, the rest in place
  · exact ⟨[(0, modeZ 0, edgeZ 0 1), (1, modeZ 1, edgeZ 1 1)],
      (by
        intro s hs
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
        rcases hs with rfl | rfl
        · exact ⟨GrZ_modeAt 0 (by norm_num), edgeZ_mem 0 1 (by simp [GrZ])⟩
        · exact ⟨GrZ_modeAt 1 (by norm_num), edgeZ_mem 1 1 (by simp [GrZ])⟩),
      hstep _ _ _ rfl (hsingle _),
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 1 1 (by norm_num) (by norm_num) dt hdt hv11 [0]
          (by intro p hp; rw [List.mem_singleton] at hp; subst hp; norm_num) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(1, modeZ 1, edgeZ 1 1)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 1 (by norm_num), edgeZ_mem 1 1 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(2, modeZ 2, edgeZ 2 2)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 2 (by norm_num), edgeZ_mem 2 2 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp) hσ
        simpa [modeZ] using this)⟩
  -- window FLAT: climb to FLAT from behind, in place at FLAT
  · exact ⟨[(0, modeZ 0, edgeZ 0 1), (1, modeZ 1, edgeZ 1 2), (2, modeZ 2, edgeZ 2 2)],
      (by
        intro s hs
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
        rcases hs with rfl | rfl | rfl
        · exact ⟨GrZ_modeAt 0 (by norm_num), edgeZ_mem 0 1 (by simp [GrZ])⟩
        · exact ⟨GrZ_modeAt 1 (by norm_num), edgeZ_mem 1 2 (by simp [GrZ])⟩
        · exact ⟨GrZ_modeAt 2 (by norm_num), edgeZ_mem 2 2 (by simp [GrZ])⟩),
      hstep _ _ _ rfl (hstep _ _ _ rfl (hsingle _)),
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [0, 1]
          (by
            intro p hp
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
            rcases hp with rfl | rfl <;> norm_num) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(1, modeZ 1, edgeZ 1 2), (2, modeZ 2, edgeZ 2 2)],
      (by
        intro s hs
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
        rcases hs with rfl | rfl
        · exact ⟨GrZ_modeAt 1 (by norm_num), edgeZ_mem 1 2 (by simp [GrZ])⟩
        · exact ⟨GrZ_modeAt 2 (by norm_num), edgeZ_mem 2 2 (by simp [GrZ])⟩),
      hstep _ _ _ rfl (hsingle _),
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [1]
          (by intro p hp; rw [List.mem_singleton] at hp; subst hp; norm_num) hσ
        simpa [modeZ] using this)⟩
  · exact ⟨[(2, modeZ 2, edgeZ 2 2)],
      (by
        intro s hs
        rw [List.mem_singleton] at hs
        subst hs
        exact ⟨GrZ_modeAt 2 (by norm_num), edgeZ_mem 2 2 (by simp [GrZ])⟩),
      hsingle _,
      (fun s hs => by rw [hhead1 _ _ _ hs]),
      (by
        have := respondZ 2 2 (by norm_num) (by norm_num) dt hdt hv22 [] (by simp) hσ
        simpa [modeZ] using this)⟩

/-- **`refinement_ladder_rover_rung1_2to3`, modal Theorem 3** — the first plain
list-invariant instance (multiF chain, climb dispatch, no vacuity). -/
theorem story2_lateral_rung_b_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv00 : VerdZ 0 0) (hv01 : VerdZ 0 1) (hv02 : VerdZ 0 2)
    (hv11 : VerdZ 1 1) (hv12 : VerdZ 1 2) (hv22 : VerdZ 2 2) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsZ dt))
      (rightAutomatonBody GrZ mvZ)
      (RFormula.and (RFormula.and (canonInvM gZ gsZ) (envLR domLZ domRZ))
        (mvValidR mvZ GrZ.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrZ mvZ (FM gZ gsZ) domLZ domRZ (leftProgsZ dt)
    (canonInvM gZ gsZ) (encode_canonInvM gZ gsZ) ?_ ?_ ?_
  · exact hdis_multi GrZ 0 1 dt leftDataZ (by decide) httZ hRvZ hLZ
  · exact hstep_assembled_multiF GrZ mvZ (FM gZ gsZ) envZ (leftProgsZ dt)
      hmvFZ hmvenvZ hfreshZ httZ hltZ (hframesZ dt)
      (HmultiZ dt hdt hv00 hv01 hv02 hv11 hv12 hv22)
  · exact hddF_multiE GrZ 0 1 dt leftDataZ (canonInvM gZ gsZ) domLZ domRZ (by decide)
      httZ hRvZ hLZ
      (canonInvM_varsL gZ gsZ (by
        intro g' hg'
        simp only [gZ, gsZ, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gZ gsZ) hdomLZ hdomRZ


