/-! ## Lipschitz and field bound -/

theorem hLip_Z (q : ℕ) (hq : q < 3) (ν : State (Var 12))
    (hν : ∀ gT' ∈ gsSZ, Term.eval gT' ν ≤ 0) :
    LipschitzOnWith 14 (odeField (jointSys (fun _ => Term.const 0) (fRZ q) (Term.const 1)))
      (Metric.closedBall ν 1) := by
  have hne : ∀ (a b : Fin 12), a ≠ b → (Rv a : Var 12) ≠ Rv b := by
    intro a b hab
    simp [Rv, Prod.ext_iff]
    exact fun h => hab (by exact_mod_cast h)
  rw [lipschitzOnWith_iff_dist_le_mul]
  intro x hx y hy
  rw [Metric.mem_closedBall] at hx hy
  rw [odeField_RZ q hq, odeField_RZ q hq]
  have hdc : ∀ j : Fin 12, |x (Rv j) - y (Rv j)| ≤ dist x y := by
    intro j
    have h := dist_le_pi_dist x y (Rv j)
    rwa [Real.dist_eq] at h
  have hd : (0:ℝ) ≤ dist x y := dist_nonneg
  have hcoe : ((14 : NNReal) : ℝ) = 14 := rfl
  have hdecay : ∀ j : Fin 12, |(-1 * x (Rv j)) - (-1 * y (Rv j))| ≤ 14 * dist x y := by
    intro j
    have hdiff : -1 * x (Rv j) - -1 * y (Rv j) = -(x (Rv j) - y (Rv j)) := by ring
    rw [hdiff, abs_neg]
    nlinarith [hdc j]
  have hband : ∀ (w : State (Var 12)), dist w ν ≤ 1 → ∀ (j : Fin 12) (lo hi : ℝ),
      lo ≤ ν (Rv j) → ν (Rv j) ≤ hi → -1 ≤ lo → hi ≤ 1 → |w (Rv j)| ≤ 2 := by
    intro w hw j lo hi hl hh hlo1 hhi1
    have h := dist_le_pi_dist w ν (Rv j)
    rw [Real.dist_eq] at h
    have hνb : |ν (Rv j)| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
    have h2 := abs_sub_abs_le_abs_sub (w (Rv j)) (ν (Rv j))
    linarith [abs_le.mp hνb, hw]
  have hνp1 : -(1:ℝ)/2 ≤ ν (Rv 2) := by
    have := hν facePsiLo (by simp [gsSZ])
    simp only [facePsiLo, Term.eval, AOp.interp] at this; linarith
  have hνp2 : ν (Rv 2) ≤ (3:ℝ)/20 := by
    have := hν facePsiHi (by simp [gsSZ])
    simp only [facePsiHi, Term.eval, AOp.interp] at this; linarith
  have hνt1 : -(1:ℝ)/2 ≤ ν (Rv 3) := by
    have := hν faceThLo (by simp [gsSZ])
    simp only [faceThLo, Term.eval, AOp.interp] at this; linarith
  have hνt2 : ν (Rv 3) ≤ (3:ℝ)/20 := by
    have := hν faceThHi (by simp [gsSZ])
    simp only [faceThHi, Term.eval, AOp.interp] at this; linarith
  have hνv1 : 0 ≤ ν (Rv 0) := by
    have := hν faceVLo (by simp [gsSZ])
    simp only [faceVLo, Term.eval, AOp.interp] at this; linarith
  have hνv2 : ν (Rv 0) ≤ (4:ℝ)/5 := by
    have := hν faceVHi (by simp [gsSZ])
    simp only [faceVHi, Term.eval, AOp.interp] at this; linarith
  have hyb0 : |y (Rv 0)| ≤ 2 := hband y hy 0 (0) ((4:ℝ)/5) hνv1 hνv2 (by norm_num) (by norm_num)
  have hxb2 : |x (Rv 2)| ≤ 2 := hband x hx 2 (-(1:ℝ)/2) ((3:ℝ)/20) hνp1 hνp2 (by norm_num) (by norm_num)
  have hyb2 : |y (Rv 2)| ≤ 2 := hband y hy 2 (-(1:ℝ)/2) ((3:ℝ)/20) hνp1 hνp2 (by norm_num) (by norm_num)
  have hxb3 : |x (Rv 3)| ≤ 2 := hband x hx 3 (-(1:ℝ)/2) ((3:ℝ)/20) hνt1 hνt2 (by norm_num) (by norm_num)
  have hyb3 : |y (Rv 3)| ≤ 2 := hband y hy 3 (-(1:ℝ)/2) ((3:ℝ)/20) hνt1 hνt2 (by norm_num) (by norm_num)
  refine dist_pi_le_iff (by positivity) |>.mpr ?_
  intro c
  by_cases hc0 : c = Rv 0
  · subst hc0
    simp only [eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq]
    have hdiff : 3 * (cstZ q - x (Rv 0)) - 3 * (cstZ q - y (Rv 0))
        = -3 * (x (Rv 0) - y (Rv 0)) := by ring
    rw [hdiff, abs_mul]
    have habs : |(-3 : ℝ)| = 3 := by norm_num
    rw [habs, hcoe]
    nlinarith [hdc 0]
  by_cases hc1 : c = Rv 1
  · subst hc1
    simp only [if_neg (hne 1 0 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
    rw [Real.dist_eq, hcoe]
    have hdiff : x (Rv 0) * ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3)))
        - y (Rv 0) * ((1 - 1/2 * (y (Rv 2) * y (Rv 2))) - 3/10 * (y (Rv 3) * y (Rv 3)))
        = ((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3)))
            * (x (Rv 0) - y (Rv 0))
          + y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
              - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3)))) := by
      ring
    rw [hdiff]
    have hBx : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3))|
        ≤ 5 := by
      have h2 : x (Rv 2) * x (Rv 2) ≤ 4 := by nlinarith [abs_le.mp hxb2]
      have h3 : x (Rv 3) * x (Rv 3) ≤ 4 := by nlinarith [abs_le.mp hxb3]
      have h2n : 0 ≤ x (Rv 2) * x (Rv 2) := mul_self_nonneg _
      have h3n : 0 ≤ x (Rv 3) * x (Rv 3) := mul_self_nonneg _
      rw [abs_le]
      constructor <;> nlinarith
    have hsum2 : |x (Rv 2) + y (Rv 2)| ≤ 4 := by
      calc |x (Rv 2) + y (Rv 2)| ≤ |x (Rv 2)| + |y (Rv 2)| := abs_add_le _ _
        _ ≤ 4 := by linarith [abs_le.mp hxb2, abs_le.mp hyb2]
    have hsum3 : |x (Rv 3) + y (Rv 3)| ≤ 4 := by
      calc |x (Rv 3) + y (Rv 3)| ≤ |x (Rv 3)| + |y (Rv 3)| := abs_add_le _ _
        _ ≤ 4 := by linarith [abs_le.mp hxb3, abs_le.mp hyb3]
    have hA : |(x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2))| ≤ 4 * dist x y := by
      rw [abs_mul]
      nlinarith [hdc 2, abs_nonneg (x (Rv 2) + y (Rv 2)), abs_nonneg (x (Rv 2) - y (Rv 2))]
    have hB : |(x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))| ≤ 4 * dist x y := by
      rw [abs_mul]
      nlinarith [hdc 3, abs_nonneg (x (Rv 3) + y (Rv 3)), abs_nonneg (x (Rv 3) - y (Rv 3))]
    have htri : |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
          - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))))|
        ≤ 4 * dist x y := by
      have e1 : |(-(1/2) : ℝ) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))|
          ≤ 1/2 * (4 * dist x y) := by
        rw [abs_mul]
        have h : |(-(1/2) : ℝ)| = 1/2 := by norm_num
        rw [h]
        nlinarith [abs_nonneg ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))]
      have e2 : |((3:ℝ)/10) * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3)))|
          ≤ 3/10 * (4 * dist x y) := by
        rw [abs_mul]
        have h : |((3:ℝ)/10)| = 3/10 := by norm_num
        rw [h]
        nlinarith [abs_nonneg ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3)))]
      have hsub : |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
            - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))))|
          ≤ |(-(1/2) : ℝ) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))|
            + |((3:ℝ)/10) * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3)))| := by
        rw [sub_eq_add_neg]
        refine (abs_add_le _ _).trans ?_
        rw [abs_neg]
      linarith
    calc |((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3)))
            * (x (Rv 0) - y (Rv 0))
          + y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
              - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))))|
        ≤ |((1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3)))
            * (x (Rv 0) - y (Rv 0))|
          + |y (Rv 0) * (-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
              - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))))| :=
          abs_add_le _ _
      _ ≤ ((14 : NNReal) : ℝ) * dist x y := by
          rw [abs_mul, abs_mul, hcoe]
          have e1 : |(1 - 1/2 * (x (Rv 2) * x (Rv 2))) - 3/10 * (x (Rv 3) * x (Rv 3))|
              * |x (Rv 0) - y (Rv 0)| ≤ 5 * dist x y :=
            mul_le_mul hBx (hdc 0) (abs_nonneg _) (by norm_num)
          have e2 : |y (Rv 0)| * |(-(1/2) * ((x (Rv 2) + y (Rv 2)) * (x (Rv 2) - y (Rv 2)))
                - 3/10 * ((x (Rv 3) + y (Rv 3)) * (x (Rv 3) - y (Rv 3))))|
              ≤ 2 * (4 * dist x y) :=
            mul_le_mul hyb0 htri (abs_nonneg _) (by norm_num)
          linarith
  by_cases hc2 : c = Rv 2
  · subst hc2
    simp only [if_neg (hne 2 0 (by decide)), if_neg (hne 2 1 (by decide)), eq_self_iff_true, if_true, if_pos rfl]
