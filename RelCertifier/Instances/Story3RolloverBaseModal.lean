theorem hfbnd_B (q : ℕ) (hq : q < 3) (ν : State (Var 12))
    (hν : ∀ gT' ∈ gsSB, Term.eval gT' ν ≤ 0) :
    ∀ x ∈ Metric.closedBall ν 1,
