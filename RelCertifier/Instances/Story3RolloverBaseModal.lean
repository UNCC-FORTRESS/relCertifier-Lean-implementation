def vsB : List String := ["v", "s", "psi", "omega_psi", "theta_p", "omega_theta", "e", "r", "phi_r", "omega_phi", "z", "y"]
def dummyB : Parse.PMode := ⟨"", [], .tt, .tt, []⟩
def mLB (l : ℕ) : Parse.PMode := story3_rollover_base_12dof_IR.L.modes.getD l dummyB
def mRB (q : ℕ) : Parse.PMode := story3_rollover_base_12dof_IR.R.modes.getD q dummyB

abbrev mvB : Var 12 := (Side.Aux, 0)
abbrev aB : Fin 12 := (1 : Fin 12)
abbrev tgB : Var 12 := (Side.Aux, aB)

noncomputable def fLB (l : ℕ) : Fin 12 → Term (Var 12) := hostDyn vsB 12 Side.L (mLB l)
noncomputable def fRB (q : ℕ) : Fin 12 → Term (Var 12) := hostDyn vsB 12 Side.R (mRB q)
noncomputable def domLB : Formula (Var 12) := hostEvolve vsB 12 Side.L (mLB 0)
noncomputable def domRB : Formula (Var 12) := hostEvolve vsB 12 Side.R (mRB 0)
noncomputable def envB : Formula (Var 12) := Formula.and domLB domRB

def atomsOf : Parse.PForm → List Parse.PForm
  | .and x y => atomsOf x ++ atomsOf y
  | f => [f]

def invBPF : Parse.PForm :=
  (story3_rollover_base_12dof_IR.invariants.getD 0 ("", Parse.PForm.tt)).2

noncomputable def gAt (i : ℕ) : Term (Var 12) :=
  ((Run.invToG vsB 12 ((atomsOf invBPF).getD i .tt)).map ITerm.toHost).getD (Term.const 0)

noncomputable def gB : Term (Var 12) := gAt 0
noncomputable def gsB : List (Term (Var 12)) := [gAt 1, gAt 2, gAt 3, gAt 4]

/-! ## Side-splits -/

theorem fLB_pipe (l : ℕ) (i : Fin 12) : fLB l i =
    (((some (mLB l)).bind (Run.dynOf vsB 12 Side.L)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem fRB_pipe (q : ℕ) (i : Fin 12) : fRB q i =
    (((some (mRB q)).bind (Run.dynOf vsB 12 Side.R)).map
      (fun f => ITerm.toHost (f i))).getD (Term.const 0) := rfl
theorem domLB_pipe : domLB =
    (((some (mLB 0)).bind (fun m => Run.lowerF vsB 12 Side.L m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl
theorem domRB_pipe : domRB =
    (((some (mRB 0)).bind (fun m => Run.lowerF vsB 12 Side.R m.evolve)).map
      IForm.toHost).getD Formula.tt := rfl

theorem hfLB (l : ℕ) (hl : l < 3) : ∀ i, (fLB l i).fv ⊆ range Lv := fun i x hx =>
  side_eq_L_mem (field_pipeline_side (resolvesTo_L vsB) (some (mLB l))
    (by interval_cases l <;>
      simp [mLB, story3_rollover_base_12dof_IR, Parse.PExpr.namesFree]) i x
    (fLB_pipe l i ▸ hx))

theorem hfRB (q : ℕ) (hq : q < 3) : ∀ i, (fRB q i).fv ⊆ range Rv := fun i x hx =>
  side_eq_R_mem (field_pipeline_side (resolvesTo_R vsB) (some (mRB q))
    (by interval_cases q <;>
      simp [mRB, story3_rollover_base_12dof_IR, Parse.PExpr.namesFree]) i x
    (fRB_pipe q i ▸ hx))

theorem hdomLB : domLB.fv ⊆ range Lv := fun x hx =>
  side_eq_L_mem (form_pipeline_side (resolvesTo_L vsB) (some (mLB 0))
    (by simp [mLB, story3_rollover_base_12dof_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domLB_pipe ▸ hx))

theorem hdomRB : domRB.fv ⊆ range Rv := fun x hx =>
  side_eq_R_mem (form_pipeline_side (resolvesTo_R vsB) (some (mRB 0))
    (by simp [mRB, story3_rollover_base_12dof_IR, Parse.PForm.namesFree,
      Parse.PExpr.namesFree]) x (domRB_pipe ▸ hx))

theorem hgAt (i : ℕ) : (gAt i).fv ⊆ range Lv ∪ range Rv := invToG_pipeline_LR _

theorem hmvg : ∀ g' ∈ gB :: gsB, mvB ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gB, gsB, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl | rfl | rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem htgg : ∀ g' ∈ gB :: gsB, tgB ∉ g'.fv := by
  intro g' hg' h
  have hLR : g'.fv ⊆ range Lv ∪ range Rv := by
    simp only [gB, gsB, List.mem_cons, List.not_mem_nil, or_false] at hg'
    rcases hg' with rfl | rfl | rfl | rfl | rfl <;> exact hgAt _
  rcases hLR h with ⟨i, hi⟩ | ⟨i, hi⟩ <;> exact absurd hi (by simp [Lv, Rv, Prod.ext_iff])

theorem hmvFB : mvB ∉ (FM gB gsB).fv := notMem_FM_fv hmvg
theorem htgFB : tgB ∉ (FM gB gsB).fv := notMem_FM_fv htgg

theorem hmvenvB : mvB ∉ envB.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLB h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRB h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))
theorem htgenvB : tgB ∉ envB.fv := fun h => by
  rcases h with h | h
  · exact absurd (hdomLB h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Lv, Prod.ext_iff]))
  · exact absurd (hdomRB h) (by rintro ⟨i, hi⟩; exact absurd hi (by simp [Rv, Prod.ext_iff]))

/-! ## The right graph (one-way chain) -/

noncomputable def modeB (q : ℕ) : RMode (Var 12) :=
  { sys := rightBlock (fRB q) (Term.const 1), dom := domRB, weight := 1 }

def edgeB (st tgt : ℕ) : REdge (Var 12) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrB : SearchGraph (Var 12) :=
  { modes := [modeB 0, modeB 1, modeB 2],
    edges := [edgeB 0 1, edgeB 0 0, edgeB 1 2, edgeB 1 1, edgeB 2 2] }

theorem GrB_modeAt (q : ℕ) (hq : q < 3) : GrB.modeAt q = some (modeB q) := by
  interval_cases q <;> rfl

theorem httB : ∀ q, ∀ e ∈ GrB.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrB.edges := List.mem_of_mem_filter he
  simp only [GrB, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltB : ∀ q, ∀ e ∈ GrB.edgesFrom q, e.tgt < GrB.modes.length := by
  intro q e he
  have hmem : e ∈ GrB.edges := List.mem_of_mem_filter he
  simp only [GrB, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrB, edgeB]

theorem hRvB : ∀ q m, GrB.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeB q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrB] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrB] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrB] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrB])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRB q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRB q) (Term.const 1) (hfRB q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRB hy

theorem edgeB_mem : ∀ st tgt, edgeB st tgt ∈ GrB.edges →
    edgeB st tgt ∈ GrB.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeB]⟩

theorem hfreshB : ∀ q m, GrB.modeAt q = some m →
    mvB ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvB q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataB : List ((Fin 12 → Term (Var 12)) × Formula (Var 12) × ℕ) :=
  [(fLB 0, domLB, 2), (fLB 1, domLB, 2), (fLB 2, domLB, 2)]

noncomputable def leftProgsB (dt : ℝ) : List (Program (Var 12)) :=
  leftDataB.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgB dt d.2.2)

theorem hLB : ∀ d ∈ leftDataB, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataB, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLB 0 (by norm_num), hdomLB⟩
  · exact ⟨hfLB 1 (by norm_num), hdomLB⟩
  · exact ⟨hfLB 2 (by norm_num), hdomLB⟩

theorem hframesB (dt : ℝ) : ∀ P ∈ leftProgsB dt, FramesMv P mvB := by
  intro P hP
  simp only [leftProgsB, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgB dt d.2.2 mvB (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

