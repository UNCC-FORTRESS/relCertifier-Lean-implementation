/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdB (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gB :: gsB).length),
    z3solve (flowQuery ⟨(gB :: gsB)[i], fLB l, fRB m, Term.const ((5:ℝ)/4),
      strataDomHost (Formula.and domLB domRB) ((gB :: gsB).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gB :: gsB)[i], fLB l, fRB m, Term.const ((5:ℝ)/4),
      strataDomHost (Formula.and domLB domRB) ((gB :: gsB).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gB :: gsB)[i], fLB l, fRB m, Term.const ((5:ℝ)/4),
      strataDomHost (Formula.and domLB domRB) ((gB :: gsB).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleB (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdB l m) :
    ∀ σ', Formula.sat (Formula.and (FM gB gsB) envB) σ' → σ' tgB = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgB (leftBlock (fLB l))) domLB)
        (Program.ode (rightBlock (fRB m) (Term.const ((5:ℝ)/4))) domRB)
        (Formula.and (FM gB gsB) envB) tgB dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgB (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgB
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLB l) (fRB m) (Term.const ((5:ℝ)/4))
    (Formula.and domLB domRB) (gB :: gsB) hv
  have hboxes : ∀ g' ∈ gB :: gsB, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLB l) ++ rightBlock (fRB m) (Term.const ((5:ℝ)/4)))
      (Formula.and domLB domRB)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gB gsB σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gB gsB (fLB l) (fRB m)
    (Term.const ((5:ℝ)/4)) domLB domRB tgB dt
    (LR_blocks_disjoint _ _ _ (hfLB l hl) (hfRB m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLB hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRB hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLB l) _ h
      exact aux_ne_Lv aB i hi)
    (fun h => aux_notin_range_Lv aB (leftBlock_readVars_sub (fLB l) (hfLB l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRB m) (Term.const ((5:ℝ)/4)) _ h
      exact aux_ne_Rv aB i hi)
    (fun h => aux_notin_range_Rv aB (rightBlock_readVars_sub (fRB m)
      (Term.const ((5:ℝ)/4)) (hfRB m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aB (rightBlock_boundSet_sub (fRB m)
      (Term.const ((5:ℝ)/4)) h))
    (fun h => aux_notin_range_Lv aB (hdomLB h))
    (fun h => aux_notin_range_Rv aB (hdomRB h))
    htgg hboxes
    (esB l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLB ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRB μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLB μ := by
    rwa [(Formula.coincidence domLB (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLB hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRB m) (Term.const ((5:ℝ)/4)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLB μ ↔ Formula.sat domLB ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1B (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdB l m) :
    ∀ σ, Formula.sat (Formula.and (FM gB gsB) envB) σ →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgB (leftBlock (fLB l))) domLB)
        (Program.ode (rightBlock (fRB m) (Term.const 1)) domRB) (Formula.and (FM gB gsB) envB) tgB dt
        (Function.update σ tgB 0) := by
  intro σ hσ
  have htgφ : tgB ∉ (Formula.and (FM gB gsB) envB).fv := by
    intro h
    rcases h with h | h
    · exact htgFB h
    · exact htgenvB h
  have hupdφ : Formula.sat (Formula.and (FM gB gsB) envB)
      (Function.update σ tgB 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gB gsB) envB) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gB gsB) envB) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleB l m hl hm dt hdt hv
    (Function.update σ tgB 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam ((5:ℝ)/4) 1 (by norm_num) one_pos hsem

/-! ## The window response (2 pieces at the in-place mode) -/

theorem respondB (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdB l m) {σ : State (Var 12)}
    (hσ : Formula.sat (Formula.and (FM gB gsB) envB) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLB l)) domLB tgB dt 2)
      (bigSeq [Program.ode (rightBlock (fRB m) (Term.const 1)) domRB,
        Program.ode (rightBlock (fRB m) (Term.const 1)) domRB])
      (Formula.and (FM gB gsB) envB)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLB l) domLB (FM gB gsB) envB
    aB dt 2 htgFB htgenvB [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLB l hl) hdomLB
    (List.replicate 2 (Program.ode (rightBlock (fRB m) (Term.const 1)) domRB)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRB m, Term.const 1, domRB⟩ : RepoHop 12)
        (hfRB m hm) (by simp [Term.fv]) hdomRB (hfLB l hl) hdomLB)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1B l m hl hm dt hdt hv σ' hσ')
    hσ
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiB (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : ∀ l m : ℕ, l < 3 → m < 3 → VerdB l m) :
    ∀ P ∈ leftProgsB dt, ∀ (q : ℕ), q < GrB.modes.length → ∀ σ, σ mvB = (q : ℝ) →
      Formula.sat (Formula.and (FM gB gsB) envB) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrB.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrB.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gB gsB) envB)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrB] using hq
  have hself : GrB.modeAt q = some (modeB q) ∧ edgeB q q ∈ GrB.edgesFrom q := by
    refine ⟨GrB_modeAt q hq3, edgeB_mem q q ?_⟩
    interval_cases q <;> simp [GrB]
  have hstep : ∀ (a b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsB, leftDataB, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  refine ⟨[(q, modeB q, edgeB q q), (q, modeB q, edgeB q q)], ?_, ?_, ?_, ?_⟩
  · intro s hs
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl <;> exact hself
  · exact (hstep _ _ _ rfl (by simp))
  · exact fun s hs => by rw [hhead1 _ _ _ hs]
  · rcases hP with rfl | rfl | rfl
    · have := respondB 0 q (by norm_num) hq3 dt hdt (hv 0 q (by norm_num) hq3) hσ
      simpa [modeB] using this
    · have := respondB 1 q (by norm_num) hq3 dt hdt (hv 1 q (by norm_num) hq3) hσ
      simpa [modeB] using this
    · have := respondB 2 q (by norm_num) hq3 dt hdt (hv 2 q (by norm_num) hq3) hσ
      simpa [modeB] using this

/-- **`story3_rollover_base_12dof`, modal Theorem 3** (λ = (5:ℝ)/4, k = 2). -/
theorem story3_rollover_base_modal (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : ∀ l m : ℕ, l < 3 → m < 3 → VerdB l m) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsB dt))
      (rightAutomatonBody GrB mvB)
      (RFormula.and (RFormula.and (canonInvM gB gsB) (envLR domLB domRB))
        (mvValidR mvB GrB.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrB mvB (FM gB gsB) domLB domRB
    (leftProgsB dt) (canonInvM gB gsB) (encode_canonInvM gB gsB) ?_ ?_ ?_
  · exact hdis_multi GrB 0 1 dt leftDataB (by decide) httB hRvB hLB
  · exact hstep_assembled_multiF GrB mvB (FM gB gsB) envB (leftProgsB dt)
      hmvFB hmvenvB hfreshB httB hltB (hframesB dt)
      (HmultiB dt hdt hv)
  · exact hddF_multiE GrB 0 1 dt leftDataB (canonInvM gB gsB) domLB domRB
      (by decide) httB hRvB hLB
      (canonInvM_varsL gB gsB (by
        intro g' hg'
        simp only [gB, gsB, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl | rfl | rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gB gsB) hdomLB hdomRB

end Story3RolloverBaseModal
