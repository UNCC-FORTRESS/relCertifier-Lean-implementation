/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdA (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gA :: gsA).length),
    z3solve (flowQuery ⟨(gA :: gsA)[i], fLA l, fRA m, Term.const ((27:ℝ)/20),
      strataDomHost (Formula.and domLA domRA) ((gA :: gsA).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gA :: gsA)[i], fLA l, fRA m, Term.const ((27:ℝ)/20),
      strataDomHost (Formula.and domLA domRA) ((gA :: gsA).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gA :: gsA)[i], fLA l, fRA m, Term.const ((27:ℝ)/20),
      strataDomHost (Formula.and domLA domRA) ((gA :: gsA).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleA (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdA l m) :
    ∀ σ', Formula.sat (Formula.and (FM gA gsA) envA) σ' → σ' tgA = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgA (leftBlock (fLA l))) domLA)
        (Program.ode (rightBlock (fRA m) (Term.const ((27:ℝ)/20))) domRA)
        (Formula.and (FM gA gsA) envA) tgA dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgA (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgA
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLA l) (fRA m) (Term.const ((27:ℝ)/20))
    (Formula.and domLA domRA) (gA :: gsA) hv
  have hboxes : ∀ g' ∈ gA :: gsA, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLA l) ++ rightBlock (fRA m) (Term.const ((27:ℝ)/20)))
      (Formula.and domLA domRA)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gA gsA σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gA gsA (fLA l) (fRA m)
    (Term.const ((27:ℝ)/20)) domLA domRA tgA dt
    (LR_blocks_disjoint _ _ _ (hfLA l hl) (hfRA m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLA hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRA hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLA l) _ h
      exact aux_ne_Lv aA i hi)
    (fun h => aux_notin_range_Lv aA (leftBlock_readVars_sub (fLA l) (hfLA l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRA m) (Term.const ((27:ℝ)/20)) _ h
      exact aux_ne_Rv aA i hi)
    (fun h => aux_notin_range_Rv aA (rightBlock_readVars_sub (fRA m)
      (Term.const ((27:ℝ)/20)) (hfRA m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aA (rightBlock_boundSet_sub (fRA m)
      (Term.const ((27:ℝ)/20)) h))
    (fun h => aux_notin_range_Lv aA (hdomLA h))
    (fun h => aux_notin_range_Rv aA (hdomRA h))
    htgg hboxes
    (esA l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLA ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRA μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLA μ := by
    rwa [(Formula.coincidence domLA (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLA hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRA m) (Term.const ((27:ℝ)/20)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLA μ ↔ Formula.sat domLA ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1A (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdA l m) :
    ∀ σ, Formula.sat (Formula.and (FM gA gsA) envA) σ →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgA (leftBlock (fLA l))) domLA)
        (Program.ode (rightBlock (fRA m) (Term.const 1)) domRA) (Formula.and (FM gA gsA) envA) tgA dt
        (Function.update σ tgA 0) := by
  intro σ hσ
  have htgφ : tgA ∉ (Formula.and (FM gA gsA) envA).fv := by
    intro h
    rcases h with h | h
    · exact htgFA h
    · exact htgenvA h
  have hupdφ : Formula.sat (Formula.and (FM gA gsA) envA)
      (Function.update σ tgA 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gA gsA) envA) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gA gsA) envA) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleA l m hl hm dt hdt hv
    (Function.update σ tgA 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam ((27:ℝ)/20) 1 (by norm_num) one_pos hsem

/-! ## The window response (2 pieces at the in-place mode) -/

theorem respondA (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdA l m) {σ : State (Var 12)}
    (hσ : Formula.sat (Formula.and (FM gA gsA) envA) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLA l)) domLA tgA dt 2)
      (bigSeq [Program.ode (rightBlock (fRA m) (Term.const 1)) domRA,
        Program.ode (rightBlock (fRA m) (Term.const 1)) domRA])
      (Formula.and (FM gA gsA) envA)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLA l) domLA (FM gA gsA) envA
    aA dt 2 htgFA htgenvA [] (by simp) (fun σ' hσ' => hσ'.2.1) (by simp)
    (hfLA l hl) hdomLA
    (List.replicate 2 (Program.ode (rightBlock (fRA m) (Term.const 1)) domRA)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRA m, Term.const 1, domRA⟩ : RepoHop 12)
        (hfRA m hm) (by simp [Term.fv]) hdomRA (hfLA l hl) hdomLA)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1A l m hl hm dt hdt hv σ' hσ')
    hσ
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiA (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : ∀ l m : ℕ, l < 3 → m < 3 → VerdA l m) :
    ∀ P ∈ leftProgsA dt, ∀ (q : ℕ), q < GrA.modes.length → ∀ σ, σ mvA = (q : ℝ) →
      Formula.sat (Formula.and (FM gA gsA) envA) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrA.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrA.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gA gsA) envA)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrA] using hq
  have hself : GrA.modeAt q = some (modeA q) ∧ edgeA q q ∈ GrA.edgesFrom q := by
    refine ⟨GrA_modeAt q hq3, edgeA_mem q q ?_⟩
    interval_cases q <;> simp [GrA]
  have hstep : ∀ (a b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsA, leftDataA, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  refine ⟨[(q, modeA q, edgeA q q), (q, modeA q, edgeA q q)], ?_, ?_, ?_, ?_⟩
  · intro s hs
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl <;> exact hself
  · exact (hstep _ _ _ rfl (by simp))
  · exact fun s hs => by rw [hhead1 _ _ _ hs]
  · rcases hP with rfl | rfl | rfl
    · have := respondA 0 q (by norm_num) hq3 dt hdt (hv 0 q (by norm_num) hq3) hσ
      simpa [modeA] using this
    · have := respondA 1 q (by norm_num) hq3 dt hdt (hv 1 q (by norm_num) hq3) hσ
      simpa [modeA] using this
    · have := respondA 2 q (by norm_num) hq3 dt hdt (hv 2 q (by norm_num) hq3) hσ
      simpa [modeA] using this

/-- **`story3_rollover_ladder_rung_a`, modal Theorem 3** (λ = (27:ℝ)/20, k = 2). -/
