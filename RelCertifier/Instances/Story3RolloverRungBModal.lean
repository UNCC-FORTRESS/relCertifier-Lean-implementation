/-! ## The route verdicts (stratified-DC at the cover's λ) -/

def VerdV (l m : ℕ) : Prop :=
  ∀ i (hi : i < (gV :: gsV).length),
    z3solve (flowQuery ⟨(gV :: gsV)[i], fLV l, fRV m, Term.const (1),
      strataDomHost (Formula.and domLV domRV) ((gV :: gsV).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQueryStrict ⟨(gV :: gsV)[i], fLV l, fRV m, Term.const (1),
      strataDomHost (Formula.and domLV domRV) ((gV :: gsV).take i)⟩) = Verdict.unsat
    ∨ z3solve (flowQuerySuperlevel ⟨(gV :: gsV)[i], fLV l, fRV m, Term.const (1),
      strataDomHost (Formula.and domLV domRV) ((gV :: gsV).take i)⟩) = Verdict.unsat

/-! ## The coupling at λ, and its λ = 1 transport (L7) -/

theorem coupleV (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdV l m) :
    ∀ σ', Formula.sat (Formula.and (FM gV gsV) envV) σ' → σ' tgV = 0 →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgV (leftBlock (fLV l))) domLV)
        (Program.ode (rightBlock (fRV m) (Term.const (1))) domRV)
        (Formula.and (FM gV gsV) envV) tgV dt σ' := by
  intro σ' hσ' htg0
  have hupd : Function.update σ' tgV (0 : ℝ) = σ' := by
    funext x
    by_cases hx : x = tgV
    · subst hx; rw [Function.update_self]; exact htg0.symm
    · rw [Function.update_of_ne hx]
  have hAll := segPresAll_from_strata_verdicts' (fLV l) (fRV m) (Term.const (1))
    (Formula.and domLV domRV) (gV :: gsV) hv
  have hboxes : ∀ g' ∈ gV :: gsV, Formula.sat (Formula.box (Program.ode
      (leftBlock (fLV l) ++ rightBlock (fRV m) (Term.const (1)))
      (Formula.and domLV domRV)) (invLe g')) σ' := by
    intro g' hg'
    rw [sat_box]
    intro ω hω
    rw [sat_invLe]
    refine hAll σ' ?_ ω (by rw [← jointSys_split] at hω; exact hω) g' hg'
    intro g hg
    exact (sat_FM_iff gV gsV σ').mp hσ'.1 g hg
  have hbase := segment_faModalB_from_certB_list gV gsV (fLV l) (fRV m)
    (Term.const (1)) domLV domRV tgV dt
    (LR_blocks_disjoint _ _ _ (hfLV l hl) (hfRV m hm) (by simp [Term.fv]))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomLV hv'
      exact Lv_mem_leftBlock_boundSet _ i))
    (fun v hv' => Or.inl (by
      obtain ⟨i, rfl⟩ := hdomRV hv'
      exact Rv_mem_rightBlock_boundSet _ _ i))
    (fun h => by
      obtain ⟨i, hi⟩ := leftBlock_bound_sub (fLV l) _ h
      exact aux_ne_Lv aV i hi)
    (fun h => aux_notin_range_Lv aV (leftBlock_readVars_sub (fLV l) (hfLV l hl) h))
    (fun h => by
      obtain ⟨i, hi⟩ := rightBlock_bound_sub (fRV m) (Term.const (1)) _ h
      exact aux_ne_Rv aV i hi)
    (fun h => aux_notin_range_Rv aV (rightBlock_readVars_sub (fRV m)
      (Term.const (1)) (hfRV m hm) (by simp [Term.fv]) h))
    (fun h => aux_notin_range_Rv aV (rightBlock_boundSet_sub (fRV m)
      (Term.const (1)) h))
    (fun h => aux_notin_range_Lv aV (hdomLV h))
    (fun h => aux_notin_range_Rv aV (hdomRV h))
    htgg hboxes
    (esV l m hl hm dt hdt σ' hσ')
  rw [hupd] at hbase
  refine faModalB_strengthen_plant ?_ hbase
  intro ν μ hplant hsem
  have hdomLν : Formula.sat domLV ν := sem_ode_ends_in_domain hplant.1
  have hdomRμ : Formula.sat domRV μ := sem_ode_ends_in_domain hsem
  have hdomLμ : Formula.sat domLV μ := by
    rwa [(Formula.coincidence domLV (fun v hv' => sem_ode_mask hsem (by
      obtain ⟨i, rfl⟩ := hdomLV hv'
      intro hb
      obtain ⟨j, hj⟩ := rightBlock_bound_sub (fRV m) (Term.const (1)) _ hb
      exact absurd hj (by simp [Lv, Rv, Prod.ext_iff]))) :
        Formula.sat domLV μ ↔ Formula.sat domLV ν)]
  exact ⟨hdomLμ, hdomRμ⟩

theorem couple1V (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdV l m) :
    ∀ σ, Formula.sat (Formula.and (FM gV gsV) envV) σ →
      faModalB (Equiv.refl (Var 12))
        (Program.ode (DLCalTiming.clk tgV (leftBlock (fLV l))) domLV)
        (Program.ode (rightBlock (fRV m) (Term.const 1)) domRV) (Formula.and (FM gV gsV) envV) tgV dt
        (Function.update σ tgV 0) := by
  intro σ hσ
  have htgφ : tgV ∉ (Formula.and (FM gV gsV) envV).fv := by
    intro h
    rcases h with h | h
    · exact htgFV h
    · exact htgenvV h
  have hupdφ : Formula.sat (Formula.and (FM gV gsV) envV)
      (Function.update σ tgV 0) := by
    rwa [(Formula.coincidence (Formula.and (FM gV gsV) envV) (fun v hv' =>
      Function.update_of_ne (fun hc => htgφ (by rw [← hc]; exact hv')) _ _) :
        Formula.sat (Formula.and (FM gV gsV) envV) _ ↔ _)]
  refine faModalB_monoQ ?_ (coupleV l m hl hm dt hdt hv
    (Function.update σ tgV 0) hupdφ (Function.update_self _ _ _))
  intro ν μ hsem
  exact sem_rightBlock_reparam (1) 1 (by norm_num) one_pos hsem

/-! ## The window response (1 pieces at the in-place mode) -/

theorem respondV (l m : ℕ) (hl : l < 3) (hm : m < 3) (dt : ℝ) (hdt : 0 ≤ dt)
    (hv : VerdV l m) (path : List ℕ) (hpath : ∀ p ∈ path, p < 3)
    {σ : State (Var 12)}
    (hσ : Formula.sat (Formula.and (FM gV gsV) envV) σ) :
    Formula.sat (faModal (Equiv.refl (Var 12))
      (windowSeg (leftBlock (fLV l)) domLV tgV dt 1)
      (bigSeq ((path.map (fun p => Program.ode (rightBlock (fRV p) (Term.const 1)) domRV))
        ++ [Program.ode (rightBlock (fRV m) (Term.const 1)) domRV]))
      (Formula.and (FM gV gsV) envV)) σ := by
  have hfa := Hmulti_windowRF_prefixed (fLV l) domLV (FM gV gsV) envV
    aV dt 1 htgFV htgenvV
    (path.map (fun p => (⟨fRV p, Term.const 1, domRV⟩ : RepoHop 12)))
    (by
      intro h hh
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      exact ⟨hfRV p (hpath p hp), by simp [Term.fv], hdomRV⟩)
    (fun σ' hσ' => hσ'.2.1)
    (by
      intro h hh σ' hσ' htg'
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hh
      obtain ⟨ρ, hsem, hρσ⟩ := static_hop_existsR (fR := fRV p)
        (lam := Term.const 1) (domR := domRV) hσ'.2.2
      exact ⟨ρ, hsem, hρσ ▸ hσ'⟩)
    (hfLV l hl) hdomLV
    (List.replicate 1 (Program.ode (rightBlock (fRV m) (Term.const 1)) domRV)) (by simp) (by norm_num)
    (by
      intro Q hQ
      rw [List.eq_of_mem_replicate hQ, Program.rename_refl]
      exact hdisH_progR (⟨fRV m, Term.const 1, domRV⟩ : RepoHop 12)
        (hfRV m hm) (by simp [Term.fv]) hdomRV (hfLV l hl) hdomLV)
    (by
      intro Q hQ σ' hσ'
      rw [List.eq_of_mem_replicate hQ]
      exact couple1V l m hl hm dt hdt hv σ' hσ')
    hσ
  rw [show (path.map (fun p => (⟨fRV p, Term.const 1, domRV⟩ : RepoHop 12))).map
      (fun h => h.progR)
      = path.map (fun p => Program.ode (rightBlock (fRV p) (Term.const 1)) domRV)
    from by rw [List.map_map]; rfl] at hfa
  simpa [List.replicate] using hfa

/-! ## The step provider — every window certifies every mode, so the response
stays in place -/

theorem HmultiV (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdV 0 0) (hv01 : VerdV 0 1) (hv02 : VerdV 0 2) (hv10 : VerdV 1 0) (hv11 : VerdV 1 1) (hv12 : VerdV 1 2) (hv20 : VerdV 2 0) (hv21 : VerdV 2 1) (hv22 : VerdV 2 2) :
    ∀ P ∈ leftProgsV dt, ∀ (q : ℕ), q < GrV.modes.length → ∀ σ, σ mvV = (q : ℝ) →
      Formula.sat (Formula.and (FM gV gsV) envV) σ →
      ∃ segs : List (ℕ × RMode (Var 12) × REdge (Var 12)),
        (∀ s ∈ segs, GrV.modeAt s.1 = some s.2.1 ∧ s.2.2 ∈ GrV.edgesFrom s.1) ∧
        List.IsChain (fun a b => a.2.2.tgt = b.1) segs ∧
        (∀ s, segs.head? = some s → s.1 = q) ∧
        Formula.sat (faModal (Equiv.refl (Var 12)) P
          (bigSeq (segs.map (fun s => Program.ode s.2.1.sys s.2.1.dom)))
          (Formula.and (FM gV gsV) envV)) σ := by
  intro P hP q hq σ hmv hσ
  have hq3 : q < 3 := by simpa [GrV] using hq
  have hself : GrV.modeAt q = some (modeV q) ∧ edgeV q q ∈ GrV.edgesFrom q := by
    refine ⟨GrV_modeAt q hq3, edgeV_mem q q ?_⟩
    interval_cases q <;> simp [GrV]
  have hstep : ∀ (a b : ℕ × RMode (Var 12) × REdge (Var 12)) rest,
      a.2.2.tgt = b.1 → List.IsChain (fun x y => x.2.2.tgt = y.1) (b :: rest) →
      List.IsChain (fun x y => x.2.2.tgt = y.1) (a :: b :: rest) := by
    intro a b rest hab hrest
    refine hrest.cons ?_
    intro y hy
    rw [List.head?_cons, Option.mem_some_iff] at hy
    subst hy
    exact hab
  have hhead1 : ∀ (a : ℕ × RMode (Var 12) × REdge (Var 12)) rest s,
      (a :: rest : List _).head? = some s → s = a := by
    intro a rest s hs
    simpa [List.head?_cons] using hs.symm
  simp only [leftProgsV, leftDataV, List.map_cons, List.map_nil, List.mem_cons,
    List.not_mem_nil, or_false] at hP
  have halign : ∀ st tgt : ℕ, st < 3 → tgt < 3 → edgeV st tgt ∈ GrV.edges →
      GrV.modeAt st = some (modeV st) ∧ edgeV st tgt ∈ GrV.edgesFrom st :=
    fun st tgt hs ht he => ⟨GrV_modeAt st hs, edgeV_mem st tgt he⟩
  rcases hP with rfl | rfl | rfl
  all_goals interval_cases q
  · refine ⟨[(0, modeV 0, edgeV 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 0 0 (by norm_num) (by norm_num) dt hdt hv00 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(1, modeV 1, edgeV 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 0 1 (by norm_num) (by norm_num) dt hdt hv01 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(2, modeV 2, edgeV 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 0 2 (by norm_num) (by norm_num) dt hdt hv02 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(0, modeV 0, edgeV 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 1 0 (by norm_num) (by norm_num) dt hdt hv10 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(1, modeV 1, edgeV 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 1 1 (by norm_num) (by norm_num) dt hdt hv11 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(2, modeV 2, edgeV 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 1 2 (by norm_num) (by norm_num) dt hdt hv12 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(0, modeV 0, edgeV 0 0)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 0 0 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 2 0 (by norm_num) (by norm_num) dt hdt hv20 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(1, modeV 1, edgeV 1 1)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 1 1 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 2 1 (by norm_num) (by norm_num) dt hdt hv21 [] (by simp) hσ
      simpa [modeV, List.replicate] using this
  · refine ⟨[(2, modeV 2, edgeV 2 2)], ?_, ?_, ?_, ?_⟩
    · intro s hs
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hs
      rcases hs with rfl
      · exact halign 2 2 (by norm_num) (by norm_num) (by simp [GrV])
    · simp
    · exact fun s hs => by rw [hhead1 _ _ _ hs]
    · have := respondV 2 2 (by norm_num) (by norm_num) dt hdt hv22 [] (by simp) hσ
      simpa [modeV, List.replicate] using this

/-- **`story3_rollover_ladder_rung_b`, modal Theorem 3** (λ = 1, k = 1). -/
theorem story3_rollover_rung_b_modal (dt : ℝ) (hdt : 0 ≤ dt) (hv00 : VerdV 0 0) (hv01 : VerdV 0 1) (hv02 : VerdV 0 2) (hv10 : VerdV 1 0) (hv11 : VerdV 1 1) (hv12 : VerdV 1 2) (hv20 : VerdV 2 0) (hv21 : VerdV 2 1) (hv22 : VerdV 2 2) :
    RFormula.rvalid (theorem3Form
      (bigChoice (leftProgsV dt))
      (rightAutomatonBody GrV mvV)
      (RFormula.and (RFormula.and (canonInvM gV gsV) (envLR domLV domRV))
        (mvValidR mvV GrV.modes.length))) := by
  refine theorem3_faithful_multiF_LR GrV mvV (FM gV gsV) domLV domRV
    (leftProgsV dt) (canonInvM gV gsV) (encode_canonInvM gV gsV) ?_ ?_ ?_
  · exact hdis_multi GrV 0 1 dt leftDataV (by decide) httV hRvV hLV
  · exact hstep_assembled_multiF GrV mvV (FM gV gsV) envV (leftProgsV dt)
      hmvFV hmvenvV hfreshV httV hltV (hframesV dt)
      (HmultiV dt hdt hv00 hv01 hv02 hv10 hv11 hv12 hv20 hv21 hv22)
  · exact hddF_multiE GrV 0 1 dt leftDataV (canonInvM gV gsV) domLV domRV
      (by decide) httV hRvV hLV
      (canonInvM_varsL gV gsV (by
        intro g' hg'
        simp only [gV, gsV, List.mem_cons, List.not_mem_nil, or_false] at hg'
        rcases hg' with rfl | rfl <;> exact hgAt _))
      (canonInvM_varsR gV gsV) hdomLV hdomRV

