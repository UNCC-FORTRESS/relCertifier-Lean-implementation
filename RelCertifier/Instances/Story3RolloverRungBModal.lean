/-! ## The right graph (one-way chain) -/

noncomputable def modeV (q : ℕ) : RMode (Var 12) :=
  { sys := rightBlock (fRV q) (Term.const 1), dom := domRV, weight := 1 }

def edgeV (st tgt : ℕ) : REdge (Var 12) :=
  { src := st, tgt := tgt, guard := Formula.tt, pruned := false }

noncomputable def GrV : SearchGraph (Var 12) :=
  { modes := [modeV 0, modeV 1, modeV 2],
    edges := [edgeV 0 1, edgeV 0 0, edgeV 1 2, edgeV 1 1, edgeV 2 2] }

theorem GrV_modeAt (q : ℕ) (hq : q < 3) : GrV.modeAt q = some (modeV q) := by
  interval_cases q <;> rfl

theorem httV : ∀ q, ∀ e ∈ GrV.edgesFrom q, e.guard = Formula.tt := by
  intro q e he
  have hmem : e ∈ GrV.edges := List.mem_of_mem_filter he
  simp only [GrV, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> rfl

theorem hltV : ∀ q, ∀ e ∈ GrV.edgesFrom q, e.tgt < GrV.modes.length := by
  intro q e he
  have hmem : e ∈ GrV.edges := List.mem_of_mem_filter he
  simp only [GrV, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl <;> norm_num [GrV, edgeV]

theorem hRvV : ∀ q m, GrV.modeAt q = some m →
    m.sys.boundSet ∪ m.sys.readVars ∪ m.dom.fv ⊆ range Rv := by
  intro q m hm
  have hqm : q < 3 ∧ m = modeV q := by
    match q with
    | 0 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrV] using hm.symm⟩
    | 1 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrV] using hm.symm⟩
    | 2 => exact ⟨by norm_num, by simpa [SearchGraph.modeAt, GrV] using hm.symm⟩
    | q + 3 => exact absurd hm (by simp [SearchGraph.modeAt, GrV])
  obtain ⟨hq3, rfl⟩ := hqm
  intro y hy
  rcases hy with (hy | hy) | hy
  · exact rightBlock_boundSet_sub (fRV q) (Term.const 1) hy
  · exact rightBlock_readVars_sub (fRV q) (Term.const 1) (hfRV q hq3)
      (by simp [Term.fv]) hy
  · exact hdomRV hy

theorem edgeV_mem : ∀ st tgt, edgeV st tgt ∈ GrV.edges →
    edgeV st tgt ∈ GrV.edgesFrom st :=
  fun st tgt he => List.mem_filter.mpr ⟨he, by simp [edgeV]⟩

theorem hfreshV : ∀ q m, GrV.modeAt q = some m →
    mvV ∉ (Program.ode m.sys m.dom).fv := by
  intro q m hm hmv
  exact aux_notin_range_Rv 0 (hRvV q m hm (vars_ode_sub _ _ (Or.inl hmv)))

/-! ## The left window family -/

noncomputable def leftDataV : List ((Fin 12 → Term (Var 12)) × Formula (Var 12) × ℕ) :=
  [(fLV 0, domLV, 1), (fLV 1, domLV, 1), (fLV 2, domLV, 1)]

noncomputable def leftProgsV (dt : ℝ) : List (Program (Var 12)) :=
  leftDataV.map (fun d => windowSeg (leftBlock d.1) d.2.1 tgV dt d.2.2)

theorem hLV : ∀ d ∈ leftDataV, (∀ i, (d.1 i).fv ⊆ range Lv) ∧ d.2.1.fv ⊆ range Lv := by
  intro d hd
  simp only [leftDataV, List.mem_cons, List.not_mem_nil, or_false] at hd
  rcases hd with rfl | rfl | rfl
  · exact ⟨hfLV 0 (by norm_num), hdomLV⟩
  · exact ⟨hfLV 1 (by norm_num), hdomLV⟩
  · exact ⟨hfLV 2 (by norm_num), hdomLV⟩

theorem hframesV (dt : ℝ) : ∀ P ∈ leftProgsV dt, FramesMv P mvV := by
  intro P hP
  simp only [leftProgsV, List.mem_map] at hP
  obtain ⟨d, hd, rfl⟩ := hP
  refine framesMv_window (leftBlock d.1) d.2.1 tgV dt d.2.2 mvV (by decide) ?_
  intro h
  obtain ⟨i, hi⟩ := leftBlock_bound_sub d.1 _ h
  exact aux_ne_Lv 0 i hi

